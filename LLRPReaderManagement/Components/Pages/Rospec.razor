@page "/rospec"
@inject RospecViewModel Vm
@implements IDisposable

<div class="section-header">
    <h2 class="section-title">ROSPEC Management</h2>
    <div class="flex gap-2">
        <select style="font-size: 13px; padding: 6px 10px;" value="@Vm.State.ActiveEndpoint" @onchange="OnReaderChanged">
            @foreach (var reader in Vm.State.Readers)
            {
                <option value="@reader.Endpoint">@reader.Name - @reader.Endpoint</option>
            }
        </select>
        <button class="btn btn-primary btn-sm" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New ROSPEC
        </button>
    </div>
</div>

<div style="display: flex; flex-direction: column; gap: var(--space-4);">
    <div class="rospec-card @(Vm.State.IsInventoryRunning ? "active" : "")">
        <div class="rospec-head">
            <div class="rospec-head-left">
                <span class="rospec-id">ROSpec @RoSpecIdText</span>
                <span class="rospec-name">Inventory ROSpec - SDK Settings</span>
            </div>
            <span class="status-badge @(Vm.State.IsInventoryRunning ? "connected" : "disconnected")">
                @(Vm.State.IsInventoryRunning ? "Running" : "Stopped")
            </span>
        </div>
        <div class="rospec-body">
            <div>
                <div class="rospec-field-label">ROSpec ID</div>
                <div class="rospec-field-value">@RoSpecIdText</div>
            </div>
            <div>
                <div class="rospec-field-label">Priority</div>
                <div class="rospec-field-value">0 (Highest)</div>
            </div>
            <div>
                <div class="rospec-field-label">Trigger</div>
                <div class="rospec-field-value">@(Vm.State.Settings?.AutoStart.Mode.ToString() ?? "-")</div>
            </div>
            <div>
                <div class="rospec-field-label">Stop Trigger</div>
                <div class="rospec-field-value">@(Vm.State.Settings?.AutoStop.Mode.ToString() ?? "-")</div>
            </div>
            <div>
                <div class="rospec-field-label">Reader</div>
                <div class="rospec-field-value">@Vm.State.Endpoint</div>
            </div>
            <div>
                <div class="rospec-field-label">Session</div>
                <div class="rospec-field-value">S@(Vm.State.Settings?.Session.ToString() ?? "-")</div>
            </div>
            <div>
                <div class="rospec-field-label">Tags Read</div>
                <div class="rospec-field-value">@Vm.State.TotalReports.ToString("N0")</div>
            </div>
        </div>
        <div class="rospec-spec">
            <div class="rospec-spec-title">Spec Details</div>
            <div class="spec-param">
                <span class="spec-param-key">ROSpec.ROSpecID</span>
                <span class="spec-param-value">@RoSpecIdText</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">InventorySpec.session</span>
                <span class="spec-param-value">S@(Vm.State.Settings?.Session.ToString() ?? "-")</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">InventorySpec.searchMode</span>
                <span class="spec-param-value">@(Vm.State.Settings?.InventorySearchMode.ToString() ?? "-")</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">InventorySpec.target</span>
                <span class="spec-param-value">@(Vm.State.Settings?.InventoryTarget.ToString() ?? "-")</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">InventorySpec.stateAware</span>
                <span class="spec-param-value">@(Vm.State.Settings?.InventoryStateAware == true ? "Enabled" : "Disabled")</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">AntennaIDs</span>
                <span class="spec-param-value">@AntennaText</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">TagReportContentSelector</span>
                <span class="spec-param-value">@ReportSelectorText</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">FilterMode</span>
                <span class="spec-param-value">@(Vm.State.Settings?.Filters.Mode.ToString() ?? "-")</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">AutoStart</span>
                <span class="spec-param-value">@AutoStartText</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">AutoStop</span>
                <span class="spec-param-value">@AutoStopText</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">AttachedData</span>
                <span class="spec-param-value">@AttachedDataText</span>
            </div>
            <div class="spec-param">
                <span class="spec-param-key">ReportSource</span>
                <span class="spec-param-value">LLRPSdk TagsReported event</span>
            </div>
        </div>
        <div class="rospec-actions">
            @if (Vm.State.IsInventoryRunning)
            {
                <button class="btn btn-sm btn-danger" @onclick="Vm.Stop">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                    Stop
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-primary" @onclick="Vm.Start" disabled="@(!Vm.State.IsConnected)">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Start
                </button>
            }
            <a class="btn btn-sm" href="/inventory-config">Inventory Params</a>
            <a class="btn btn-sm" href="/config">Reader Config</a>
            <a class="btn btn-sm" href="/inventory">Inventory</a>
            <span style="margin-left: auto; color: var(--muted); font-size: 12px;">Generated from LLRPSdk Settings</span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.State.Changed += OnStateChanged;

    private string RoSpecIdText => Vm.State.CurrentRoSpecId is { } id ? $"#{id}" : "-";

    private string AntennaText => Vm.State.AntennaCount == 0
        ? "-"
        : string.Join(", ", Vm.State.Settings?.Antennas.AntennaConfigs.Where(x => x.IsEnabled).Select(x => x.PortNumber)
            ?? Enumerable.Range(1, (int)Vm.State.AntennaCount).Select(x => (ushort)x));

    private string ReportSelectorText
    {
        get
        {
            var report = Vm.State.Settings?.Report;
            if (report is null)
            {
                return "-";
            }

            var fields = new List<string> { $"Mode={report.Mode}" };
            if (report.IncludeAntennaPortNumber) fields.Add("AntennaID");
            if (report.IncludeChannel) fields.Add("Channel");
            if (report.IncludePeakRssi) fields.Add("RSSI");
            if (report.IncludeFirstSeenTime) fields.Add("FirstSeen");
            if (report.IncludeLastSeenTime) fields.Add("LastSeen");
            if (report.IncludeSeenCount) fields.Add("SeenCount");
            if (report.IncludePcBits) fields.Add("PC");
            if (report.IncludeCrc) fields.Add("CRC");
            if (report.IncludeTxPower) fields.Add("TxPower");
            if (report.IncludeXPCWords) fields.Add("XPC");
            if (report.IncludeEnhancedIntegra) fields.Add("EnhancedIntegra");
            if (report.IncludeEndpointICVerification) fields.Add("EndpointIC");
            return string.Join(", ", fields);
        }
    }

    private string AutoStartText => Vm.State.Settings?.AutoStart is null
        ? "-"
        : $"{Vm.State.Settings.AutoStart.Mode}, GPI={Vm.State.Settings.AutoStart.GpiPortNumber}/{(Vm.State.Settings.AutoStart.GpiLevel ? "HIGH" : "LOW")}, Delay={Vm.State.Settings.AutoStart.FirstDelayInMs}ms, Period={Vm.State.Settings.AutoStart.PeriodInMs}ms";

    private string AutoStopText => Vm.State.Settings?.AutoStop is null
        ? "-"
        : $"{Vm.State.Settings.AutoStop.Mode}, Duration={Vm.State.Settings.AutoStop.DurationInMs}ms, GPI={Vm.State.Settings.AutoStop.GpiPortNumber}/{(Vm.State.Settings.AutoStop.GpiLevel ? "HIGH" : "LOW")}, Timeout={Vm.State.Settings.AutoStop.Timeout}ms";

    private string AttachedDataText => Vm.State.Settings?.AttachedData is null
        ? "-"
        : Vm.State.Settings.AttachedData.Enabled
            ? $"{Vm.State.Settings.AttachedData.MemoryBank}, Ptr={Vm.State.Settings.AttachedData.WordPointer}, Words={Vm.State.Settings.AttachedData.WordCount}"
            : "Disabled";

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    private void OnReaderChanged(ChangeEventArgs args)
    {
        var endpoint = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(endpoint))
        {
            Vm.SelectReader(endpoint);
        }
    }

    public void Dispose() => Vm.State.Changed -= OnStateChanged;
}
