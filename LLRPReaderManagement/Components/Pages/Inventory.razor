@page "/inventory"
@inject InventoryViewModel Vm
@inject IJSRuntime JS
@implements IDisposable

<div class="section-header">
    <h2 class="section-title">Tag Inventory</h2>
    <div class="flex gap-2">
        <button class="btn btn-sm" @onclick="ExportCsv" disabled="@(TotalRows == 0 || isExporting)">
            @if (isExporting)
            {
                <span class="spinner" style="width: 14px; height: 14px; margin-right: 4px; border-width: 2px;"></span>
                <span>Exporting...</span>
            }
            else
            {
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Export CSV</span>
            }
        </button>
        <button class="btn btn-sm" @onclick="ClearInventory">Clear</button>
    </div>
</div>

<div class="scan-controls">
    <div class="scan-indicator @(Vm.State.IsInventoryRunning ? "active" : "paused")"></div>
    <span style="font-size: 13px; font-weight: 600;">@(Vm.State.IsInventoryRunning ? "Scanning Active" : "Scanning Paused")</span>
    <span style="font-size: 12px; color: var(--muted); font-family: var(--font-mono);">@DateTime.Now.ToString("HH:mm:ss")</span>
    <div style="margin-left: auto; display: flex; gap: var(--space-2);">
        @if (Vm.State.IsInventoryRunning)
        {
            <button class="btn btn-sm" @onclick="Vm.Stop">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                Pause All
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-primary" @onclick="Vm.Start">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Start All
            </button>
        }
        <button class="btn btn-sm" @onclick="Vm.Pull">Pull</button>
        <select style="font-size: 12px; padding: 4px 8px;" value="@Vm.State.ActiveEndpoint" @onchange="OnReaderChanged">
            @foreach (var reader in Vm.State.Readers)
            {
                <option value="@reader.Endpoint">@reader.Name - @reader.Endpoint</option>
            }
        </select>
    </div>
</div>

<div class="stats-bar">
    <div class="stats-bar-item">
        <span class="stats-bar-label">Unique Tags</span>
        <span class="stats-bar-value">@Vm.State.Tags.Count</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Rows</span>
        <span class="stats-bar-value">@TotalRows</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Total Reads</span>
        <span class="stats-bar-value">@Vm.State.TotalReports.ToString("N0")</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Read Rate</span>
        <span class="stats-bar-value">@(Vm.State.IsInventoryRunning ? $"{Vm.State.RollingReadRatePerSecond:0.0}/s" : "-")</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Avg RSSI</span>
        <span class="stats-bar-value">@AverageRssi</span>
    </div>
    <div class="stats-bar-spacer"></div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Aggregation</span>
        <button type="button" class="toggle @(UseAggregation ? "on" : "")" @onclick="ToggleAggregation" disabled="@(Vm.State.IsInventoryRunning)" aria-label="Toggle aggregated tag display"></button>
        <span class="stats-bar-value">@(UseAggregation ? "ON" : "OFF")</span>
    </div>
</div>

<div class="table-wrap tag-grid" style="max-height: calc(100vh - 320px); overflow-y: auto;">
    <div class="tag-row header">
        <span>EPC</span>
        <span>RSSI</span>
        <span>Count</span>
        <span>Reader</span>
        <span>Antenna</span>
        <span>Attached Data</span>
        <span>Last Seen</span>
    </div>
    @if (TotalRows == 0)
    {
        <div class="empty-state">No tag reports yet.</div>
    }
    @if (UseAggregation)
    {
        @foreach (var tag in PageTags)
        {
            <div class="tag-row" @key="tag.Epc">
                <span class="tag-epc">@tag.Epc</span>
                <span class="tag-rssi-cell">
                    <span class="rssi-bar"><span class="rssi-bar-fill" style="width: @RssiWidth(tag.Rssi); background: @RssiColor(tag.Rssi);"></span></span>
                    <span class="mono">@tag.Rssi.ToString("0.0")</span>
                </span>
                <span class="tag-count">@tag.SeenCount</span>
                <span class="tag-reader">@tag.ReaderEndpoint</span>
                <span class="tag-ant">@tag.AntennaText</span>
                <span class="tag-attached" title="@tag.AttachedData">@DisplayAttachedData(tag)</span>
                <span class="tag-time">@tag.LastSeen.ToString("HH:mm:ss.fff")</span>
            </div>
        }
    }
    else
    {
        @foreach (var tag in PageTags)
        {
            <div class="tag-row">
                <span class="tag-epc">@tag.Epc</span>
                <span class="tag-rssi-cell">
                    <span class="rssi-bar"><span class="rssi-bar-fill" style="width: @RssiWidth(tag.Rssi); background: @RssiColor(tag.Rssi);"></span></span>
                    <span class="mono">@tag.Rssi.ToString("0.0")</span>
                </span>
                <span class="tag-count">@tag.SeenCount</span>
                <span class="tag-reader">@tag.ReaderEndpoint</span>
                <span class="tag-ant">@tag.AntennaText</span>
                <span class="tag-attached" title="@tag.AttachedData">@DisplayAttachedData(tag)</span>
                <span class="tag-time">@tag.LastSeen.ToString("HH:mm:ss.fff")</span>
            </div>
        }
    }
</div>

@if (TotalRows > PageSize)
{
    <div class="pagination">
        <span>Showing @PageStart-@PageEnd of @TotalRows @(UseAggregation ? "aggregated rows" : "raw rows")</span>
        <div class="pagination-controls">
            <button class="page-btn" @onclick="PreviousPage" disabled="@(EffectivePage <= 1)">Prev</button>
            <button class="page-btn active">@EffectivePage</button>
            <button class="page-btn" @onclick="NextPage" disabled="@(EffectivePage >= TotalPages)">Next</button>
        </div>
    </div>
}

@code {
    private const int PageSize = 100;

    protected override void OnInitialized() => Vm.State.Changed += OnStateChanged;

    private bool UseAggregation { get; set; } = true;
    private int CurrentPage { get; set; } = 1;

    private IReadOnlyList<InventoryTagItem> DisplayTags => UseAggregation ? Vm.State.Tags : Vm.State.RawTags;
    private int TotalRows => DisplayTags.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalRows / (double)PageSize));
    private int EffectivePage => Math.Min(CurrentPage, TotalPages);
    private int PageStart => TotalRows == 0 ? 0 : (EffectivePage - 1) * PageSize + 1;
    private int PageEnd => Math.Min(EffectivePage * PageSize, TotalRows);
    private IReadOnlyList<InventoryTagItem> PageTags => DisplayTags
        .Skip((EffectivePage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private string AverageRssi => Vm.State.Tags.Count == 0 ? "-" : $"{Vm.State.Tags.Average(x => x.Rssi):0.0} dBm";
    private static string RssiColor(double rssi) => rssi >= -45 ? "var(--status-ok)" : rssi >= -65 ? "var(--status-warn)" : "var(--status-danger)";
    private static string RssiWidth(double rssi) => $"{Math.Clamp((rssi + 80) / 35 * 100, 5, 100):0}%";
    private static string DisplayAttachedData(InventoryTagItem tag) =>
        string.IsNullOrWhiteSpace(tag.AttachedData) ? "-" : tag.AttachedData;

    private void ToggleAggregation()
    {
        UseAggregation = !UseAggregation;
        CurrentPage = 1;
    }

    private void PreviousPage() => CurrentPage = Math.Max(1, EffectivePage - 1);

    private void NextPage() => CurrentPage = Math.Min(TotalPages, EffectivePage + 1);

    private void ClearInventory()
    {
        Vm.Clear();
        CurrentPage = 1;
    }

    private void OnReaderChanged(ChangeEventArgs args)
    {
        var endpoint = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(endpoint))
        {
            Vm.SelectReader(endpoint);
        }
    }

    private bool isExporting;

    private async Task ExportCsv()
    {
        var tags = DisplayTags;
        if (tags.Count == 0) return;

        isExporting = true;
        StateHasChanged();
        await Task.Delay(16); // Allow UI to render the "Exporting..." state

        try
        {
            var fileName = $"tag-inventory-{DateTime.Now:yyyyMMdd-HHmmss}.csv";

            var csvData = await Task.Run(() =>
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("EPC,RSSI,Count,Reader,Antenna,Attached Data,Report Source,Last Seen");
                foreach (var t in tags)
                {
                    sb.AppendLine($"\"{t.Epc}\",{t.Rssi:0.0},{t.SeenCount},\"{t.ReaderEndpoint}\",\"{t.AntennaText}\",\"{t.AttachedData}\",\"{t.ReportSource}\",\"{t.LastSeen:yyyy-MM-dd HH:mm:ss.fff}\"");
                }
                return sb.ToString();
            });

            await JS.InvokeVoidAsync("downloadFileFromText", fileName, csvData);
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Vm.State.Changed -= OnStateChanged;
}
