@page "/inventory"
@inject InventoryViewModel Vm
@inject IJSRuntime JS
@implements IDisposable

<div class="section-header">
    <h2 class="section-title">Tag Inventory</h2>
    <div class="flex gap-2">
        <button class="btn btn-sm" @onclick="ExportCsv" disabled="@(Vm.State.Tags.Count == 0)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export CSV
        </button>
        <button class="btn btn-sm" @onclick="Vm.Clear">Clear</button>
    </div>
</div>

<div class="scan-controls">
    <div class="scan-indicator @(Vm.State.IsInventoryRunning ? "active" : "paused")"></div>
    <span style="font-size: 13px; font-weight: 600;">@(Vm.State.IsInventoryRunning ? "Scanning Active" : "Scanning Paused")</span>
    <span style="font-size: 12px; color: var(--muted); font-family: var(--font-mono);">@DateTime.Now.ToString("HH:mm:ss")</span>
    <div style="margin-left: auto; display: flex; gap: var(--space-2);">
        @if (Vm.State.IsInventoryRunning)
        {
            <button class="btn btn-sm" @onclick="Vm.Stop">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                Pause All
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-primary" @onclick="Vm.Start">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                Start All
            </button>
        }
        <button class="btn btn-sm" @onclick="Vm.Pull">Pull</button>
        <select style="font-size: 12px; padding: 4px 8px;" value="@Vm.State.ActiveEndpoint" @onchange="OnReaderChanged">
            @foreach (var reader in Vm.State.Readers)
            {
                <option value="@reader.Endpoint">@reader.Name - @reader.Endpoint</option>
            }
        </select>
    </div>
</div>

<div class="stats-bar">
    <div class="stats-bar-item">
        <span class="stats-bar-label">Unique Tags</span>
        <span class="stats-bar-value">@Vm.State.Tags.Count</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Total Reads</span>
        <span class="stats-bar-value">@Vm.State.TotalReports.ToString("N0")</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Read Rate</span>
        <span class="stats-bar-value">@(Vm.State.IsInventoryRunning ? "Live" : "-")</span>
    </div>
    <div class="stats-bar-item">
        <span class="stats-bar-label">Avg RSSI</span>
        <span class="stats-bar-value">@AverageRssi</span>
    </div>
</div>

<div class="table-wrap tag-grid" style="max-height: calc(100vh - 320px); overflow-y: auto;">
    <div class="tag-row header">
        <span>EPC</span>
        <span>RSSI</span>
        <span>Count</span>
        <span>Reader</span>
        <span>Antenna</span>
        <span>Attached Data</span>
        <span>Last Seen</span>
    </div>
    @if (Vm.State.Tags.Count == 0)
    {
        <div class="empty-state">No tag reports yet.</div>
    }
    @foreach (var tag in Vm.State.Tags)
    {
        <div class="tag-row">
            <span class="tag-epc">@tag.Epc</span>
            <span class="tag-rssi-cell">
                <span class="rssi-bar"><span style="width: @RssiWidth(tag.Rssi); background: @RssiColor(tag.Rssi);"></span></span>
                <span class="mono">@tag.Rssi.ToString("0.0")</span>
            </span>
            <span class="tag-count">@tag.SeenCount</span>
            <span class="tag-reader">@tag.ReaderEndpoint</span>
            <span class="tag-ant">Ant @tag.Antenna</span>
            <span class="tag-attached" title="@tag.AttachedData">@DisplayAttachedData(tag)</span>
            <span class="tag-time">@tag.LastSeen.ToString("HH:mm:ss.fff")</span>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Vm.State.Changed += OnStateChanged;

    private string AverageRssi => Vm.State.Tags.Count == 0 ? "-" : $"{Vm.State.Tags.Average(x => x.Rssi):0.0} dBm";
    private static string RssiColor(double rssi) => rssi > -40 ? "var(--status-ok)" : rssi > -55 ? "var(--status-warn)" : "var(--status-danger)";
    private static string RssiWidth(double rssi) => $"{Math.Min(100, Math.Max(5, (rssi + 80) * 2.5)):0}%";
    private static string DisplayAttachedData(InventoryTagItem tag) =>
        string.IsNullOrWhiteSpace(tag.AttachedData) ? "-" : tag.AttachedData;

    private void OnReaderChanged(ChangeEventArgs args)
    {
        var endpoint = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(endpoint))
        {
            Vm.SelectReader(endpoint);
        }
    }

    private async Task ExportCsv()
    {
        var tags = Vm.State.Tags;
        if (tags.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("EPC,RSSI,Count,Reader,Antenna,Attached Data,Report Source,Last Seen");
        foreach (var t in tags)
        {
            sb.AppendLine($"\"{t.Epc}\",{t.Rssi:0.0},{t.SeenCount},\"{t.ReaderEndpoint}\",Ant {t.Antenna},\"{t.AttachedData}\",\"{t.ReportSource}\",\"{t.LastSeen:yyyy-MM-dd HH:mm:ss.fff}\"");
        }

        var fileName = $"tag-inventory-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, sb.ToString());
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Vm.State.Changed -= OnStateChanged;
}
