@page "/config"
@inject ConfigViewModel Vm
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<div class="section-header">
    <div>
        <h2 class="section-title">Reader Configuration</h2>
        <div class="section-subtitle">Basic reader, RF, state-aware inventory, GPIO and antenna settings.</div>
    </div>
    <div class="flex gap-2">
        <select style="font-size: 13px; padding: 6px 10px;" value="@Vm.State.ActiveEndpoint" @onchange="OnReaderChanged">
            @foreach (var reader in Vm.State.Readers)
            {
                <option value="@reader.Endpoint">@reader.Name - @reader.Endpoint</option>
            }
        </select>
        <button class="btn btn-primary btn-sm" @onclick="Vm.ApplyChanges" disabled="@(!CanEdit)">Apply Changes</button>
        <button class="btn btn-sm" @onclick="Vm.ApplyDefaults" disabled="@(!Vm.State.Reader.IsConnected || Vm.State.IsInventoryRunning)">SDK Defaults</button>
        <button class="btn btn-sm" @onclick="Vm.Refresh" disabled="@(Vm.State.IsInventoryRunning)">Refresh</button>
    </div>
</div>

<div class="config-section">
    <div class="config-section-header">
        <span class="config-section-title">System Management</span>
        <span class="status-badge @(Vm.State.IsConnected ? "connected" : "disconnected")">@(Vm.State.IsConnected ? "Connected" : "Disconnected")</span>
    </div>
    <div class="config-section-body">
        <div class="form-group">
            <label class="form-label">Reader Name</label>
            <input type="text" value="@Vm.State.Reader.Name" readonly>
        </div>
        <div class="form-group">
            <label class="form-label">IP Address</label>
            <input type="text" value="@Vm.State.Endpoint" readonly>
        </div>
        <div class="form-group">
            <label class="form-label">Enable Keepalive</label>
            <button type="button" class="toggle @(Settings?.Keepalives.Enabled == true ? "on" : "")" @onclick="ToggleKeepalive" disabled="@(!CanEdit)" aria-label="Enable keepalive"></button>
        </div>
        <div class="form-group">
            <label class="form-label">Keepalive Interval (ms)</label>
            <input type="number" min="1" value="@(Settings?.Keepalives.PeriodInMs.ToString() ?? "0")" @onchange="SetKeepaliveInterval" readonly="@(!CanEdit)">
        </div>
    </div>
</div>

<div class="config-section">
    <div class="config-section-header">
        <span class="config-section-title">Radio Physical Layer</span>
    </div>
    <div class="config-section-body">
        <div class="form-group">
            <label class="form-label">RF Mode</label>
            <select value="@(Settings?.RfMode?.ToString() ?? "")" @onchange="SetRfMode" disabled="@(!CanEdit)">
                <option value="">Auto / Device Default</option>
                @foreach (var option in Vm.RfModeOptions)
                {
                    <option value="@option.Id">@option.DisplayText</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Hop Table ID</label>
            <select value="@(Settings?.HopTableId.ToString() ?? "0")" @onchange="SetHopTable" disabled="@(!CanEdit)">
                @foreach (var id in Vm.HopTableOptions)
                {
                    <option value="@id">@id</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Channel Index</label>
            <input type="number" min="0" value="@Vm.ChannelIndex.ToString()" @onchange="SetChannelIndex" readonly="@(!CanEdit)">
        </div>
        <div class="form-group">
            <label class="form-label">Channel Frequency</label>
            <input type="text" value="@Vm.SelectedChannelFrequency" readonly>
        </div>
    </div>
    <div style="padding: 0 var(--space-5) var(--space-5);">
        <div class="result-box">
            <div class="form-label">Hop Table Frequencies</div>
            <div class="mono" style="margin-top: var(--space-2); white-space: normal;">@Vm.SelectedHopTableFrequencies</div>
        </div>
    </div>
</div>

<div class="config-section">
    <div class="config-section-header">
        <span class="config-section-title">Inventory Protocol</span>
        <span style="font-size: 12px; color: var(--muted);">ROSpec singulation defaults</span>
    </div>
    <div class="config-section-body">
        <div class="form-group">
            <label class="form-label">Session</label>
            <select value="@(Settings?.Session.ToString() ?? "0")" @onchange="SetSession" disabled="@(!CanEdit)">
                <option value="0">S0</option>
                <option value="1">S1</option>
                <option value="2">S2</option>
                <option value="3">S3</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Tag Population Estimate</label>
            <input type="number" min="1" max="65535" value="@(Settings?.TagPopulationEstimate.ToString() ?? "0")" @onchange="SetTagPopulation" readonly="@(!CanEdit)">
        </div>
        <div class="form-group">
            <label class="form-label">Inventory State Aware</label>
            <button type="button" class="toggle @(Settings?.InventoryStateAware == true ? "on" : "")" @onclick="ToggleInventoryStateAware" disabled="@(!CanEdit || Vm.State.FeatureSet?.CanDoTagInventoryStateAwareSingulation != true)" aria-label="Inventory state aware"></button>
        </div>
        <div class="form-group">
            <label class="form-label">Inventory Target</label>
            <select value="@(Settings?.InventoryTarget.ToString() ?? InventoryTarget.A.ToString())" @onchange="SetInventoryTarget" disabled="@(!CanEdit || !Vm.IsStateAwareOptionsEnabled)">
                @foreach (var value in Enum.GetValues<InventoryTarget>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Inventory Search Mode</label>
            <select value="@(Settings?.InventorySearchMode.ToString() ?? InventorySearchMode.Not_SL.ToString())" @onchange="SetInventorySearchMode" disabled="@(!CanEdit || !Vm.IsStateAwareOptionsEnabled)">
                @foreach (var value in Enum.GetValues<InventorySearchMode>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="config-section">
    <div class="config-section-header">
        <span class="config-section-title">GPI / GPO</span>
        <button class="btn btn-sm" @onclick="Vm.RefreshStatus" disabled="@(!Vm.State.IsConnected || Vm.State.IsInventoryRunning)">Refresh Status</button>
    </div>
    <div class="config-section-body full">
        <div class="gpio-grid">
            @foreach (var gpi in Vm.Gpis)
            {
                <div class="gpio-card">
                    <div class="gpio-name">GPI @gpi.PortNumber</div>
                    <div class="gpio-dot @(gpi.CurrentState == true ? "high" : gpi.CurrentState == false ? "low" : "unknown")"></div>
                    <div class="gpio-state">@gpi.CurrentStateText</div>
                </div>
            }
            @foreach (var gpo in Vm.Gpos)
            {
                <div class="gpio-card">
                    <div class="gpio-name">GPO @gpo.PortNumber</div>
                    <button type="button" class="toggle @(gpo.DesiredState ? "on" : "") gpio-toggle" @onclick="() => Vm.SetGpo(gpo.PortNumber, !gpo.DesiredState)" disabled="@(!CanEdit)" aria-label="Set GPO @gpo.PortNumber"></button>
                    <div class="gpio-state">@(gpo.DesiredState ? "ON" : "OFF")</div>
                </div>
            }
            @if (Vm.Gpis.Count == 0 && Vm.Gpos.Count == 0)
            {
                <div class="empty-state">No GPIO ports reported by the reader.</div>
            }
        </div>
    </div>
</div>

<div class="config-section">
    <div class="config-section-header">
        <span class="config-section-title">Antenna Configuration</span>
        <span style="font-size: 12px; color: var(--muted);">@Vm.State.AntennaCount antennas detected</span>
    </div>
    <div style="padding: var(--space-4) var(--space-5);">
        <div class="antenna-config">
            @foreach (var ant in Antennas)
            {
                <div class="antenna-config-card">
                    <div class="antenna-config-header">
                        <span class="antenna-config-name">Antenna @ant.PortNumber</span>
                        <button type="button" class="toggle @(ant.IsEnabled ? "on" : "")" @onclick="() => ToggleAntenna(ant)" disabled="@(!CanEdit)" aria-label="Toggle antenna @ant.PortNumber"></button>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Power (dBm)</label>
                        <select value="@ant.TxPowerInDbm.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetAntennaTxPower(ant, args)" disabled="@(!CanEdit)">
                            @foreach (var power in PowerOptions(ant.TxPowerInDbm))
                            {
                                <option value="@power.ToString(System.Globalization.CultureInfo.InvariantCulture)">@power.ToString("0.0") dBm</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Receive Sensitivity</label>
                        <select value="@ant.RxSensitivityInDbm.ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetAntennaRxSensitivity(ant, args)" disabled="@IsRxSensitivityDisabled">
                            @foreach (var sensitivity in SensitivityOptions(ant.RxSensitivityInDbm))
                            {
                                <option value="@sensitivity.ToString(System.Globalization.CultureInfo.InvariantCulture)">@sensitivity.ToString("0.0") dBm</option>
                            }
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="config-section">
    <div class="config-section-header">
        <span class="config-section-title">Configuration Backup & Restore</span>
        <span style="font-size: 12px; color: var(--muted);">Import and export LLRP Settings as XML files</span>
    </div>
    <div class="config-section-body" style="display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-4) var(--space-5);">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); width: 100%;">
            <p style="margin: 0; font-size: 13px; color: var(--text);">Backup your current reader configuration (Antennas, RF, Session, Keepalives) or restore from an XML backup.</p>
            <div style="display: flex; gap: var(--space-2); flex-shrink: 0; align-items: center;">
                <InputFile OnChange="@OnImportFilePicked" style="display: none;" id="config-import-file-input" accept=".xml" />
                <label class="btn btn-sm" for="config-import-file-input" style="cursor: pointer; margin-bottom: 0; display: inline-flex; align-items: center; justify-content: center; height: 32px; border: 1px solid var(--border); padding: 0 15px; border-radius: 4px; font-size: 13px; font-weight: 500; background-color: var(--card-bg);">
                    Import Config
                </label>
                <button class="btn btn-sm" @onclick="ExportConfig" disabled="@(!CanEdit || Vm.State.IsInventoryRunning)" style="height: 32px; font-size: 13px;">
                    Export Config
                </button>
            </div>
        </div>
        
        @if (importPreview != null)
        {
            <div class="result-box" style="margin-top: var(--space-2); border-color: @(showCompatibilityWarning ? "var(--warning)" : "var(--accent)"); background-color: rgba(0, 0, 0, 0.1); padding: var(--space-3); border-radius: 6px;">
                <div style="font-weight: 600; color: @(showCompatibilityWarning ? "var(--warning)" : "var(--accent)"); margin-bottom: var(--space-2); font-size: 14px; display: flex; align-items: center; gap: 8px;">
                    <span>@(showCompatibilityWarning ? "⚠️ Compatibility Alert" : "📋 Configuration Preview")</span>
                </div>
                <div style="font-size: 13px; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); margin-bottom: var(--space-3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2);">
                    <div>Exported Device Model: <strong style="color: var(--text);">@importPreview.Model</strong></div>
                    <div>Antenna Ports: <strong style="color: var(--text);">@importPreview.AntennaCount</strong></div>
                    <div>Export Date: <strong style="color: var(--text);">@importPreview.ExportedAt.ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                    <div>GPI / GPO: <strong style="color: var(--text);">@importPreview.GpiCount / @importPreview.GpoCount</strong></div>
                </div>
                @if (showCompatibilityWarning)
                {
                    <div style="color: var(--warning); font-size: 12px; margin-bottom: var(--space-3); line-height: 1.5; font-weight: 500;">
                        Warning: The configuration file model (@importPreview.Model) or antenna count (@importPreview.AntennaCount) does not match your current device (@Vm.State.ReaderModel, @Vm.State.AntennaCount). Applying these settings may cause LLRP errors.
                    </div>
                }
                <div style="display: flex; gap: var(--space-2);">
                    <button class="btn btn-primary btn-sm" @onclick="ConfirmImport">Confirm & Apply</button>
                    <button class="btn btn-sm" @onclick="CancelImport">Cancel</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.State.Changed += OnStateChanged;

    private Settings? Settings => Vm.State.Settings;
    private bool CanEdit => Vm.State.Reader.IsConnected && Settings is not null && !Vm.State.IsInventoryRunning;
    private bool IsRxSensitivityDisabled => !CanEdit || Vm.State.ReaderModel == "UF40";

    private IReadOnlyList<AntennaConfig> Antennas => BuildAntennaList();

    private IReadOnlyList<double> PowerOptions(double current) => Vm.TxPowerOptions.Contains(current)
        ? Vm.TxPowerOptions
        : Vm.TxPowerOptions.Concat([current]).Distinct().OrderBy(x => x).ToList();

    private IReadOnlyList<double> SensitivityOptions(double current) => Vm.RxSensitivityOptions.Contains(current)
        ? Vm.RxSensitivityOptions
        : Vm.RxSensitivityOptions.Concat([current]).Distinct().OrderBy(x => x).ToList();

    private Dictionary<ushort, AntennaConfig> _cachedAntennas = new();

    private IReadOnlyList<AntennaConfig> BuildAntennaList()
    {
        var count = Math.Max(1, (int)Vm.State.AntennaCount);
        if (Settings?.Antennas is null)
        {
            return Enumerable.Range(1, count)
                .Select(CreateDefaultAntenna)
                .ToList();
        }

        var existingByPort = Settings.Antennas.AntennaConfigs
            .Where(x => x.PortNumber > 0)
            .GroupBy(x => x.PortNumber)
            .ToDictionary(x => x.Key, x => x.First());

        var result = new List<AntennaConfig>(count);
        for (var i = 1; i <= count; i++)
        {
            var port = (ushort)i;
            if (!existingByPort.TryGetValue(port, out var antenna))
            {
                if (_cachedAntennas.TryGetValue(port, out var cached))
                {
                    antenna = new AntennaConfig(port)
                    {
                        IsEnabled = false,
                        MaxTxPower = false,
                        TxPowerInDbm = cached.TxPowerInDbm,
                        MaxRxSensitivity = false,
                        RxSensitivityInDbm = cached.RxSensitivityInDbm,
                        PortName = cached.PortName
                    };
                }
                else
                {
                    antenna = CreateDefaultAntenna(i);
                }
                Settings.Antennas.AntennaConfigs.Add(antenna);
            }

            _cachedAntennas[port] = antenna;
            result.Add(antenna);
        }

        return result;
    }

    private AntennaConfig CreateDefaultAntenna(int port)
    {
        var defaultTx = Vm.TxPowerOptions.Count > 0 ? Vm.TxPowerOptions.First() : 30d;
        var defaultRx = Vm.RxSensitivityOptions.Count > 0 ? Vm.RxSensitivityOptions.First() : -70d;

        return new AntennaConfig((ushort)port)
        {
            IsEnabled = false,
            MaxTxPower = false,
            TxPowerInDbm = defaultTx,
            MaxRxSensitivity = false,
            RxSensitivityInDbm = defaultRx
        };
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnReaderChanged(ChangeEventArgs args)
    {
        var endpoint = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(endpoint))
        {
            Vm.SelectReader(endpoint);
        }
    }

    private void ToggleKeepalive()
    {
        if (Settings is not null)
        {
            Settings.Keepalives.Enabled = !Settings.Keepalives.Enabled;
        }
    }

    private void SetKeepaliveInterval(ChangeEventArgs args)
    {
        if (Settings is not null && uint.TryParse(args.Value?.ToString(), out var value))
        {
            Settings.Keepalives.PeriodInMs = Math.Max(1, value);
        }
    }

    private void SetRfMode(ChangeEventArgs args)
    {
        if (Settings is null)
        {
            return;
        }

        Settings.RfMode = uint.TryParse(args.Value?.ToString(), out var value) ? value : null;
    }

    private void SetHopTable(ChangeEventArgs args)
    {
        if (Settings is not null && ushort.TryParse(args.Value?.ToString(), out var value))
        {
            Settings.HopTableId = value;
        }
    }

    private void SetChannelIndex(ChangeEventArgs args)
    {
        if (ushort.TryParse(args.Value?.ToString(), out var value))
        {
            Vm.SetChannelIndex(value);
        }
    }

    private void SetSession(ChangeEventArgs args)
    {
        if (Settings is not null && ushort.TryParse(args.Value?.ToString(), out var value))
        {
            Settings.Session = (ushort)Math.Clamp((int)value, 0, 3);
        }
    }

    private void SetTagPopulation(ChangeEventArgs args)
    {
        if (Settings is not null && ushort.TryParse(args.Value?.ToString(), out var value))
        {
            Settings.TagPopulationEstimate = (ushort)Math.Clamp((int)value, 1, ushort.MaxValue);
        }
    }

    private void ToggleInventoryStateAware()
    {
        if (Settings is not null)
        {
            Settings.InventoryStateAware = !Settings.InventoryStateAware;
        }
    }

    private void SetInventoryTarget(ChangeEventArgs args)
    {
        if (Settings is not null && Enum.TryParse<InventoryTarget>(args.Value?.ToString(), out var value))
        {
            Settings.InventoryTarget = value;
        }
    }

    private void SetInventorySearchMode(ChangeEventArgs args)
    {
        if (Settings is not null && Enum.TryParse<InventorySearchMode>(args.Value?.ToString(), out var value))
        {
            Settings.InventorySearchMode = value;
        }
    }

    private void SetAntennaTxPower(AntennaConfig antenna, ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            antenna.MaxTxPower = false;
            antenna.TxPowerInDbm = value;
        }
    }

    private void SetAntennaRxSensitivity(AntennaConfig antenna, ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            antenna.MaxRxSensitivity = false;
            antenna.RxSensitivityInDbm = value;
        }
    }

    private void ToggleAntenna(AntennaConfig antenna)
    {
        antenna.IsEnabled = !antenna.IsEnabled;
    }

    private ReaderConfigurationPack? importPreview;
    private bool showCompatibilityWarning;

    private async Task OnImportFilePicked(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(1024 * 1024); // max 1MB
            using var reader = new StreamReader(stream);
            var xml = await reader.ReadToEndAsync();

            var pack = ReaderConfigurationPack.FromXmlString(xml);
            if (pack == null || string.IsNullOrEmpty(pack.AddRoSpecXml) || string.IsNullOrEmpty(pack.SetReaderConfigXml))
            {
                Vm.State.ShowNotification("Import Failed", "The selected XML file is not a valid LLRP configuration pack.", false);
                return;
            }

            importPreview = pack;
            showCompatibilityWarning = (pack.Model != Vm.State.ReaderModel) || (pack.AntennaCount != Vm.State.AntennaCount);
            
            Vm.State.ShowNotification("File Loaded", "Configuration loaded. Please review the compatibility preview below.", true);
        }
        catch (Exception ex)
        {
            Vm.State.ShowNotification("Import Failed", $"Failed to parse XML: {ex.Message}", false);
        }
    }

    private void CancelImport()
    {
        importPreview = null;
        showCompatibilityWarning = false;
    }

    private void ConfirmImport()
    {
        if (importPreview == null || string.IsNullOrEmpty(importPreview.AddRoSpecXml) || string.IsNullOrEmpty(importPreview.SetReaderConfigXml)) return;

        try
        {
            if (Vm.State.Settings != null)
            {
                var settings = Vm.ImportLlrpXml(importPreview.AddRoSpecXml, importPreview.SetReaderConfigXml);

                Vm.State.SetSettings(settings);
                Vm.State.ShowNotification("Import Success", "Configuration loaded into memory. Click 'Apply Changes' at the top to save it to the reader.", true);
            }
            else
            {
                Vm.State.ShowNotification("Import Failed", "No active reader connection to apply settings.", false);
            }
        }
        catch (Exception ex)
        {
            Vm.State.ShowNotification("Import Failed", $"Failed to apply settings: {ex.Message}", false);
        }
        finally
        {
            importPreview = null;
            showCompatibilityWarning = false;
        }
    }

    private async Task ExportConfig()
    {
        if (Vm.State.Settings == null)
        {
            Vm.State.ShowNotification("Export Failed", "No reader configuration available to export.", false);
            return;
        }

        try
        {
            var addRoSpecXml = Vm.ExportAddRoSpecXml();
            var setReaderConfigXml = Vm.ExportSetReaderConfigXml();

            var pack = new ReaderConfigurationPack
            {
                Brand = "Generic LLRP",
                Model = Vm.State.ReaderModel,
                AntennaCount = Vm.State.AntennaCount,
                GpiCount = Vm.State.GpiCount,
                GpoCount = Vm.State.GpoCount,
                ExportedAt = DateTime.Now,
                AddRoSpecXml = addRoSpecXml,
                SetReaderConfigXml = setReaderConfigXml
            };

            var xml = pack.ToXmlString();
            var fileName = $"{Vm.State.Reader.Name.Replace(" ", "_")}_Config_{DateTime.Now:yyyyMMdd_HHmmss}.xml";

            await JS.InvokeVoidAsync("downloadFileFromText", fileName, xml);
            Vm.State.ShowNotification("Export Completed", $"Configuration exported to {fileName}", true);
        }
        catch (Exception ex)
        {
            Vm.State.ShowNotification("Export Failed", ex.Message, false);
        }
    }

    public void Dispose() => Vm.State.Changed -= OnStateChanged;
}
