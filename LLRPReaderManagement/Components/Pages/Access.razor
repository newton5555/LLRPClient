@page "/access"
@inject AccessViewModel Vm
@inject AppState State

<div class="section-header">
    <h2 class="section-title">Access Operations</h2>
    <div class="flex gap-2">
        <select value="@State.ActiveEndpoint" @onchange="OnReaderChanged" disabled="@(!CanOperate)">
            @foreach (var reader in State.Readers)
            {
                <option value="@reader.Endpoint">@reader.Name - @reader.Endpoint</option>
            }
        </select>
    </div>
</div>

<div class="access-layout">
    <div class="tag-selector">
        <div class="tag-selector-header">
            <input type="text" placeholder="Search EPC..." @bind="SearchText" @bind:event="oninput">
            <span>@FilteredTags.Count tags</span>
        </div>
        <div class="tag-list">
            @if (FilteredTags.Count == 0)
            {
                <div class="empty-state">No tags. Start inventory first.</div>
            }
            @foreach (var tag in FilteredTags)
            {
                <button class="tag-list-item @(Vm.TargetEpc == tag.Epc ? "selected" : "")" @onclick="() => SelectTag(tag)">
                    <span class="tag-list-item-epc">@tag.Epc</span>
                    <span class="tag-list-item-meta">@tag.ReaderEndpoint · @tag.AntennaText · @tag.Rssi.ToString("0.0") dBm · seen @tag.SeenCount</span>
                </button>
            }
        </div>
    </div>

    <div class="operations-panel">
        <div class="card selected-tag-card">
            <div class="selected-tag-row">
                <span class="overline">Selected Tag</span>
                <span class="selected-epc">@(string.IsNullOrWhiteSpace(Vm.TargetEpc) ? "No tag selected" : Vm.TargetEpc)</span>
                <span class="selected-reader">@State.ActiveEndpoint</span>
            </div>
        </div>

        <div class="op-card">
            <div class="op-card-header">
                <span class="op-card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    Read Memory
                </span>
                <button class="btn btn-sm primary" @onclick="Read" disabled="@(!CanOperate)">Execute</button>
            </div>
            <div class="op-card-body">
                <div class="bank-tabs">
                    @foreach (var bank in Banks)
                    {
                        <button class="bank-tab @(Vm.MemoryBank == bank ? "active" : "")" @onclick="() => Vm.MemoryBank = bank" disabled="@(!CanOperate)">@bank</button>
                    }
                </div>
                <div style="display: flex; gap: var(--space-3);">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Word Pointer</label>
                        <input type="number" @bind="Vm.WordPointer" readonly="@(!CanOperate)" />
                        <div class="form-hint">Word offset, 1 word = 16 bit. EPC data <code>E280...</code> usually starts at word pointer 2.</div>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Word Count</label>
                        <input type="number" @bind="Vm.WordCount" readonly="@(!CanOperate)" />
                        <div class="form-hint">Read length in words. Example: <code>E280</code> is 1 word / 16 bit.</div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Target EPC</label>
                    <input type="text" @bind="Vm.TargetEpc" placeholder="EPC hex" style="font-family: var(--font-mono);" readonly="@(!CanOperate)" />
                    <div class="form-hint">Target EPC is hex text. Example: filter/read EPC prefix <code>E280</code> = 16 bit.</div>
                </div>
                <div class="op-result @(Vm.Data is not null ? "success" : "")">
                    @Vm.Result
                    @if (!string.IsNullOrWhiteSpace(Vm.Data))
                    {
                        <text>
@Vm.Data</text>
                    }
                </div>
            </div>
        </div>

        <div class="op-card">
            <div class="op-card-header">
                <span class="op-card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    Write Memory
                </span>
                <button class="btn btn-sm btn-primary" @onclick="Write" disabled="@(!CanOperate)">Execute</button>
            </div>
            <div class="op-card-body">
                <div class="bank-tabs">
                    @foreach (var bank in Banks)
                    {
                        <button class="bank-tab @(Vm.MemoryBank == bank ? "active" : "")" @onclick="() => Vm.MemoryBank = bank" disabled="@(!CanOperate)">@bank</button>
                    }
                </div>
                <div style="display: flex; gap: var(--space-3);">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Word Pointer</label>
                        <input type="number" @bind="Vm.WordPointer" readonly="@(!CanOperate)" />
                        <div class="form-hint">Write offset in words, 1 word = 16 bit. EPC word pointer 2 maps to the first EPC word, e.g. <code>E280</code>.</div>
                    </div>
                    <div class="form-group" style="flex: 2;">
                        <label class="form-label">Write Data</label>
                        <input type="text" @bind="Vm.WriteData" placeholder="Hex words, e.g. 1234ABCD" style="font-family: var(--font-mono);" readonly="@(!CanOperate)" />
                        <div class="form-hint">Write data must be complete 16-bit words: 4 hex chars = 1 word. Example <code>E280</code> writes 1 word.</div>
                    </div>
                </div>
                <label class="inline-check"><input type="checkbox" @bind="Vm.BlockWriteEnabled" disabled="@(!CanOperate)" /> BlockWrite</label>
                <div class="op-result">Write data must be hex and aligned to 16-bit words. EPC targeting uses bit pointer 32.</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
            <div class="op-card">
                <div class="op-card-header">
                    <span class="op-card-title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Lock
                    </span>
                    <button class="btn btn-sm" disabled>Execute</button>
                </div>
                <div class="op-card-body">
                    <div class="form-group">
                        <label class="form-label">Lock Mask</label>
                        <select disabled>
                            <option>EPC Write Lock</option>
                            <option>TID Write Lock</option>
                            <option>User Write Lock</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Lock Action</label>
                        <select disabled>
                            <option>Write Lock</option>
                            <option>Perma Lock</option>
                            <option>Unlock</option>
                        </select>
                    </div>
                    <div class="op-result" style="min-height: 40px;">Lock is visually aligned with the prototype; SDK command wiring is intentionally pending.</div>
                </div>
            </div>

            <div class="op-card">
                <div class="op-card-header">
                    <span class="op-card-title" style="color: var(--status-danger);">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Kill
                    </span>
                    <button class="btn btn-sm btn-danger" disabled>Execute</button>
                </div>
                <div class="op-card-body">
                    <div class="form-group">
                        <label class="form-label">Kill Password (Hex)</label>
                        <input type="text" placeholder="00000000" style="font-family: var(--font-mono); max-width: 200px;" disabled>
                    </div>
                    <div style="font-size: 12px; color: var(--status-danger); padding: var(--space-2); background: var(--status-danger-bg); border-radius: var(--radius-sm);">
                        Warning: Kill permanently disables the tag. This action cannot be undone.
                    </div>
                    <div class="op-result" style="min-height: 40px;">Kill is disabled until an explicit safety workflow is added.</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Memory Map - Selected Tag</span>
                <button class="btn btn-sm" disabled>Refresh</button>
            </div>
            <div style="margin-bottom: var(--space-2); font-size: 11px; color: var(--muted);">@(Vm.MemoryBank) Bank (16 words)</div>
            <div class="memory-view">
                @for (var i = 0; i < 16; i++)
                {
                    <div class="memory-cell header">@i.ToString("X2")</div>
                }
                @foreach (var word in MemoryWords)
                {
                    <div class="memory-cell @(word.Highlight ? "highlight" : "")">@word.Value</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Banks = ["Reserved", "EPC", "TID", "User"];
    private string SearchText { get; set; } = string.Empty;
    private bool CanOperate => State.IsConnected && !State.IsInventoryRunning;

    private IReadOnlyList<(string Value, bool Highlight)> MemoryWords =>
        Enumerable.Range(0, 16)
            .Select(i =>
            {
                var data = (Vm.Data ?? string.Empty).Replace(" ", string.Empty);
                var value = data.Length >= (i + 1) * 4 ? data.Substring(i * 4, 4) : "0000";
                return (value, !string.IsNullOrWhiteSpace(Vm.Data) && data.Length >= (i + 1) * 4);
            })
            .ToList();

    private IReadOnlyList<InventoryTagItem> FilteredTags =>
        State.Tags
            .Where(x => string.IsNullOrWhiteSpace(SearchText) || x.Epc.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            .Take(80)
            .ToList();

    private void SelectTag(InventoryTagItem tag)
    {
        Vm.TargetEpc = tag.Epc;
        if (CanOperate)
        {
            Vm.SelectReader(tag.ReaderEndpoint);
        }
    }

    private void OnReaderChanged(ChangeEventArgs args)
    {
        var endpoint = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(endpoint))
        {
            Vm.SelectReader(endpoint);
        }
    }

    private async Task Read()
    {
        if (CanOperate)
        {
            await Vm.ReadAsync();
        }
    }

    private async Task Write()
    {
        if (CanOperate)
        {
            await Vm.WriteAsync();
        }
    }
}
