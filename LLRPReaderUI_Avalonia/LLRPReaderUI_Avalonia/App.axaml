<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LLRPReaderUI_Avalonia.App"
             xmlns:local="using:LLRPReaderUI_Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- 主题颜色资源 - 支持Light/Dark主题切换 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Localization/Strings.en-US.axaml"/>
                <!-- 主题资源 - 包含Light和Dark主题的颜色定义 -->
                <ResourceInclude Source="/Styles/ThemeResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>

              <FontFamily x:Key="PetsFont">avares://LLRPReaderUI_Avalonia/Resources/Fonts/pets.ttf#iconfont</FontFamily>
        </ResourceDictionary>

       
    </Application.Resources>

    <Application.Styles>
        <!-- Material.Avalonia 主题 - 自动跟随 RequestedThemeVariant 切换亮暗 -->
        <themes:MaterialTheme PrimaryColor="Blue" SecondaryColor="Amber" />

        <!-- Material Icons 样式 -->
        <materialIcons:MaterialIconStyles />

        <!-- 自定义样式 - 颜色通过 DynamicResource 自动跟随主题切换 -->
        <StyleInclude Source="/Styles/FlatTheme.axaml"/>
    </Application.Styles>

</Application>
