<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
        xmlns:models="clr-namespace:LLRPReaderUI_Avalonia.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="LLRPReaderUI_Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid RowDefinitions="*,Auto">
        <!-- Main Content -->
        <Grid Grid.Row="0" Margin="16" ColumnDefinitions="240,12,*">

            <!-- Navigation Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,16">
                        <TextBlock Text="Navigation" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Command="{Binding ThemeLanguageViewModel.ToggleThemeCommand}"
                                    ToolTip.Tip="{Binding ThemeLanguageViewModel.ThemeToolTip}"
                                    Background="Transparent" BorderThickness="0">
                                <materialIcons:MaterialIcon Kind="{Binding ThemeLanguageViewModel.ThemeIcon}"
                                                           Width="20" Height="20" />
                            </Button>
                            <Button Command="{Binding ThemeLanguageViewModel.ToggleLanguageCommand}"
                                    ToolTip.Tip="Toggle Language"
                                    Background="Transparent" BorderThickness="0">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="{Binding ThemeLanguageViewModel.LanguageIcon}"
                                                               Width="20" Height="20" />
                                    <TextBlock Text="{Binding ThemeLanguageViewModel.LanguageSymbol}"
                                               FontSize="8" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Foreground="LightBlue" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:NavigationItem">
                                <StackPanel Orientation="Horizontal" Margin="8,8">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                               Width="20" Height="20" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="2" Background="White" CornerRadius="8">
                <ContentControl Content="{Binding CurrentPageViewModel}" />
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Height="40" Background="White"
                BorderBrush="#E6EBF2" BorderThickness="0,1,0,0" Padding="8,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="#E8F5E9" CornerRadius="10" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="Green" />
                        <TextBlock Text="{Binding DeviceStatusText}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="#E3F2FD" CornerRadius="10" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="Blue" />
                        <TextBlock Text="{Binding InventoryStatusText}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding AntennaStatusText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GpiStatusText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GpoStatusText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding IdentificationStatusText}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
