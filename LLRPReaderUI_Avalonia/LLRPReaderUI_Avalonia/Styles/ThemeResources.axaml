<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Light Theme Colors -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Core colors -->
            <Color x:Key="PrimaryColor">#0583C9</Color>
            <Color x:Key="PrimaryColorLight">#40A9E2</Color>
            <Color x:Key="PrimaryColorDark">#0369A1</Color>
            <Color x:Key="SecondaryColor">#F3981E</Color>
            <Color x:Key="BackgroundColor">#E8EDF3</Color>
            <Color x:Key="BackgroundColorAlt">#DCE4ED</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceMutedColor">#F4F8FB</Color>
            <Color x:Key="SurfaceStrongColor">#E7F0F6</Color>
            <Color x:Key="BorderColor">#D1D9E6</Color>
            <Color x:Key="BorderStrongColor">#A7BECE</Color>

            <!-- Text colors -->
            <Color x:Key="TextPrimaryColor">#0F172A</Color>
            <Color x:Key="TextSecondaryColor">#334155</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#0583C9" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#40A9E2" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0369A1" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8EDF3" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F4F8FB" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#E7F0F6" />
            <SolidColorBrush x:Key="BorderBrushCustom" Color="#D1D9E6" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#A7BECE" />

            <!-- Text brushes -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

            <!-- Gradient backgrounds -->
            <LinearGradientBrush x:Key="WindowBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#F5FAFD" />
                <GradientStop Offset="0.5" Color="#E8EDF3" />
                <GradientStop Offset="1" Color="#DCE4ED" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavigationBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#F6FBFE" />
                <GradientStop Offset="0.55" Color="#ECF4F9" />
                <GradientStop Offset="1" Color="#E4EEF5" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavigationHeaderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#E6F2F8" />
                <GradientStop Offset="1" Color="#D6E8F2" />
            </LinearGradientBrush>

            <!-- Glass overlay -->
            <SolidColorBrush x:Key="WindowGlassOverlayBrush" Color="#18FFFFFF" />

            <!-- Navigation-specific -->
            <SolidColorBrush x:Key="NavigationOuterBorderBrush" Color="#C3D5E2" />
            <SolidColorBrush x:Key="NavigationForegroundBrush" Color="#173447" />
            <SolidColorBrush x:Key="NavigationHeaderIconBrush" Color="#0E5B88" />
            <SolidColorBrush x:Key="NavigationHeaderAccentBrush" Color="#3C7394" />
            <SolidColorBrush x:Key="NavigationButtonHoverBrush" Color="#140583C9" />
            <SolidColorBrush x:Key="NavigationItemHoverBorderBrush" Color="#280583C9" />
            <SolidColorBrush x:Key="NavigationItemSelectedBorderBrush" Color="#3B0583C9" />

            <!-- Status bar -->
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F4FAFD" />

            <!-- Overlay / interaction brushes -->
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14007ACC" />
            <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#26007ACC" />
            <SolidColorBrush x:Key="SubtleOverlayBrush" Color="#F0F4F8" />
            <SolidColorBrush x:Key="ModalOverlayBrush" Color="#80000000" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#20000000" />
            <SolidColorBrush x:Key="BusyDialogAccentBrush" Color="#EEF8FE" />
            <BoxShadows x:Key="BusyDialogShadow">0 18 48 0 #33000000</BoxShadows>

            <!-- Button variants -->
            <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#0D6E9E" />
            <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#0B5E8C" />
            <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#094D73" />
            <SolidColorBrush x:Key="NeutralButtonBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeutralButtonHoverBrush" Color="#F2F7FA" />
            <SolidColorBrush x:Key="NeutralButtonPressedBrush" Color="#E8F0F5" />
            <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#CBD7DF" />
            <SolidColorBrush x:Key="NeutralButtonHoverBorderBrush" Color="#94B3C4" />
            <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#16415A" />
            <SolidColorBrush x:Key="OutlineButtonBrush" Color="#EAF4FA" />
            <SolidColorBrush x:Key="OutlineButtonHoverBrush" Color="#DCECF5" />
            <SolidColorBrush x:Key="OutlineButtonPressedBrush" Color="#CFE3EE" />
            <SolidColorBrush x:Key="OutlineButtonBorderBrush" Color="#D5E5EE" />
            <SolidColorBrush x:Key="OutlineButtonHoverBorderBrush" Color="#B8D2E1" />
            <SolidColorBrush x:Key="ButtonFocusBrush" Color="#660583C9" />

            <!-- Group header -->
            <SolidColorBrush x:Key="GroupHeaderForegroundBrush" Color="#163548" />

            <!-- Warning text -->
            <SolidColorBrush x:Key="WarningTextBrush" Color="#8E4B18" />

            <!-- Status bar brushes -->
            <SolidColorBrush x:Key="StatusDefaultTextBrush" Color="#475569" />
            <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#991B1B" />
            <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="#166534" />
            <SolidColorBrush x:Key="StatusActiveTextBrush" Color="#1D4ED8" />

            <SolidColorBrush x:Key="StatusChipErrorBrush" Color="#FEE2E2" />
            <SolidColorBrush x:Key="StatusChipSuccessBrush" Color="#DCFCE7" />
            <SolidColorBrush x:Key="StatusChipDefaultBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="StatusChipActiveBrush" Color="#DBEAFE" />

            <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="StatusDotSuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="StatusDotDefaultBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="StatusDotActiveBrush" Color="#3B82F6" />

            <!-- Card / surface -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D1D9E6" />
            <SolidColorBrush x:Key="CardInnerBackgroundBrush" Color="#F5F7FA" />

            <!-- DataGrid brushes -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#EFF6FF" />

            <!-- Scroll brushes -->
            <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#EEF4F8" />
            <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B8CBD7" />
            <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#8EACBD" />

            <!-- Icon brushes -->
            <SolidColorBrush x:Key="IconPrimaryBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="IconInfoBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="IconSuccessBrush" Color="#10B981" />
            <SolidColorBrush x:Key="IconDangerBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="IconWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="IconAccentBrush" Color="#6366F1" />
            <SolidColorBrush x:Key="IconTealBrush" Color="#14B8A6" />
            <SolidColorBrush x:Key="IconVioletBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="IconSlateBrush" Color="#64748B" />

            <!-- Read/Write required field brushes -->
            <SolidColorBrush x:Key="ReadRequiredForeground" Color="#0B5CAD" />
            <SolidColorBrush x:Key="WriteRequiredForeground" Color="#B54708" />
            <SolidColorBrush x:Key="ReadRequiredBackground" Color="#EAF3FF" />
            <SolidColorBrush x:Key="WriteRequiredBackground" Color="#FFF3E8" />
            <LinearGradientBrush x:Key="BothRequiredBackground" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#EAF3FF" Offset="0" />
                <GradientStop Color="#EAF3FF" Offset="0.33" />
                <GradientStop Color="#FFF3E8" Offset="0.67" />
                <GradientStop Color="#FFF3E8" Offset="1" />
            </LinearGradientBrush>

            <!-- ToolTip brushes -->
            <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#D1D9E6" />
            <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#0F172A" />

            <!-- Page and Section Padding -->
            <sys:Double x:Key="ControlGap">8</sys:Double>
            <sys:Double x:Key="SectionGap">12</sys:Double>
            <Thickness x:Key="PagePadding">16</Thickness>
            <Thickness x:Key="SectionPadding">12</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>
            <CornerRadius x:Key="InputRadius">8</CornerRadius>
            <CornerRadius x:Key="CardRadius">10</CornerRadius>
            <CornerRadius x:Key="PanelRadius">12</CornerRadius>
            <CornerRadius x:Key="ShellRadius">16</CornerRadius>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Core colors - Dark Theme -->
            <Color x:Key="PrimaryColor">#4DA6D6</Color>
            <Color x:Key="PrimaryColorLight">#77C4EF</Color>
            <Color x:Key="PrimaryColorDark">#17384B</Color>
            <Color x:Key="SecondaryColor">#D08A4B</Color>
            <Color x:Key="BackgroundColor">#09131A</Color>
            <Color x:Key="BackgroundColorAlt">#0F1D26</Color>
            <Color x:Key="SurfaceColor">#11212B</Color>
            <Color x:Key="SurfaceMutedColor">#162A35</Color>
            <Color x:Key="SurfaceStrongColor">#1D3949</Color>
            <Color x:Key="BorderColor">#274352</Color>
            <Color x:Key="BorderStrongColor">#3B6176</Color>

            <!-- Text colors -->
            <Color x:Key="TextPrimaryColor">#EAF6FB</Color>
            <Color x:Key="TextSecondaryColor">#A5C0CF</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#4DA6D6" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#77C4EF" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#17384B" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#09131A" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#11212B" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#162A35" />
            <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#1D3949" />
            <SolidColorBrush x:Key="BorderBrushCustom" Color="#274352" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3B6176" />

            <!-- Text brushes -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF6FB" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5C0CF" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#7F9BAA" />

            <!-- Gradient backgrounds -->
            <LinearGradientBrush x:Key="WindowBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#10242F" />
                <GradientStop Offset="0.45" Color="#09131A" />
                <GradientStop Offset="1" Color="#0F1D26" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavigationBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#102B39" />
                <GradientStop Offset="0.55" Color="#0C212D" />
                <GradientStop Offset="1" Color="#08161E" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavigationHeaderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#286584" />
                <GradientStop Offset="1" Color="#183F53" />
            </LinearGradientBrush>

            <!-- Glass overlay -->
            <SolidColorBrush x:Key="WindowGlassOverlayBrush" Color="#14FFFFFF" />

            <!-- Navigation-specific -->
            <SolidColorBrush x:Key="NavigationOuterBorderBrush" Color="#284555" />
            <SolidColorBrush x:Key="NavigationForegroundBrush" Color="#EAF6FB" />
            <SolidColorBrush x:Key="NavigationHeaderIconBrush" Color="#E7F5FF" />
            <SolidColorBrush x:Key="NavigationHeaderAccentBrush" Color="#B9E7FF" />
            <SolidColorBrush x:Key="NavigationButtonHoverBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="NavigationItemHoverBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="NavigationItemSelectedBorderBrush" Color="#32FFFFFF" />

            <!-- Status bar -->
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#172832" />

            <!-- Overlay / interaction brushes -->
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="SubtleOverlayBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ModalOverlayBrush" Color="#9A040A0E" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="BusyDialogAccentBrush" Color="#16313F" />
            <BoxShadows x:Key="BusyDialogShadow">0 18 48 0 #66000000</BoxShadows>

            <!-- Button variants -->
            <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#2F97C8" />
            <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#3AA8DC" />
            <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#247EA8" />
            <SolidColorBrush x:Key="NeutralButtonBrush" Color="#13252E" />
            <SolidColorBrush x:Key="NeutralButtonHoverBrush" Color="#19313C" />
            <SolidColorBrush x:Key="NeutralButtonPressedBrush" Color="#203D4A" />
            <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#2B4653" />
            <SolidColorBrush x:Key="NeutralButtonHoverBorderBrush" Color="#4B758C" />
            <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#D6ECF7" />
            <SolidColorBrush x:Key="OutlineButtonBrush" Color="#183340" />
            <SolidColorBrush x:Key="OutlineButtonHoverBrush" Color="#204456" />
            <SolidColorBrush x:Key="OutlineButtonPressedBrush" Color="#285469" />
            <SolidColorBrush x:Key="OutlineButtonBorderBrush" Color="#2B4B5A" />
            <SolidColorBrush x:Key="OutlineButtonHoverBorderBrush" Color="#47758C" />
            <SolidColorBrush x:Key="ButtonFocusBrush" Color="#88A6D7F0" />

            <!-- Group header -->
            <SolidColorBrush x:Key="GroupHeaderForegroundBrush" Color="#F5FBFF" />

            <!-- Warning text -->
            <SolidColorBrush x:Key="WarningTextBrush" Color="#F0C18F" />

            <!-- Status bar brushes -->
            <SolidColorBrush x:Key="StatusDefaultTextBrush" Color="#A5C0CF" />
            <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#FFB4A7" />
            <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="#8FE3B1" />
            <SolidColorBrush x:Key="StatusActiveTextBrush" Color="#8FD9FF" />

            <SolidColorBrush x:Key="StatusChipErrorBrush" Color="#412120" />
            <SolidColorBrush x:Key="StatusChipSuccessBrush" Color="#16342A" />
            <SolidColorBrush x:Key="StatusChipDefaultBrush" Color="#1A313E" />
            <SolidColorBrush x:Key="StatusChipActiveBrush" Color="#17384B" />

            <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#EC877E" />
            <SolidColorBrush x:Key="StatusDotSuccessBrush" Color="#4ED191" />
            <SolidColorBrush x:Key="StatusDotDefaultBrush" Color="#6E91A3" />
            <SolidColorBrush x:Key="StatusDotActiveBrush" Color="#5EC5FA" />

            <!-- Card / surface -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#11212B" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#274352" />
            <SolidColorBrush x:Key="CardInnerBackgroundBrush" Color="#243042" />

            <!-- DataGrid brushes -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#173848" />
            <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#1E4B60" />

            <!-- Scroll brushes -->
            <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#0D1E27" />
            <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#36596B" />
            <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#5B8296" />

            <!-- Icon brushes -->
            <SolidColorBrush x:Key="IconPrimaryBrush" Color="#69C8F2" />
            <SolidColorBrush x:Key="IconInfoBrush" Color="#69C8F2" />
            <SolidColorBrush x:Key="IconSuccessBrush" Color="#61D89A" />
            <SolidColorBrush x:Key="IconDangerBrush" Color="#F28B80" />
            <SolidColorBrush x:Key="IconWarningBrush" Color="#F0B164" />
            <SolidColorBrush x:Key="IconAccentBrush" Color="#7FBAE0" />
            <SolidColorBrush x:Key="IconTealBrush" Color="#4DC4C2" />
            <SolidColorBrush x:Key="IconVioletBrush" Color="#8FA8C4" />
            <SolidColorBrush x:Key="IconSlateBrush" Color="#8BA5B5" />

            <!-- Read/Write required field brushes - Dark Theme -->
            <SolidColorBrush x:Key="ReadRequiredForeground" Color="#90D6FF" />
            <SolidColorBrush x:Key="WriteRequiredForeground" Color="#F4B57C" />
            <SolidColorBrush x:Key="ReadRequiredBackground" Color="#123347" />
            <SolidColorBrush x:Key="WriteRequiredBackground" Color="#4A2B18" />
            <LinearGradientBrush x:Key="BothRequiredBackground" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#123347" Offset="0" />
                <GradientStop Color="#123347" Offset="0.33" />
                <GradientStop Color="#4A2B18" Offset="0.67" />
                <GradientStop Color="#4A2B18" Offset="1" />
            </LinearGradientBrush>

            <!-- ToolTip brushes - high contrast for dark theme -->
            <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#1D3949" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#475569" />
            <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#EAF6FB" />

            <!-- Page and Section Padding -->
            <sys:Double x:Key="ControlGap">8</sys:Double>
            <sys:Double x:Key="SectionGap">12</sys:Double>
            <Thickness x:Key="PagePadding">16</Thickness>
            <Thickness x:Key="SectionPadding">12</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>
            <CornerRadius x:Key="InputRadius">8</CornerRadius>
            <CornerRadius x:Key="CardRadius">10</CornerRadius>
            <CornerRadius x:Key="PanelRadius">12</CornerRadius>
            <CornerRadius x:Key="ShellRadius">16</CornerRadius>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
