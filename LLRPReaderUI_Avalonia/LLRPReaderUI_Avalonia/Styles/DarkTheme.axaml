<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Styles.Resources>
        <!-- Core colors - Dark Theme -->
        <Color x:Key="PrimaryColor">#3B82F6</Color>
        <Color x:Key="PrimaryColorLight">#60A5FA</Color>
        <Color x:Key="SecondaryColor">#F59E0B</Color>
        <Color x:Key="BackgroundColor">#0F172A</Color>
        <Color x:Key="SurfaceColor">#1E293B</Color>
        <Color x:Key="BorderColor">#334155</Color>

        <!-- Text colors -->
        <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
        <Color x:Key="TextSecondaryColor">#94A3B8</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryColorLight}" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BorderBrushCustom" Color="{StaticResource BorderColor}" />

        <!-- Text brushes -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <!-- Overlay / interaction brushes -->
        <SolidColorBrush x:Key="HoverOverlayBrush" Color="#143B82F6" />
        <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#263B82F6" />
        <SolidColorBrush x:Key="SubtleOverlayBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="ModalOverlayBrush" Color="#80000000" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#12FFFFFF" />

        <!-- Status bar text brushes -->
        <SolidColorBrush x:Key="StatusDefaultTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#FCA5A5" />
        <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="#86EFAC" />
        <SolidColorBrush x:Key="StatusActiveTextBrush" Color="#93C5FD" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#FCA5A5" />

        <!-- Status bar chip backgrounds -->
        <SolidColorBrush x:Key="StatusChipErrorBrush" Color="#450A0A" />
        <SolidColorBrush x:Key="StatusChipSuccessBrush" Color="#052E16" />
        <SolidColorBrush x:Key="StatusChipDefaultBrush" Color="#334155" />
        <SolidColorBrush x:Key="StatusChipActiveBrush" Color="#1E3A5F" />

        <!-- Status dot brushes -->
        <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#F87171" />
        <SolidColorBrush x:Key="StatusDotSuccessBrush" Color="#4ADE80" />
        <SolidColorBrush x:Key="StatusDotDefaultBrush" Color="#64748B" />
        <SolidColorBrush x:Key="StatusDotActiveBrush" Color="#60A5FA" />

        <!-- Card / surface -->
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />

        <!-- DataGrid brushes -->
        <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#1E3A5F" />
        <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#1F3B82F6" />

        <!-- Read/Write required field brushes -->
        <SolidColorBrush x:Key="ReadRequiredForeground" Color="#60A5FA" />
        <SolidColorBrush x:Key="WriteRequiredForeground" Color="#FB923C" />
        <SolidColorBrush x:Key="ReadRequiredBackground" Color="#1E3A5F" />
        <SolidColorBrush x:Key="WriteRequiredBackground" Color="#422006" />

        <!-- TreeView text brushes -->
        <SolidColorBrush x:Key="TreeValueBrush" Color="#93C5FD" />
        <SolidColorBrush x:Key="TreeDescriptionBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TreeMessageTypeBrush" Color="#4ADE80" />

        <!-- Icon brushes -->
        <SolidColorBrush x:Key="IconInfoBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="IconSuccessBrush" Color="#34D399" />
        <SolidColorBrush x:Key="IconDangerBrush" Color="#F87171" />
        <SolidColorBrush x:Key="IconWarningBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="IconAccentBrush" Color="#818CF8" />
        <SolidColorBrush x:Key="IconTealBrush" Color="#2DD4BF" />
        <SolidColorBrush x:Key="IconVioletBrush" Color="#A78BFA" />
        <SolidColorBrush x:Key="IconSlateBrush" Color="#94A3B8" />
    </Styles.Resources>

    <!-- Text styles -->
    <Style Selector="TextBlock.flat">
        <Setter Property="FontFamily" Value="Segoe UI, Inter" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- TextBox Style - Dark -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- ComboBox Style - Dark -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- DataGrid Styles - Dark -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource DataGridRowHoverBrush}" />
    </Style>

    <Style Selector="DataGridRow:selected /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="DataGridCell:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

</Styles>
