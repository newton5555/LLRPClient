<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!-- Default Button Style -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource NeutralButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource NeutralButtonForegroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource NeutralButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonHoverBorderBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource NeutralButtonPressedBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Primary Button -->
    <Style Selector="Button.primary">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonPressedBrush}" />
    </Style>

    <Style Selector="Button.primary:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.primary materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Flat/Outline Button -->
    <Style Selector="Button.flat">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource OutlineButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.flat:pointerover">
        <Setter Property="Background" Value="{DynamicResource OutlineButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonHoverBorderBrush}" />
    </Style>

    <Style Selector="Button.flat:pressed">
        <Setter Property="Background" Value="{DynamicResource OutlineButtonPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineButtonHoverBorderBrush}" />
    </Style>

    <Style Selector="Button.flat:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Danger Button -->
    <Style Selector="Button.danger">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource IconDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IconDangerBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style Selector="Button.danger:pressed">
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Button.danger:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.danger TextBlock">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.danger materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Card Border Style -->
    <Style Selector="Border.card">
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.inventoryMetrics">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource CardInnerBackgroundBrush}" />
    </Style>

    <Style Selector="Border.inventoryMetricCell">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.inventoryMetricIcon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
        <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Border.inventoryMetricDivider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="0,14" />
        <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>

    <Style Selector="TextBlock.metricLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.metricValue">
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="Border.statusChip">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
        <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="MaxWidth" Value="240" />
    </Style>

    <Style Selector="Border.statusChip.primaryStatus">
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="MaxWidth" Value="180" />
    </Style>

    <Style Selector="Border.statusChip.wideStatus">
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <Style Selector="Border.statusChip TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- TextBox Style -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- 给 TextBox 内部 TextPresenter 加左边距 -->
    <Style Selector="TextBox /template/ TextPresenter">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- AutoCompleteBox Style — 与 TextBox 完全一致 -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
    </Style>

    <Style Selector="AutoCompleteBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ComboBox Style -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
    </Style>

    <!-- DatePicker Style -->
    <Style Selector="DatePicker">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
    </Style>

    <!-- Hide DatePicker floating label in Material theme -->
    <Style Selector="DatePicker /template/ TextBox#DisplayTextBox">
        <Setter Property="UseFloatingWatermark" Value="False" />
    </Style>

    <!-- Scroll Styles -->
    <Style Selector="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Opacity" Value="0.68" />
        <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
    </Style>

    <Style Selector="ScrollBar:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Margin" Value="3,2,2,2" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ RepeatButton">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Margin" Value="2,3,2,2" />
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ RepeatButton">
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- DataGrid Styles -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="42" />
    </Style>

    <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource DataGridRowHoverBrush}" />
    </Style>

    <Style Selector="DataGridRow:selected /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource DataGridRowSelectedBrush}" />
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="DataGridCell:selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ListBox Styles -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource SelectedOverlayBrush}" />
    </Style>

    <!-- TextBlock Styles -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.subHeading">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="StackPanel.sectionHeader">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{DynamicResource ControlGap}" />
    </Style>

    <Style Selector="TextBlock.statusHint">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>

    <!-- FontWeight utility classes - Android 上可被覆盖 -->
    <Style Selector="TextBlock.semiBold">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.bold">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Run.semiBold">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Run.bold">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- TreeView Styles -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border#BackgroundModifier">
        <Setter Property="Background" Value="{DynamicResource SelectedOverlayBrush}" />
    </Style>

    <!-- ToolTip Style -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</Styles>
