<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.LogView"
             x:DataType="vm:LogViewModel">

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,8,*">
        <!-- Header -->
        <Border Classes="card">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="日志总数: "/>
                    <Run Text="{Binding TotalLogCount, Mode=OneWay}" FontWeight="Bold" 
                         Foreground="{DynamicResource PrimaryBrush}"/>
                </TextBlock>

                <Button Grid.Column="1" HorizontalAlignment="Right" Command="{Binding ClearLogsCommand}" Content="清空全部" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Log Tabs -->
        <TabControl Grid.Row="2" Padding="5" Background="{DynamicResource CardInnerBackgroundBrush}">
            <!-- Operation Logs -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="ClipboardList" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="操作日志" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Button HorizontalAlignment="Right" Margin="8" Command="{Binding ClearOperationLogsCommand}" Content="清空"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding OperationEntries}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}"/>
                </Grid>
            </TabItem>

            <!-- LLRP Message Logs -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="SatelliteUplink" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="LLRP 消息日志" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Button HorizontalAlignment="Right" Margin="8" Command="{Binding ClearLlrpMessageLogsCommand}" Content="清空"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LlrpMessageEntries}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}"/>
                </Grid>
            </TabItem>

            <!-- Raw Frame Logs -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Code" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="原始报文收发" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Button HorizontalAlignment="Right" Margin="8" Command="{Binding ClearRawFrameLogsCommand}" Content="清空"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding RawPacketEntries}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
