<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.LogView"
             x:DataType="vm:LogViewModel">

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,8,*">
        <Border Grid.Row="0" Classes="card">
            <Grid RowDefinitions="Auto,12,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Log.Center}" Classes="heading"/>
                    <Border Margin="12,0,0,0" Padding="12,6" Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="8">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{DynamicResource Log.Total}"/>
                            <Run Text="{Binding TotalLogCount, Mode=OneWay}" Classes="bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Classes="flat">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Delete" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Log.ClearAll}"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <CheckBox IsChecked="{Binding ShowOperationLogs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Log.Operation}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OperationEntries.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowLlrpMessageLogs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Log.LlrpMessage}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LlrpMessageEntries.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowRawFrameLogs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Log.RawFrame}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RawPacketEntries.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent">
            <TabItem IsVisible="{Binding ShowOperationLogs}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="ClipboardList" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Log.Operation}" Classes="semiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Classes="card" Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <Button HorizontalAlignment="Right" Command="{Binding ClearOperationLogsCommand}" Classes="flat">
                            <TextBlock Text="{DynamicResource Action.Clear}"/>
                        </Button>
                        <ListBox Grid.Row="1" ItemsSource="{Binding OperationEntries, Mode=OneWay}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushCustom}" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="11" SelectionMode="Multiple"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem IsVisible="{Binding ShowLlrpMessageLogs}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="SatelliteUplink" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Log.LlrpMessage}" Classes="semiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Classes="card" Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <Button HorizontalAlignment="Right" Command="{Binding ClearLlrpMessageLogsCommand}" Classes="flat">
                            <TextBlock Text="{DynamicResource Action.Clear}"/>
                        </Button>
                        <ListBox Grid.Row="1" ItemsSource="{Binding LlrpMessageEntries, Mode=OneWay}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushCustom}" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="11" SelectionMode="Multiple"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem IsVisible="{Binding ShowRawFrameLogs}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Code" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Log.RawFrame}" Classes="semiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Classes="card" Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <Button HorizontalAlignment="Right" Command="{Binding ClearRawFrameLogsCommand}" Classes="flat">
                            <TextBlock Text="{DynamicResource Action.Clear}"/>
                        </Button>
                        <ListBox Grid.Row="1" ItemsSource="{Binding RawPacketEntries, Mode=OneWay}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushCustom}" Margin="0,10,0,0"
                                 FontFamily="Consolas" FontSize="11" SelectionMode="Multiple"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
