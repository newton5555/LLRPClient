<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1500"
             x:Class="LLRPReaderUI_Avalonia.Views.InventoryConfigView"
             x:DataType="vm:InventoryConfigViewModel">

    <Grid RowDefinitions="*,12,Auto,32">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource PagePadding}" Spacing="12">
                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Classes="sectionHeader">
                            <materialIcons:MaterialIcon Kind="CursorPointer" Width="16" Height="16" Foreground="{DynamicResource IconPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource InventoryConfig.OperationTriggers}" Classes="semiBold"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource InventoryConfig.AutoStartConfig}" Classes="bold" Foreground="{DynamicResource IconSuccessBrush}" Margin="0,0,0,2"/>
                        <Grid ColumnDefinitions="200,420" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto" Margin="8,0,0,6">
                            <TextBlock Text="{DynamicResource InventoryConfig.Mode}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AutoStartModes}" SelectedItem="{Binding AutoStartMode}" Height="36"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource InventoryConfig.GpiPortNum}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AutoStartGpiPortNumber}" Height="36"/>

                            <TextBlock Grid.Row="4" Text="{DynamicResource InventoryConfig.GpiLevel}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding AutoStartGpiLevel}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.FirstDelayMs}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AutoStartFirstDelayInMs}" Height="36"/>

                            <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.PeriodMs}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding AutoStartPeriodInMs}" Height="36"/>

                            <TextBlock Grid.Row="10" Text="{DynamicResource InventoryConfig.UtcTimestamp}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding AutoStartUtcTimestamp}" Height="36"/>
                        </Grid>

                        <Separator/>

                        <TextBlock Text="{DynamicResource InventoryConfig.AutoStopConfig}" Classes="bold" Foreground="{DynamicResource IconDangerBrush}" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="200,420" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource InventoryConfig.Mode}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AutoStopModes}" SelectedItem="{Binding AutoStopMode}" Height="36"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource InventoryConfig.DurationMs}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AutoStopDurationInMs}" Height="36"/>

                            <TextBlock Grid.Row="4" Text="{DynamicResource InventoryConfig.GpiPortNum}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AutoStopGpiPortNumber}" Height="36"/>

                            <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.GpiLevel}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding AutoStopGpiLevel}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.Timeout}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding AutoStopTimeout}" Height="36"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Classes="sectionHeader">
                            <materialIcons:MaterialIcon Kind="Filter" Width="16" Height="16" Foreground="{DynamicResource IconWarningBrush}"/>
                            <TextBlock Text="{DynamicResource InventoryConfig.FilterConfig}" Classes="semiBold"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="200,420" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource InventoryConfig.Mode}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TagFilterModes}" SelectedItem="{Binding FilterMode}" Height="36"/>
                        </Grid>

                        <Border Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="8" Padding="8" Margin="8,0,0,0"
                                IsVisible="{Binding ShowTagFilter1}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource InventoryConfig.TagFilter1}" Classes="semiBold"/>
                                <Grid ColumnDefinitions="150,180" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                                    <TextBlock Text="{DynamicResource InventoryConfig.MemoryBank}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding Filter1MemoryBank}" Height="36"/>
                                    <TextBlock Grid.Row="2" Text="{DynamicResource InventoryConfig.BitPointer}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Filter1BitPointer}" Height="36"/>
                                    <TextBlock Grid.Row="4" Text="{DynamicResource InventoryConfig.BitCount}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Filter1BitCount}" Height="36"/>
                                    <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.FilterOp}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding TagFilterOps}" SelectedItem="{Binding Filter1FilterOp}" Height="36"/>
                                    <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.TagMaskHex}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Filter1TagMask}" Height="36"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="8" Padding="8" Margin="8,0,0,0"
                                IsVisible="{Binding ShowTagFilter2}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource InventoryConfig.TagFilter2}" Classes="semiBold"/>
                                <Grid ColumnDefinitions="150,180" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                                    <TextBlock Text="{DynamicResource InventoryConfig.MemoryBank}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding Filter2MemoryBank}" Height="36"/>
                                    <TextBlock Grid.Row="2" Text="{DynamicResource InventoryConfig.BitPointer}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Filter2BitPointer}" Height="36"/>
                                    <TextBlock Grid.Row="4" Text="{DynamicResource InventoryConfig.BitCount}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Filter2BitCount}" Height="36"/>
                                    <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.FilterOp}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding TagFilterOps}" SelectedItem="{Binding Filter2FilterOp}" Height="36"/>
                                    <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.TagMaskHex}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Filter2TagMask}" Height="36"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="8" Padding="8" Margin="8,0,0,0"
                                IsVisible="{Binding ShowTagSelectFilters}"
                                IsEnabled="{Binding IsStateAwareTagSelectFiltersEnabled}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource InventoryConfig.TagSelectFilters}" Classes="semiBold"/>
                                <Button MinWidth="120" HorizontalAlignment="Left" Command="{Binding AddTagSelectFilterCommand}" Classes="flat">
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource InventoryConfig.AddFilter}"/>
                                    </StackPanel>
                                </Button>
                                <ItemsControl ItemsSource="{Binding TagSelectFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TagSelectFilterItemViewModel">
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="150,180" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                                                    <TextBlock Text="{DynamicResource InventoryConfig.MemoryBank}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.MemoryBanks}" SelectedItem="{Binding MemoryBank}" Height="26"/>

                                                    <TextBlock Grid.Row="2" Text="{DynamicResource InventoryConfig.BitCount}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BitCount}" Height="26"/>

                                                    <TextBlock Grid.Row="4" Text="{DynamicResource InventoryConfig.BitPointer}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BitPointer}" Height="26"/>

                                                    <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.MatchAction}" VerticalAlignment="Center"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.ShowStateUnawareTagSelectFilterActions}"/>
                                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.StateUnawareActions}" SelectedItem="{Binding MatchAction}" Height="26"
                                                              IsVisible="{Binding $parent[UserControl].DataContext.ShowStateUnawareTagSelectFilterActions}"/>

                                                    <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.NonMatchAction}" VerticalAlignment="Center"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.ShowStateUnawareTagSelectFilterActions}"/>
                                                    <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.StateUnawareActions}" SelectedItem="{Binding NonMatchAction}" Height="26"
                                                              IsVisible="{Binding $parent[UserControl].DataContext.ShowStateUnawareTagSelectFilterActions}"/>

                                                    <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.StateAwareTarget}" VerticalAlignment="Center"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.ShowStateAwareTagSelectFilterActions}"/>
                                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.StateAwareTargets}" SelectedItem="{Binding StateAwareTarget}" Height="26"
                                                              IsVisible="{Binding $parent[UserControl].DataContext.ShowStateAwareTagSelectFilterActions}"/>

                                                    <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.StateAwareAction}" VerticalAlignment="Center"
                                                               IsVisible="{Binding $parent[UserControl].DataContext.ShowStateAwareTagSelectFilterActions}"/>
                                                    <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.StateAwareActions}" SelectedItem="{Binding StateAwareAction}" Height="26"
                                                              IsVisible="{Binding $parent[UserControl].DataContext.ShowStateAwareTagSelectFilterActions}"/>

                                                    <TextBlock Grid.Row="10" Text="{DynamicResource InventoryConfig.TagMask}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding TagMask}" Height="26"/>

                                                    <Button Grid.Row="12" Grid.Column="1" MinWidth="88" HorizontalAlignment="Left"
                                                            Command="{Binding $parent[UserControl].DataContext.RemoveTagSelectFilterCommand}"
                                                            CommandParameter="{Binding}" Classes="danger">
                                                        <TextBlock Text="{DynamicResource InventoryConfig.Delete}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Classes="sectionHeader">
                            <materialIcons:MaterialIcon Kind="Poll" Width="16" Height="16" Foreground="{DynamicResource IconAccentBrush}"/>
                            <TextBlock Text="{DynamicResource InventoryConfig.ReportingStrategy}" Classes="semiBold"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource InventoryConfig.ReportConfig}" Classes="bold" Foreground="{DynamicResource IconVioletBrush}" Margin="0,0,0,2"/>
                        <Grid ColumnDefinitions="200,420" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource InventoryConfig.ReportMode}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ReportModes}" SelectedItem="{Binding ReportMode}" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:ReportModeOptionItem">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="260,260" RowDefinitions="Auto,Auto,Auto,Auto" Margin="8,0,0,0">
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeAntenna}" IsChecked="{Binding IncludeAntennaPortNumber}" Margin="0,4"/>
                            <CheckBox Grid.Column="1" Content="{DynamicResource InventoryConfig.IncludeChannel}" IsChecked="{Binding IncludeChannel}" Margin="0,4"/>
                            <CheckBox Grid.Row="1" Content="{DynamicResource InventoryConfig.IncludeFirstSeen}" IsChecked="{Binding IncludeFirstSeenTime}" Margin="0,4"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="{DynamicResource InventoryConfig.IncludeLastSeen}" IsChecked="{Binding IncludeLastSeenTime}" Margin="0,4"/>
                            <CheckBox Grid.Row="2" Content="{DynamicResource InventoryConfig.IncludeSeenCount}" IsChecked="{Binding IncludeSeenCount}" Margin="0,4"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" Content="{DynamicResource InventoryConfig.IncludePeakRssi}" IsChecked="{Binding IncludePeakRssi}" Margin="0,4"/>
                            <CheckBox Grid.Row="3" Content="{DynamicResource InventoryConfig.IncludePcBits}" IsChecked="{Binding IncludePcBits}" Margin="0,4"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" Content="{DynamicResource InventoryConfig.IncludeCrc}" IsChecked="{Binding IncludeCrc}" Margin="0,4"/>
                        </Grid>

                        <Separator/>

                        <TextBlock Text="{DynamicResource InventoryConfig.AttachedDataConfig}" Classes="bold" Foreground="{DynamicResource IconTealBrush}" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="200,420" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource InventoryConfig.EnableAttachedData}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AttachedDataEnabled}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource InventoryConfig.MemoryBank}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding AttachedDataMemoryBank}" Height="36"/>

                            <TextBlock Grid.Row="4" Text="{DynamicResource InventoryConfig.WordStartAddr}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AttachedDataWordPointer}" Height="36"/>

                            <TextBlock Grid.Row="6" Text="{DynamicResource InventoryConfig.WordCount}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AttachedDataWordCount}" Height="36"/>

                            <TextBlock Grid.Row="8" Text="{DynamicResource InventoryConfig.AccessPasswordHex}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding AttachedDataAccessPassword}" Height="36"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="16,0">
            <Button MinWidth="132" Command="{Binding QueryInventoryConfigCommand}" Classes="flat">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource InventoryConfig.ReadConfig}"/>
                </StackPanel>
            </Button>
            <Button MinWidth="132" Command="{Binding SaveInventoryConfigCommand}" Classes="primary">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource InventoryConfig.SaveConfig}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding OperationResult}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="16,0"/>
    </Grid>
</UserControl>
