<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.GpioView"
             x:DataType="vm:GpioViewModel">

    <Grid Margin="16" RowDefinitions="*,16,Auto,32">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12">
                <!-- GPI Configuration -->
                <Border Background="White" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="16" Height="16" Foreground="#22C55E"/>
                            <TextBlock Text="{DynamicResource GPIO.GpiConfig}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="120,120,120" Margin="8,0,0,8">
                            <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.Enable}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Gpis}" Margin="8,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GpiPortItemViewModel">
                                    <Grid ColumnDefinitions="120,120,120" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PortNumber, StringFormat='GPI {0}'}"/>
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CurrentStateText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- GPO Configuration -->
                <Border Background="White" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="16" Height="16" Foreground="#3B82F6"/>
                            <TextBlock Text="{DynamicResource GPIO.GpoOutput}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="120,140,140" Margin="8,0,0,8">
                            <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.OutputHigh}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontWeight="SemiBold"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Gpos}" Margin="8,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GpoPortItemViewModel">
                                    <Grid ColumnDefinitions="120,140,140" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PortNumber, StringFormat='GPO {0}'}"/>
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DesiredState}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CurrentStateText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Height="32" Width="120" Command="{Binding QueryGpioSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" Margin="0,0,6,0" Foreground="#3B82F6"/>
                    <TextBlock Text="{DynamicResource GPIO.Query}"/>
                </StackPanel>
            </Button>
            <Button Height="32" Width="120" Command="{Binding SaveGpiSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,6,0" Foreground="#22C55E"/>
                    <TextBlock Text="{DynamicResource GPIO.SaveGpi}"/>
                </StackPanel>
            </Button>
            <Button Height="32" Width="120" Command="{Binding ApplyGpoStatesCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Send" Width="14" Height="14" Margin="0,0,6,0" Foreground="#8B5CF6"/>
                    <TextBlock Text="{DynamicResource GPIO.ApplyGpo}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding OperationResult}" Foreground="#1976D2" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
