<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="LLRPReaderUI_Avalonia.Views.ReadWriteView"
             x:DataType="vm:ReadWriteViewModel">

    <ScrollViewer>
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="900" Spacing="12">
            <!-- Read/Write Configuration -->
            <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                <StackPanel Spacing="12">
                    <!-- Header -->
                    <TextBlock Text="{DynamicResource ReadWrite.ReadConfig}" 
                               Classes="semiBold" 
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    
                    <!-- Legend -->
                    <TextBlock Text="{DynamicResource ReadWrite.Legend}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="12"
                               TextWrapping="Wrap" />
                    
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,12,Auto,12,Auto,12,Auto,12,Auto,12,Auto,12,Auto" Margin="0,8,0,0">
                        <!-- Target Tag Type -->
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.TargetTagType}" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding TargetTagBanks}" 
                                  SelectedItem="{Binding SelectedTargetTagBank}" 
                                  Height="36"
                                  ToolTip.Tip="{DynamicResource ReadWrite.TargetTagTooltip}" />

                        <!-- Target Tag Data (Required for both Read/Write) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.TargetTagData}" 
                                   VerticalAlignment="Center" 
                                   Classes="semiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Grid.Row="2" Grid.Column="1" 
                                BorderBrush="{DynamicResource IconWarningBrush}" 
                                BorderThickness="1" 
                                Height="36"
                                CornerRadius="4">
                            <TextBox Text="{Binding TargetTagData, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BothRequiredBackground}"
                                     BorderThickness="1"
                                     ClipToBounds="True"
                                     VerticalContentAlignment="Center"
                                     Padding="8"
                                     
                                     ToolTip.Tip="{DynamicResource ReadWrite.TargetTagTooltip}" />
                        </Border>

                        <!-- Memory Bank -->
                        <TextBlock Grid.Row="4" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.MemoryBank}" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" 
                                  ItemsSource="{Binding MemoryBanks}" 
                                  SelectedItem="{Binding SelectedMemoryBank}" 
                                  Height="36"
                                  ToolTip.Tip="{DynamicResource ReadWrite.TargetTagTooltip}" />

                        <!-- Word Start Address (Required for both) -->
                        <TextBlock Grid.Row="6" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.WordStartAddress}" 
                                   VerticalAlignment="Center" 
                                   Classes="semiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Grid.Row="6" Grid.Column="1" 
                                BorderBrush="{DynamicResource IconWarningBrush}" 
                                BorderThickness="1" 
                                Height="36"
                                CornerRadius="4">
                            <TextBox Text="{Binding WordPointer, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BothRequiredBackground}"
                                     
                                      BorderThickness="1" 
                                     VerticalContentAlignment="Center"
                                     Padding="8"
                                     
                                     ToolTip.Tip="{DynamicResource ReadWrite.WordPointerTooltip}" />
                        </Border>

                        <!-- Word Count (Read Required) -->
                        <TextBlock Grid.Row="8" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.WordCount}" 
                                   VerticalAlignment="Center" 
                                   Classes="semiBold"
                                   Foreground="{DynamicResource ReadRequiredForeground}" />
                        <TextBox Grid.Row="8" Grid.Column="1" 
                                 Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource ReadRequiredBackground}"
                                 BorderBrush="{DynamicResource ReadRequiredForeground}"
                                 BorderThickness="1"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8"
                                 ToolTip.Tip="{DynamicResource ReadWrite.WordCountTooltip}" />

                        <!-- Write Data (Write Required) -->
                        <TextBlock Grid.Row="10" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.WriteData}" 
                                   VerticalAlignment="Center" 
                                   Classes="semiBold"
                                   Foreground="{DynamicResource WriteRequiredForeground}" />
                        <TextBox Grid.Row="10" Grid.Column="1" 
                                 Text="{Binding WriteData, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{DynamicResource WriteRequiredBackground}"
                                 BorderBrush="{DynamicResource WriteRequiredForeground}"
                                 BorderThickness="1"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8"
                                 ToolTip.Tip="{DynamicResource ReadWrite.WriteDataTooltip}" />

                        <!-- Access Password -->
                        <TextBlock Grid.Row="12" Grid.Column="0" 
                                   Text="{DynamicResource ReadWrite.AccessPassword}" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Grid.Row="12" Grid.Column="1" 
                                 Text="{Binding AccessPassword, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8"
                                 ToolTip.Tip="{DynamicResource ReadWrite.AccessPasswordTooltip}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Operations -->
            <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                <StackPanel Spacing="12">
                    <!-- Header -->
                    <TextBlock Text="{DynamicResource ReadWrite.Operations}" 
                               Classes="semiBold" 
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    
                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Height="36" Width="120" 
                                Command="{Binding ReadMemoryCommand}"
                                Classes="primary">
                            <TextBlock Text="{DynamicResource ReadWrite.ReadMemory}" />
                        </Button>
                        <Button Height="36" Width="120" 
                                Command="{Binding WriteMemoryCommand}">
                            <TextBlock Text="{DynamicResource ReadWrite.WriteMemory}" />
                        </Button>
                        <CheckBox VerticalAlignment="Center" 
                                  Content="{DynamicResource ReadWrite.BlockWrite}" 
                                  IsChecked="{Binding IsBlockWriteChecked}" 
                                  IsEnabled="{Binding IsBlockWriteSupported}"
                                  ToolTip.Tip="{DynamicResource ReadWrite.BlockWriteTooltip}" />
                        <Button Height="36" Width="120" 
                                Command="{Binding ClearDataCommand}">
                            <TextBlock Text="{DynamicResource ReadWrite.ClearData}" />
                        </Button>
                    </StackPanel>
                    
                    <!-- Operation Result -->
                    <TextBlock Text="{Binding OperationResult}" 
                               Foreground="{DynamicResource PrimaryBrush}" 
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Read Result -->
            <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                <StackPanel Spacing="12">
                    <!-- Header -->
                    <TextBlock Text="{DynamicResource ReadWrite.ReadResult}" 
                               Classes="semiBold" 
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    
                    <TextBlock Text="{DynamicResource ReadWrite.HexData}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    
                    <Border BorderBrush="{DynamicResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Background="{DynamicResource SurfaceBrush}">
                        <ScrollViewer MinHeight="100">
                            <TextBox Text="{Binding ReadData, Mode=OneWay}" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     IsReadOnly="True" 
                                     FontFamily="Consolas,Courier New,monospace"
                                     BorderThickness="0"
                                     Background="Transparent" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
