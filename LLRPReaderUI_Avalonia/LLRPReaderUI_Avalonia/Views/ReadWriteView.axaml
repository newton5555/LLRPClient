<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.ReadWriteView"
             x:DataType="vm:ReadWriteViewModel">

    <Grid Margin="16" RowDefinitions="Auto,12,*">
        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ReadMemoryCommand}" Classes="accent" Height="32" IsEnabled="{Binding IsConnected}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="BookOpen" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Read" />
                </StackPanel>
            </Button>
            <Button Command="{Binding WriteMemoryCommand}" Height="32" IsEnabled="{Binding IsConnected}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Write" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearDataCommand}" Height="32">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding OperationResult}" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="#1976D2" />
        </StackPanel>

        <!-- Settings -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16">
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
                <!-- Left: Read Settings -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="12">
                    <TextBlock Text="Read/Write Settings" FontSize="16" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Bank:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TargetTagBanks}"
                                  SelectedItem="{Binding SelectedTargetTagBank}" Height="32" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Data:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetTagData}" Height="32" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory Bank:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MemoryBanks}"
                                  SelectedItem="{Binding SelectedMemoryBank}" Height="32" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Word Pointer:" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding WordPointer}"
                                       Minimum="0" Maximum="255" Height="32" />
                    </Grid>
                </StackPanel>

                <!-- Right: Result -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Result" FontSize="16" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ReadData}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" Height="150" FontFamily="Consolas" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
