<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             xmlns:converters="clr-namespace:LLRPReaderUI_Avalonia.Converters"
             xmlns:material="clr-namespace:Material.Avalonia;assembly=Material.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.LLRPMessageView"
              xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:DataType="vm:LLRPMessageViewModel">

    <UserControl.Resources>
        <converters:DirectionToBrushConverter x:Key="DirectionToBrushConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,Auto,*">
        <!-- Toolbar -->
        <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Width="120" Height="32" Command="{Binding RefreshDataCommand}" Classes="primary">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.Refresh}"/>
                        </StackPanel>
                    </Button>
                    <Button Width="120" Height="32" Command="{Binding ClearAllDataCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Delete" Width="14" Height="14" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource IconDangerBrush}"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearAll}"/>
                        </StackPanel>
                    </Button>
                    <Button Width="120" Height="32" Command="{Binding ExportToTextCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Export" Width="14" Height="14" Margin="0,0,6,0" 
                                                       Foreground="{DynamicResource IconSuccessBrush}"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.ExportText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{DynamicResource LLRPMessage.Total}"/>
                        <Run Text="{Binding RawFrames.Count, Mode=OneWay}" Classes="bold" 
                             Foreground="{DynamicResource PrimaryBrush}"/>
                        <Run Text="{DynamicResource LLRPMessage.Records}"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{DynamicResource LLRPMessage.Filtered}"/>
                        <Run Text="{Binding FilteredFrames.Count, Mode=OneWay}" Classes="bold" 
                             Foreground="{DynamicResource PrimaryBrush}"/>
                        <Run Text="{DynamicResource LLRPMessage.Records}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding StatusText}" 
                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Classes="card" Margin="0,8,0,0" Background="{DynamicResource CardInnerBackgroundBrush}">
            <Grid RowDefinitions="Auto,Auto">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock Text="{DynamicResource LLRPMessage.StartDate}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker MinWidth="140" Height="28" SelectedDate="{Binding FilterStartDate}"
                                    assists:TextFieldAssist.Label="{x:Null}"
                                    assists:DatePickerAssist.DateTimeFormat="yy/MM/dd"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock Text="{DynamicResource LLRPMessage.EndDate}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker MinWidth="140" Height="28" SelectedDate="{Binding FilterEndDate}"
                                    assists:TextFieldAssist.Label="{x:Null}"
                                    assists:DatePickerAssist.DateTimeFormat="yy/MM/dd"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock Text="{DynamicResource LLRPMessage.Direction}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox MinWidth="80" Height="28" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding FilterDirection}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock Text="{DynamicResource LLRPMessage.Device}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox MinWidth="80" Height="28" ItemsSource="{Binding DeviceIdOptions}" SelectedItem="{Binding FilterDeviceId}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                        <TextBlock Text="{DynamicResource LLRPMessage.MessageType}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox MinWidth="110" MaxWidth="220" Height="28" ItemsSource="{Binding MsgTypeOptions}" SelectedItem="{Binding FilterMsgType}"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Height="28" Command="{Binding ApplyFilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Filter" Width="12" Height="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.Filter}"/>
                        </StackPanel>
                    </Button>
                    <Button Height="28" Margin="8,0,0,0" Command="{Binding ClearFilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Margin="0,0,4,0" 
                                                       Foreground="{DynamicResource IconDangerBrush}"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearFilter}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="300,2,*">
            <!-- Left: Raw Frame List -->
            <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SubtleOverlayBrush}">
                        <TextBlock Text="{DynamicResource LLRPMessage.RawFrameList}" 
                                   Classes="semiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredFrames}" SelectedItem="{Binding SelectedRawFrame}"
                             BorderThickness="0" Background="{DynamicResource SurfaceBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LocalTimestamp, StringFormat='MM/dd HH:mm:ss'}" 
                                                   FontSize="12" Classes="semiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Direction}" FontSize="11" Classes="bold"
                                                       Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"/>
                                            <TextBlock Text=" | " FontSize="11" Margin="2,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding MsgTypeName}" FontSize="11" 
                                                       Foreground="{DynamicResource IconTealBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Length, StringFormat='{}{0} bytes'}" FontSize="10" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DeviceId, StringFormat=' | {0}'}" FontSize="10" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding DeviceId, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Message Tree and Raw Data -->
            <Grid Grid.Column="2" RowDefinitions="*,12,*">
                <!-- Message Tree -->
                <Border Grid.Row="0" Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SubtleOverlayBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Sitemap" Width="14" Height="14" Margin="0,0,8,0" 
                                                           Foreground="{DynamicResource IconInfoBrush}"/>
                                <TextBlock Text="{DynamicResource LLRPMessage.MessageTree}" 
                                           Classes="semiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <TreeView Grid.Row="1" ItemsSource="{Binding MessageTree}" BorderThickness="0"
                                  Background="{DynamicResource SurfaceBrush}" Margin="0">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <TextBlock Text="{Binding Name}" Classes="semiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text=": " Margin="0,0,4,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   IsVisible="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Value}"
                                                   Foreground="{DynamicResource IconTealBrush}"
                                                   IsVisible="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text=" - " Margin="2,0,4,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Description}" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Raw Hex Data -->
                <Border Grid.Row="2" Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SubtleOverlayBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="Code" Width="14" Height="14" Margin="0,0,8,0" 
                                                           Foreground="{DynamicResource IconInfoBrush}"/>
                                <TextBlock Text="{DynamicResource LLRPMessage.RawHexData}" 
                                           Classes="semiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1">
                            <TextBox Text="{Binding RawHexString, Mode=OneWay}" Padding="8"
                                     AcceptsReturn="True" IsReadOnly="True" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" 
                                     Background="{DynamicResource SurfaceBrush}"
                                     TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
