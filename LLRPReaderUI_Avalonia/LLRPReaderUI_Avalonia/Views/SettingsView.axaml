<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="16">
        <Border Background="White" CornerRadius="8" Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Text="Application Settings" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Configure reader connection and application preferences" Foreground="#666" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
