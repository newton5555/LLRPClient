<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="LLRPReaderUI_Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="*,16,Auto,32">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12">
                <!-- Keepalive Configuration -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="HeartPulse" Width="16" Height="16" 
                                                       Foreground="{DynamicResource IconDangerBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.KeepaliveConfig}" 
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,8,Auto" Margin="8,0,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.EnableKeepalive}" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableKeepalive}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.KeepaliveInterval}" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeepaliveIntervalMs}" 
                                     Height="30" Width="200" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RF Inventory Configuration -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Tune" Width="16" Height="16" 
                                                       Foreground="{DynamicResource IconPurpleBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.RfInventoryConfig}" 
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto" Margin="8,0,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.RfMode}" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding RfModeOptions}"
                                      SelectedItem="{Binding SelectedRfModeOption}" Height="30" Width="300" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RfModeOptionItem">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.Session}" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Session}" 
                                           Minimum="0" Maximum="3" Height="30" Width="100" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Settings.TagPopulationEstimate}" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TagPopulationEstimate}" 
                                     Height="30"  HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Settings.HoldEventsOnReconnect}" 
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding HoldEventsAndReportsUponReconnect}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Antenna Configuration -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Antenna" Width="16" Height="16" 
                                                       Foreground="{DynamicResource IconTealBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.AntennaConfig}" 
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="140,90,200,200" Margin="8,0,0,8">
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Port}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Enable}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Settings.TxPower}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Settings.RxSensitivity}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Antennas}" Margin="8,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:AntennaItemViewModel">
                                    <Grid ColumnDefinitions="140,90,200,200" Margin="0,0,0,8">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="{DynamicResource Inventory.Antenna}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding PortNumber}"/>
                                        </TextBlock>
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"/>
                                        <ComboBox Grid.Column="2" Height="28" Width="180" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding $parent[UserControl].DataContext.TxPowerOptions}"
                                                  SelectedItem="{Binding TxPowerInDbm}"/>
                                        <ComboBox Grid.Column="3" Height="28" Width="180" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding $parent[UserControl].DataContext.RxSensitivityOptions}"
                                                  SelectedItem="{Binding RxSensitivityInDbm}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Reader Events -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ListBox" Width="16" Height="16" 
                                                       Foreground="{DynamicResource IconInfoBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.ReaderEvents}" 
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ReaderEventNotifications}" Margin="8,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,4"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Height="32" Width="120" Command="{Binding QueryDeviceSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" Margin="0,0,6,0" 
                                               Foreground="{DynamicResource IconInfoBrush}"/>
                    <TextBlock Text="{DynamicResource Settings.Query}"/>
                </StackPanel>
            </Button>
            <Button Height="32" Width="120" Command="{Binding SaveSettingsCommand}" Classes="primary">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,6,0" 
                                               Foreground="{DynamicResource IconSuccessBrush}"/>
                    <TextBlock Text="{DynamicResource Settings.Save}"/>
                </StackPanel>
            </Button>
            <Button Height="32" Width="120" Command="{Binding ResetFactoryDefaultsCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Restore" Width="14" Height="14" Margin="0,0,6,0" 
                                               Foreground="{DynamicResource IconWarningBrush}"/>
                    <TextBlock Text="{DynamicResource Settings.ResetFactory}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding SaveResult}" 
                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
