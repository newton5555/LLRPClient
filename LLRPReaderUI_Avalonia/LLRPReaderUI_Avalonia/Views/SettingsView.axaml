<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="900"
             x:Class="LLRPReaderUI_Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="*,16,Auto,32">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Cog" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.SystemManagement}" Classes="semiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="220,420" RowDefinitions="Auto,8,Auto">
                            <TextBlock Text="{DynamicResource Settings.EnableKeepalive}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EnableKeepalive}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.KeepaliveInterval}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeepaliveIntervalMs}" Height="36"/>
                        </Grid>
                        <Separator/>
                        <TextBlock Text="{DynamicResource Settings.ReaderEvents}" Classes="semiBold"/>
                        <ItemsControl ItemsSource="{Binding ReaderEventNotifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Waveform" Width="16" Height="16" Foreground="{DynamicResource IconVioletBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.RadioPhy}" Classes="semiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="220,420,*" RowDefinitions="Auto,8,Auto,8,Auto">
                            <TextBlock Text="{DynamicResource Settings.RfMode}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RfModeOptions}" SelectedItem="{Binding SelectedRfModeOption}" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="vm:RfModeOptionItem">
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.HopTableId}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="80,*">
                                <ComboBox ItemsSource="{Binding HopTableOptions}" SelectedItem="{Binding HopTableId}" Height="36"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedHopTableFrequencies}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="4" Text="{DynamicResource Settings.ChannelIndex}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="80,*">
                                <TextBox Text="{Binding ChannelIndex}" Height="36"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedChannelFrequency}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="16" Height="16" Foreground="{DynamicResource IconAccentBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.InventoryProtocol}" Classes="semiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="220,420,*" RowDefinitions="Auto,8,Auto">
                            <TextBlock Text="{DynamicResource Settings.Session}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding Session}" Height="36">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.TagPopulationEstimate}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TagPopulationEstimate}" Height="36"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Settings.TagPopulationEstimateHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Memory" Width="16" Height="16" Foreground="{DynamicResource IconWarningBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.AdvancedFeatures}" Classes="semiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="220,420" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                            <TextBlock Text="{DynamicResource Settings.InventoryStateAware}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding InventoryStateAware}" IsEnabled="{Binding IsStateAwareSupported}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.InventoryTarget}" IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding InventoryTargetOptions}" SelectedItem="{Binding InventoryTarget}" IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}" Height="36"/>
                            <TextBlock Grid.Row="4" Text="{DynamicResource Settings.InventorySearchMode}" IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding InventorySearchModeOptions}" SelectedItem="{Binding InventorySearchMode}" IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}" Height="36"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Settings.StateAwareUnsupportedHint}" IsVisible="{Binding !IsStateAwareSupported}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Memory" Width="16" Height="16" Foreground="{DynamicResource IconTealBrush}"/>
                            <TextBlock Text="{DynamicResource Menu.GPIO}" Classes="semiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,20,*">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource GPIO.GpiConfig}" Classes="semiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="70,70,*" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource GPIO.Port}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.Enable}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Gpis}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GpiPortItemViewModel">
                                            <Grid ColumnDefinitions="70,70,*" Margin="0,2">
                                                <TextBlock Text="{Binding PortNumber, StringFormat='GPI {0}'}" FontSize="12" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CurrentStateText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Separator Grid.Column="1" Margin="8,0"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource GPIO.GpoOutput}" Classes="semiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="70,90,*" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource GPIO.Port}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.OutputHigh}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Gpos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:GpoPortItemViewModel">
                                            <Grid ColumnDefinitions="70,90,*" Margin="0,2">
                                                <TextBlock Text="{Binding PortNumber, StringFormat='GPO {0}'}" FontSize="12" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding DesiredState}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CurrentStateText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,10,0,0" Command="{Binding ApplyGpoStatesCommand}" Classes="flat" MinWidth="132">
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon Kind="Send" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource GPIO.ApplyGpo}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Antenna" Width="16" Height="16" Foreground="{DynamicResource IconTealBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.AntennaConfig}" Classes="semiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,84,*,*" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Settings.Port}" Classes="semiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Enable}" Classes="semiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Settings.TxPower}" Classes="semiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Settings.RxSensitivity}" Classes="semiBold" VerticalAlignment="Center" IsVisible="{Binding IsRxSensitivityVisible}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Antennas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:AntennaItemViewModel">
                                    <Grid ColumnDefinitions="*,84,*,*" Margin="0,0,0,8">
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{DynamicResource Inventory.Antenna}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding PortNumber}"/>
                                        </TextBlock>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].DataContext.TxPowerOptions}" SelectedItem="{Binding TxPowerInDbm}" Height="36"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding $parent[UserControl].DataContext.RxSensitivityOptions}" SelectedItem="{Binding RxSensitivityInDbm}" IsVisible="{Binding $parent[UserControl].DataContext.IsRxSensitivityVisible}" Height="36"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button MinWidth="132" Command="{Binding QueryDeviceSettingsCommand}" Classes="flat">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Settings.Query}"/>
                </StackPanel>
            </Button>
            <Button MinWidth="132" Command="{Binding SaveSettingsCommand}" Classes="primary">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Settings.Save}"/>
                </StackPanel>
            </Button>
            <Button MinWidth="132" Command="{Binding QueryStatusCommand}" Classes="flat">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Information" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Settings.QueryStatus}"/>
                </StackPanel>
            </Button>
            <Button MinWidth="132" Command="{Binding ResetFactoryDefaultsCommand}" Classes="flat">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Restore" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Settings.ResetFactory}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding SaveResult}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
