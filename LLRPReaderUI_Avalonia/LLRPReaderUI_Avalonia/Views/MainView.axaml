<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             xmlns:models="clr-namespace:LLRPReaderUI_Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:LLRPReaderUI_Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="LLRPReaderUI_Avalonia.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Navigation Item Style -->
        <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ Border#BackgroundModifier">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ Border#BackgroundModifier">
            <Setter Property="Background" Value="{DynamicResource SelectedOverlayBrush}" />
        </Style>

        <!-- Settings Button Style -->
        <Style Selector="Button.settingsBtn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.settingsBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
        </Style>

        <!-- Status Chip Base Style -->
        <Style Selector="Border.statusChip">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Main Content -->
        <Grid Grid.Row="0" Margin="18" ColumnDefinitions="278,16,*">

            <!-- Navigation Panel -->
            <Border Grid.Column="0" Classes="card" CornerRadius="24" Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Border Grid.Row="0" Padding="16" Margin="0,0,0,12"
                            Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="18">
                        <Grid>
                        <TextBlock Text="{DynamicResource Menu.Navigation}" FontSize="20" Classes="semiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <Button Classes="settingsBtn"
                                    Command="{Binding ThemeLanguageViewModel.ToggleThemeCommand}"
                                    ToolTip.Tip="{Binding ThemeLanguageViewModel.ThemeToolTip}">
                                <materialIcons:MaterialIcon Kind="{Binding ThemeLanguageViewModel.ThemeIcon}"
                                                           Width="20" Height="20"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Button>
                            <Button Classes="settingsBtn"
                                    Command="{Binding ThemeLanguageViewModel.ToggleLanguageCommand}"
                                    ToolTip.Tip="{DynamicResource Language.Toggle}">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="{Binding ThemeLanguageViewModel.LanguageIcon}"
                                                               Width="20" Height="20"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding ThemeLanguageViewModel.LanguageSymbol}"
                                               FontSize="8" Classes="bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Foreground="#60A5FA" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}"
                              SelectedItem="{Binding SelectedNavigationItem}"
                              Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:NavigationItem">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                               Width="22" Height="22"
                                                               Foreground="{Binding IconBrush}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="2" Classes="card" CornerRadius="24">
                <ContentControl Content="{Binding CurrentPageViewModel}" />
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Margin="18,0,18,18" Padding="10,8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="20">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Device Status Chip - Dynamic based on IsDeviceConnected -->
                <Border Padding="10,4" CornerRadius="10">
                    <Border.Background>
                        <MultiBinding Converter="{x:Static converters:DeviceStatusConverter.Instance}">
                            <Binding Path="IsDeviceConnected"/>
                        </MultiBinding>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{x:Static converters:DeviceStatusDotConverter.Instance}">
                                    <Binding Path="IsDeviceConnected"/>
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding DeviceStatusText}" FontSize="12" Classes="semiBold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{x:Static converters:DeviceStatusTextConverter.Instance}">
                                    <Binding Path="IsDeviceConnected"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Inventory Status Chip - Dynamic based on IsInventoryRunning -->
                <Border Padding="10,4" CornerRadius="10">
                    <Border.Background>
                        <MultiBinding Converter="{x:Static converters:InventoryStatusConverter.Instance}">
                            <Binding Path="IsInventoryRunning"/>
                        </MultiBinding>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{x:Static converters:InventoryStatusDotConverter.Instance}">
                                    <Binding Path="IsInventoryRunning"/>
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding InventoryStatusText}" FontSize="12" Classes="semiBold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{x:Static converters:InventoryStatusTextConverter.Instance}">
                                    <Binding Path="IsInventoryRunning"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Other Status Chips -->
                <Border Classes="statusChip">
                    <TextBlock Text="{Binding AntennaStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Classes="statusChip">
                    <TextBlock Text="{Binding GpiStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Classes="statusChip">
                    <TextBlock Text="{Binding GpoStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Classes="statusChip" Margin="0">
                    <TextBlock Text="{Binding IdentificationStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Global Modal Overlay -->
        <Panel Grid.RowSpan="2"
               ZIndex="100"
               Background="{DynamicResource ModalOverlayBrush}"
               IsHitTestVisible="{Binding IsGlobalBusy}"
               IsVisible="{Binding IsGlobalBusy}">
            <Border Width="420"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                    <ProgressBar Width="360" Height="14" IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Classes="semiBold"
                               Foreground="{DynamicResource StatusDefaultTextBrush}"
                               Text="{Binding BusyText}" />
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
