<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             xmlns:models="clr-namespace:LLRPReaderUI_Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:LLRPReaderUI_Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="LLRPReaderUI_Avalonia.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource WindowBackgroundGradientBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Navigation Item Style -->
        <Style Selector="ListBoxItem">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ Border#BackgroundModifier">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NavigationItemHoverBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ Border#BackgroundModifier">
            <Setter Property="Background" Value="{DynamicResource SelectedOverlayBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NavigationItemSelectedBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Settings Button Style -->
        <Style Selector="Button.settingsBtn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Button.settingsBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavigationButtonHoverBrush}" />
        </Style>

        <Style Selector="Border.busyDialog">
            <Setter Property="MinWidth" Value="340" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}" />
            <Setter Property="BoxShadow" Value="{DynamicResource BusyDialogShadow}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.busyIconShell">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="{DynamicResource InputRadius}" />
            <Setter Property="Background" Value="{DynamicResource BusyDialogAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="Transparent">
        <!-- Glass overlay -->
        <Border Grid.RowSpan="2"
                Background="{DynamicResource WindowGlassOverlayBrush}"
                IsHitTestVisible="False" />

        <!-- Main Content -->
        <Grid Grid.Row="0" Margin="18" ColumnDefinitions="278,16,*">

            <!-- Navigation Panel -->
            <Border Grid.Column="0" CornerRadius="{DynamicResource ShellRadius}" Padding="14"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    BorderBrush="{DynamicResource NavigationOuterBorderBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Border Grid.Row="0" Padding="16" Margin="0,0,0,12"
                            Background="{DynamicResource NavigationHeaderBrush}" CornerRadius="{DynamicResource PanelRadius}">
                        <Grid>
                        <TextBlock Text="{DynamicResource Menu.Navigation}" FontSize="20" Classes="semiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource NavigationForegroundBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <Button Classes="settingsBtn"
                                    Command="{Binding ThemeLanguageViewModel.ToggleThemeCommand}"
                                    ToolTip.Tip="{Binding ThemeLanguageViewModel.ThemeToolTip}">
                                <materialIcons:MaterialIcon Kind="{Binding ThemeLanguageViewModel.ThemeIcon}"
                                                           Width="20" Height="20"
                                                           Foreground="{DynamicResource NavigationHeaderIconBrush}" />
                            </Button>
                            <Button Classes="settingsBtn"
                                    Command="{Binding ThemeLanguageViewModel.ToggleLanguageCommand}"
                                    ToolTip.Tip="{DynamicResource Language.Toggle}">
                                <Grid>
                                    <materialIcons:MaterialIcon Kind="{Binding ThemeLanguageViewModel.LanguageIcon}"
                                                               Width="20" Height="20"
                                                               Foreground="{DynamicResource NavigationHeaderIconBrush}" />
                                    <TextBlock Text="{Binding ThemeLanguageViewModel.LanguageSymbol}"
                                               FontSize="8" Classes="bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource NavigationHeaderAccentBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}"
                              SelectedItem="{Binding SelectedNavigationItem}"
                              Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:NavigationItem">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                               Width="22" Height="22"
                                                               Foreground="{Binding IconBrush}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource NavigationForegroundBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="2" Classes="card" CornerRadius="{DynamicResource ShellRadius}">
                <ContentControl Content="{Binding CurrentPageViewModel}" />
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Margin="18,0,18,18" Padding="10,8"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellRadius}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Device Status Chip -->
                <Border Classes="statusChip primaryStatus">
                    <Border.Background>
                        <MultiBinding Converter="{x:Static converters:DeviceStatusConverter.Instance}">
                            <Binding Path="IsDeviceConnected"/>
                        </MultiBinding>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{x:Static converters:DeviceStatusDotConverter.Instance}">
                                    <Binding Path="IsDeviceConnected"/>
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding DeviceStatusText}" FontSize="12" Classes="semiBold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{x:Static converters:DeviceStatusTextConverter.Instance}">
                                    <Binding Path="IsDeviceConnected"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Inventory Status Chip -->
                <Border Classes="statusChip primaryStatus">
                    <Border.Background>
                        <MultiBinding Converter="{x:Static converters:InventoryStatusConverter.Instance}">
                            <Binding Path="IsInventoryRunning"/>
                        </MultiBinding>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <MultiBinding Converter="{x:Static converters:InventoryStatusDotConverter.Instance}">
                                    <Binding Path="IsInventoryRunning"/>
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding InventoryStatusText}" FontSize="12" Classes="semiBold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{x:Static converters:InventoryStatusTextConverter.Instance}">
                                    <Binding Path="IsInventoryRunning"/>
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Other Status Chips -->
                <Border Classes="statusChip">
                    <TextBlock Text="{Binding AntennaStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Classes="statusChip">
                    <TextBlock Text="{Binding GpiStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Classes="statusChip">
                    <TextBlock Text="{Binding GpoStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <Border Classes="statusChip wideStatus" Margin="0">
                    <TextBlock Text="{Binding IdentificationStatusText}" FontSize="12"
                               Foreground="{DynamicResource StatusDefaultTextBrush}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Global Modal Overlay -->
        <Panel Grid.RowSpan="2"
               ZIndex="100"
               Background="{DynamicResource ModalOverlayBrush}"
               IsHitTestVisible="{Binding IsGlobalBusy}"
               IsVisible="{Binding IsGlobalBusy}">
            <Border Classes="busyDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid Margin="20,18"
                      RowDefinitions="Auto,16,Auto"
                      ColumnDefinitions="Auto,16,*">
                    <Border Classes="busyIconShell">
                        <materialIcons:MaterialIcon Kind="Sync"
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{DynamicResource Common.Executing}"
                                   FontSize="15"
                                   Classes="semiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding BusyText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StatusDefaultTextBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2" />
                    </StackPanel>

                    <ProgressBar Grid.Row="2"
                                 Grid.ColumnSpan="3"
                                 Height="5"
                                 HorizontalAlignment="Stretch"
                                 IsIndeterminate="True" />
                </Grid>
            </Border>
        </Panel>
    </Grid>
</UserControl>
