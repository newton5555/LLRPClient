<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.DeviceConnectionView"
             x:DataType="vm:DeviceConnectionViewModel">

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,12,*">
        <!-- Connection Bar -->
        <Border Grid.Row="0" Classes="card">
            <Grid ColumnDefinitions="*,10,Auto,10,Auto,10,Auto">
                <TextBox Grid.Column="0" Height="36"
                         Text="{Binding ReaderEndpoint}"
                         Watermark="Enter reader address (e.g., 192.168.1.100)" />

                <Button Grid.Column="2" Height="36" Classes="primary"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding !IsConnected}">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Plug" Width="16" Height="16" Margin="0,0,8,0"
                                                   Foreground="White" />
                        <TextBlock Text="{DynamicResource DeviceConnection.Connect}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Height="36" Classes="flat"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected}">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="PowerPlugOff" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource DeviceConnection.Disconnect}" />
                    </StackPanel>
                </Button>

                <!-- Connection State Hint -->
                <TextBlock Grid.Column="6" Classes="statusHint" Text="{Binding ConnectionState}" />
            </Grid>
        </Border>

        <!-- Feature Set DataGrid -->
        <Border Grid.Row="2" Classes="card">
            <DataGrid ItemsSource="{Binding FeatureSetItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
