<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             xmlns:converters="clr-namespace:LLRPReaderUI_Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,8,Auto,8,*">

        <!-- Toolbar -->
        <Border Grid.Row="0" Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
            <Grid RowDefinitions="Auto,12,Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Inventory.Start}" Classes="heading" />
                    <TextBlock Text="{Binding InventoryState}" Margin="0,4,0,0" Classes="body" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding StartInventoryCommand}" Classes="primary" MinWidth="128">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Inventory.Start}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopInventoryCommand}" Classes="flat" MinWidth="128">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Inventory.Stop}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ManualPullBufferedReportsCommand}" Classes="flat" MinWidth="136">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Inventory.PullBuffer}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearReceivedDataCommand}" Classes="flat" MinWidth="112">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Inventory.Clear}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <Border Grid.Row="2" Classes="card inventoryMetrics">
            <Grid ColumnDefinitions="*,1,*,1,*,1,*">
                <Border Classes="inventoryMetricCell">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Border Classes="inventoryMetricIcon">
                            <materialIcons:MaterialIcon Kind="ClipboardList" Width="18" Height="18"
                                                        Foreground="{DynamicResource IconInfoBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Text="{DynamicResource Inventory.TotalReports}" Classes="metricLabel" />
                            <TextBlock Text="{Binding TotalReports}" Classes="metricValue" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Classes="inventoryMetricDivider" />

                <Border Grid.Column="2" Classes="inventoryMetricCell">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Border Classes="inventoryMetricIcon">
                            <materialIcons:MaterialIcon Kind="Poll" Width="18" Height="18"
                                                        Foreground="{DynamicResource IconAccentBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Text="{DynamicResource Inventory.TotalTags}" Classes="metricLabel" />
                            <TextBlock Text="{Binding TotalTags}" Classes="metricValue" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="3" Classes="inventoryMetricDivider" />

                <Border Grid.Column="4" Classes="inventoryMetricCell">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Border Classes="inventoryMetricIcon">
                            <materialIcons:MaterialIcon Kind="Filter" Width="18" Height="18"
                                                        Foreground="{DynamicResource IconSuccessBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Text="{DynamicResource Inventory.UniqueTags}" Classes="metricLabel" />
                            <TextBlock Text="{Binding UniqueTagCount}" Classes="metricValue" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="5" Classes="inventoryMetricDivider" />

                <Border Grid.Column="6" Classes="inventoryMetricCell">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Border Classes="inventoryMetricIcon">
                            <materialIcons:MaterialIcon Kind="Timer" Width="18" Height="18"
                                                        Foreground="{DynamicResource IconWarningBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                            <TextBlock Text="{DynamicResource Inventory.Duration}" Classes="metricLabel" />
                            <TextBlock Text="{Binding InventoryDuration}" Classes="metricValue" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="4" Classes="card" Background="{DynamicResource CardInnerBackgroundBrush}">
            <DataGrid x:Name="InventoryDataGrid"
                      ItemsSource="{Binding ReceivedTags}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended">
                
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Inventory.CopyEpc}" Click="CopyEpcMenuItem_OnClick" />
                        <MenuItem Header="{DynamicResource Inventory.CopyAttachedData}" Click="CopyAttachedDataMenuItem_OnClick" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Inventory.CopySelectedRows}" Click="CopySelectedRowsMenuItem_OnClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Inventory.ReceiveTime}" 
                                        Binding="{Binding ReceiveTime, StringFormat='MM/dd HH:mm:ss.fff'}" 
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource Inventory.EPC}" 
                                        Binding="{Binding Epc}" 
                                        Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Inventory.Antenna}" 
                                        Binding="{Binding Antenna}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowAntennaPortNumberColumn}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource Inventory.Frequency}" 
                                        Binding="{Binding ChannelMhz}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowChannelColumn}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource Inventory.RSSI}" 
                                        Binding="{Binding Rssi}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowPeakRssiColumn}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource Inventory.Count}" 
                                        Binding="{Binding SeenCount}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowSeenCountColumn}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="PC" 
                                        Binding="{Binding Pc}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowPcColumn}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="CRC" 
                                        Binding="{Binding Crc}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowCrcColumn}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="FirstTimestamp" 
                                        Binding="{Binding FirstSeenTimestampUtc}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowFirstSeenTimestampUtcColumn}"
                                        Width="180" />
                    <DataGridTextColumn Header="LastTimestamp" 
                                        Binding="{Binding LastSeenTimestampUtc}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.ShowLastSeenTimestampUtcColumn}"
                                        Width="180" />
                    <DataGridTextColumn Header="{DynamicResource Inventory.AttachedData}" 
                                        Binding="{Binding AttachedData}" 
                                        IsVisible="{Binding #InventoryDataGrid.DataContext.AttachedDataEnabled}"
                                        Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
