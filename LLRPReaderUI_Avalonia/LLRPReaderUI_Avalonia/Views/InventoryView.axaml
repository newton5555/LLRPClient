<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:LLRPReaderUI_Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LLRPReaderUI_Avalonia.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <Grid Margin="16" RowDefinitions="Auto,8,Auto,8,*">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding StartInventoryCommand}" Classes="accent" Height="32">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Start" />
                </StackPanel>
            </Button>
            <Button Command="{Binding StopInventoryCommand}" Height="32">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ManualPullBufferedReportsCommand}" Height="32">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Pull Buffer" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearReceivedDataCommand}" Height="32">
                <StackPanel Orientation="Horizontal">
                    <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding InventoryState}" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="#1976D2" />
        </StackPanel>

        <!-- Stats -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <TextBlock>
                <Run Text="Reports:" /> <Run Text="{Binding TotalReports}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock>
                <Run Text="Total Tags:" /> <Run Text="{Binding TotalTags}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock>
                <Run Text="Unique:" /> <Run Text="{Binding UniqueTagCount}" FontWeight="Bold" />
            </TextBlock>
        </StackPanel>

        <!-- Data Grid -->
        <Border Grid.Row="4" Background="White" CornerRadius="8">
            <DataGrid ItemsSource="{Binding ReceivedTags}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding ReceiveTime, StringFormat='MM/dd HH:mm:ss.fff'}" Width="160" />
                    <DataGridTextColumn Header="EPC" Binding="{Binding Epc}" Width="*" />
                    <DataGridTextColumn Header="Ant" Binding="{Binding Antenna}" Width="60" />
                    <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="80" />
                    <DataGridTextColumn Header="Count" Binding="{Binding SeenCount}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
