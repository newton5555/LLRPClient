<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- 语言资源标记 -->
    <sys:Boolean x:Key="__LanguageResource__">True</sys:Boolean>

    <!-- App Title -->
    <sys:String x:Key="App.Title">LLRP 读写器</sys:String>

    <!-- Navigation Menu -->
    <sys:String x:Key="Menu.Navigation">功能导航</sys:String>
    <sys:String x:Key="Menu.DeviceConnection">设备连接</sys:String>
    <sys:String x:Key="Menu.Settings">参数配置</sys:String>
    <sys:String x:Key="Menu.GPIO">GPIO 配置</sys:String>
    <sys:String x:Key="Menu.InventoryConfig">盘点配置</sys:String>
    <sys:String x:Key="Menu.Inventory">盘点操作</sys:String>
    <sys:String x:Key="Menu.ReadWrite">读写操作</sys:String>
    <sys:String x:Key="Menu.AdvancedTagOps">高级标签操作</sys:String>
    <sys:String x:Key="Menu.Log">日志</sys:String>
    <sys:String x:Key="Menu.LLRPMessage">历史LLRP消息</sys:String>

    <!-- Device Connection -->
    <sys:String x:Key="DeviceConnection.Title">设备连接</sys:String>
    <sys:String x:Key="DeviceConnection.Address">地址</sys:String>
    <sys:String x:Key="DeviceConnection.Connect">连接</sys:String>
