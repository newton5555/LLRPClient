<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- 语言资源标记 -->
    <sys:Boolean x:Key="__LanguageResource__">True</sys:Boolean>

    <!-- App Title -->
    <sys:String x:Key="App.Title">LLRP 读写器</sys:String>

    <!-- Navigation Menu -->
    <sys:String x:Key="Menu.Navigation">功能导航</sys:String>
    <sys:String x:Key="Menu.DeviceConnection">设备连接</sys:String>
    <sys:String x:Key="Menu.Settings">参数配置</sys:String>
    <sys:String x:Key="Menu.GPIO">GPIO 配置</sys:String>
    <sys:String x:Key="Menu.InventoryConfig">盘点配置</sys:String>
    <sys:String x:Key="Menu.Inventory">盘点操作</sys:String>
    <sys:String x:Key="Menu.ReadWrite">读写操作</sys:String>
    <sys:String x:Key="Menu.AdvancedTagOps">高级标签操作</sys:String>
    <sys:String x:Key="Menu.Log">日志</sys:String>
    <sys:String x:Key="Menu.LLRPMessage">历史LLRP消息</sys:String>

    <!-- Device Connection -->
    <sys:String x:Key="DeviceConnection.Connect">连接</sys:String>
    <sys:String x:Key="DeviceConnection.Disconnect">断开</sys:String>

    <!-- Status -->
    <sys:String x:Key="Status.Device">设备</sys:String>
    <sys:String x:Key="Status.Inventory">盘点</sys:String>
    <sys:String x:Key="Status.Connected">已连接</sys:String>
    <sys:String x:Key="Status.NotConnected">未连接</sys:String>
    <sys:String x:Key="Status.Running">运行中</sys:String>
    <sys:String x:Key="Status.Idle">空闲</sys:String>
    <sys:String x:Key="Status.Unknown">未知</sys:String>
    <sys:String x:Key="Status.GPI">GPI</sys:String>
    <sys:String x:Key="Status.GPO">GPO</sys:String>
    <sys:String x:Key="Status.MAC">MAC</sys:String>
    <sys:String x:Key="Status.High">高</sys:String>
    <sys:String x:Key="Status.Low">低</sys:String>
    <sys:String x:Key="Status.NoData">无数据</sys:String>
    <sys:String x:Key="Status.NoResponse">设备未返回</sys:String>

    <!-- Theme & Language -->
    <sys:String x:Key="Theme.ToggleLight">切换到亮色主题</sys:String>
    <sys:String x:Key="Theme.ToggleDark">切换到暗色主题</sys:String>
    <sys:String x:Key="Language.Toggle">切换语言</sys:String>

    <!-- Common -->
    <sys:String x:Key="Common.All">全部</sys:String>
    <sys:String x:Key="Common.ConnectFirst">请先连接设备</sys:String>

    <!-- Inventory -->
    <sys:String x:Key="Inventory.Start">开始寻卡</sys:String>
    <sys:String x:Key="Inventory.Stop">停止寻卡</sys:String>
    <sys:String x:Key="Inventory.Clear">清空数据</sys:String>
    <sys:String x:Key="Inventory.PullBuffer">手动拉缓存</sys:String>
    <sys:String x:Key="Inventory.Antenna">天线</sys:String>

    <!-- MainWindow -->
    <sys:String x:Key="MainWindow.DeviceNotConnected">设备: 未连接</sys:String>
    <sys:String x:Key="MainWindow.InventoryUnknown">盘点: 未知</sys:String>
    <sys:String x:Key="MainWindow.AntennaDefault">天线: --</sys:String>
    <sys:String x:Key="MainWindow.GPIDefault">GPI: --</sys:String>
    <sys:String x:Key="MainWindow.GPODefault">GPO: --</sys:String>
    <sys:String x:Key="MainWindow.MACDefault">MAC: --</sys:String>

    <!-- GPIO -->
    <sys:String x:Key="GPIO.High">高</sys:String>
    <sys:String x:Key="GPIO.Low">低</sys:String>

    <!-- ReadWrite -->
    <sys:String x:Key="ReadWrite.Ready">就绪</sys:String>
    <sys:String x:Key="ReadWrite.Waiting">等待操作...</sys:String>
    <sys:String x:Key="ReadWrite.Reading">正在读取...</sys:String>
    <sys:String x:Key="ReadWrite.Writing">正在写入...</sys:String>

</ResourceDictionary>
