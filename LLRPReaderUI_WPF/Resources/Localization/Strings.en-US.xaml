<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- App Title -->
    <sys:String x:Key="App.Title">LLRP Reader UI</sys:String>

    <!-- Navigation Menu -->
    <sys:String x:Key="Menu.DeviceConnection">Device Connection</sys:String>
    <sys:String x:Key="Menu.Settings">Settings</sys:String>
    <sys:String x:Key="Menu.GPIO">GPIO Config</sys:String>
    <sys:String x:Key="Menu.InventoryConfig">Inventory Config</sys:String>
    <sys:String x:Key="Menu.Inventory">Inventory</sys:String>
    <sys:String x:Key="Menu.ReadWrite">Read/Write</sys:String>
    <sys:String x:Key="Menu.AdvancedTagOps">Advanced Tag Ops</sys:String>
    <sys:String x:Key="Menu.Log">Log</sys:String>
    <sys:String x:Key="Menu.LLRPMessage">LLRP Messages</sys:String>

    <!-- Device Connection -->
    <sys:String x:Key="DeviceConnection.Title">Device Connection</sys:String>
    <sys:String x:Key="DeviceConnection.Address">Address</sys:String>
    <sys:String x:Key="DeviceConnection.Connect">Connect</sys:String>
    <sys:String x:Key="DeviceConnection.Disconnect">Disconnect</sys:String>
    <sys:String x:Key="DeviceConnection.Connecting">Connecting...</sys:String>
    <sys:String x:Key="DeviceConnection.Connected">Connected</sys:String>
    <sys:String x:Key="DeviceConnection.Disconnected">Disconnected</sys:String>
    <sys:String x:Key="DeviceConnection.ConnectionFailed">Connection failed</sys:String>
    <sys:String x:Key="DeviceConnection.KeepaliveMonitor">Connection Monitor</sys:String>
    <sys:String x:Key="DeviceConnection.KeepaliveMonitorTip">Auto-detect disconnection</sys:String>

    <!-- Status -->
    <sys:String x:Key="Status.Device">Device</sys:String>
    <sys:String x:Key="Status.Inventory">Inventory</sys:String>
    <sys:String x:Key="Status.GPI">GPI</sys:String>
    <sys:String x:Key="Status.GPO">GPO</sys:String>
    <sys:String x:Key="Status.MAC">MAC</sys:String>
    <sys:String x:Key="Status.Unknown">Unknown</sys:String>
    <sys:String x:Key="Status.NotConnected">Not connected</sys:String>
    <sys:String x:Key="Status.Running">Running</sys:String>
    <sys:String x:Key="Status.Idle">Idle</sys:String>
    <sys:String x:Key="Status.NoData">No data</sys:String>

    <!-- Inventory -->
    <sys:String x:Key="Inventory.Start">Start</sys:String>
    <sys:String x:Key="Inventory.Stop">Stop</sys:String>
    <sys:String x:Key="Inventory.Clear">Clear</sys:String>
    <sys:String x:Key="Inventory.Running">Running</sys:String>
    <sys:String x:Key="Inventory.Stopped">Stopped</sys:String>
    <sys:String x:Key="Inventory.TotalReports">Total Reports</sys:String>
    <sys:String x:Key="Inventory.TotalTags">Total Tags</sys:String>
    <sys:String x:Key="Inventory.UniqueTags">Unique Tags</sys:String>
    <sys:String x:Key="Inventory.EPC">EPC</sys:String>
    <sys:String x:Key="Inventory.Antenna">Antenna</sys:String>
    <sys:String x:Key="Inventory.RSSI">RSSI</sys:String>
    <sys:String x:Key="Inventory.Count">Count</sys:String>
    <sys:String x:Key="Inventory.Time">Time</sys:String>
    <sys:String x:Key="Inventory.ConnectFirst">Please connect device first</sys:String>

    <!-- Settings -->
    <sys:String x:Key="Settings.Title">Settings</sys:String>
    <sys:String x:Key="Settings.Save">Save</sys:String>
    <sys:String x:Key="Settings.Query">Query</sys:String>
    <sys:String x:Key="Settings.Saved">Settings saved</sys:String>
    <sys:String x:Key="Settings.SaveFailed">Save failed</sys:String>

    <!-- Actions -->
    <sys:String x:Key="Action.Save">Save</sys:String>
    <sys:String x:Key="Action.Cancel">Cancel</sys:String>
    <sys:String x:Key="Action.Refresh">Refresh</sys:String>
    <sys:String x:Key="Action.Clear">Clear</sys:String>
    <sys:String x:Key="Action.Start">Start</sys:String>
    <sys:String x:Key="Action.Stop">Stop</sys:String>
    <sys:String x:Key="Action.Connect">Connect</sys:String>
    <sys:String x:Key="Action.Disconnect">Disconnect</sys:String>

    <!-- Theme & Language -->
    <sys:String x:Key="Theme.Light">Light</sys:String>
    <sys:String x:Key="Theme.Dark">Dark</sys:String>
    <sys:String x:Key="Language.EnUS">English</sys:String>
    <sys:String x:Key="Language.ZhCN">Chinese</sys:String>

    <!-- Error Messages -->
    <sys:String x:Key="Error.ConnectionFailed">Connection failed</sys:String>
    <sys:String x:Key="Error.NotConnected">Not connected to device</sys:String>
    <sys:String x:Key="Error.OperationFailed">Operation failed</sys:String>

</ResourceDictionary>
