<mah:MetroWindow
    x:Class="LLRPReaderUI_WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LLRPReaderUI_WPF.Models"
    xmlns:views="clr-namespace:LLRPReaderUI_WPF.Views"
    xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1200"
    Height="760"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
   
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <mah:MetroWindow.Resources>
        <Style x:Key="NavItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#14007ACC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#26007ACC" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#0D000000" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="DeviceStatusChipStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
            <Setter Property="Background" Value="#FEE2E2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                    <Setter Property="Background" Value="#DCFCE7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryStatusChipStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
            <Setter Property="Background" Value="#E2E8F0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInventoryRunning}" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DeviceStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Setter Property="Foreground" Value="#991B1B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                    <Setter Property="Foreground" Value="#166534" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Setter Property="Foreground" Value="#475569" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInventoryRunning}" Value="True">
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceStateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Fill" Value="#EF4444" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                    <Setter Property="Fill" Value="#22C55E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryStateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Fill" Value="#94A3B8" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInventoryRunning}" Value="True">
                    <Setter Property="Fill" Value="#3B82F6" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="InventoryPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:0.8" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.9" To="1.25" Duration="0:0:0.8" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.9" To="1.25" Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="InventoryPulseStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:DeviceConnectionViewModel}">
            <views:DeviceConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GpioViewModel}">
            <views:GpioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryConfigViewModel}">
            <views:InventoryConfigView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadWriteViewModel}">
            <views:ReadWriteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedTagOpsViewModel}">
            <views:AdvancedTagOpsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="6,6,6,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="功能导航" />

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource NavItemContainerStyle}"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NavigationItem}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="30"
                                        Height="30"
                                        Background="#0D000000"
                                        CornerRadius="15">
                                        <fa:IconBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding IconBrush}"
                                            Icon="{Binding Icon}"
                                            IconFont="Auto"
                                            TextAlignment="Center" />
                                    </Border>
                                    <Label
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding Title}"
                                        />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <ContentControl Content="{Binding CurrentPageViewModel}" />
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Height="42"
            Margin="0"
            Padding="8,4"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            BorderBrush="#12000000"
            BorderThickness="0,1,0,0">
            <StatusBar Background="Transparent" BorderThickness="0">
                <Border Style="{StaticResource DeviceStatusChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource DeviceStateDotStyle}" />
                        <TextBlock Style="{StaticResource DeviceStatusTextStyle}" Text="{Binding DeviceStatusText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InventoryStatusChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource InventoryStateDotStyle}" />
                        <TextBlock Style="{StaticResource InventoryStatusTextStyle}" Text="{Binding InventoryStatusText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusChipStyle}">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding AntennaStatusText}" />
                </Border>
                <Border Style="{StaticResource StatusChipStyle}">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding GpiStatusText}" />
                </Border>
                <Border Style="{StaticResource StatusChipStyle}">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding GpoStatusText}" />
                </Border>
                <Border Margin="0" Style="{StaticResource StatusChipStyle}">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding IdentificationStatusText}" />
                </Border>
            </StatusBar>
        </Border>
    </Grid>
</mah:MetroWindow>
