<mah:MetroWindow
    x:Class="LLRPReaderUI_WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LLRPReaderUI_WPF.Models"
    xmlns:views="clr-namespace:LLRPReaderUI_WPF.Views"
    xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    Title="{Binding WindowTitle}"
    Width="1200"
    Height="760"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    Icon="Assets/rfid-icon.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <mah:MetroWindow.Resources>
        <Style x:Key="NavItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#14007ACC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#26007ACC" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:DeviceConnectionViewModel}">
            <views:DeviceConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GpioViewModel}">
            <views:GpioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryConfigViewModel}">
            <views:InventoryConfigView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadWriteViewModel}">
            <views:ReadWriteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedTagOpsViewModel}">
            <views:AdvancedTagOpsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="6,6,6,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="功能导航" />

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource NavItemContainerStyle}"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NavigationItem}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" >
                                    <fa:IconBlock
                                       
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                        Icon="{Binding Icon}"
                                        IconFont="Auto"
                                        TextAlignment="Center" />
                                    <Label
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding Title}"
                                         />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <ContentControl Content="{Binding CurrentPageViewModel}" />
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Height="30"
            Margin="0"
            Padding="0"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <StatusBar>
                <TextBlock Margin="0,0,12,0" Text="{Binding DeviceStatusText}" />
                <TextBlock Margin="0,0,12,0" Text="{Binding InventoryStatusText}" />
                <TextBlock Margin="0,0,12,0" Text="{Binding TemperatureStatusText}" />
                <TextBlock Margin="0,0,12,0" Text="{Binding AntennaStatusText}" />
                <TextBlock Margin="0,0,12,0" Text="{Binding GpiStatusText}" />
                <TextBlock Margin="0,0,12,0" Text="{Binding GpoStatusText}" />
                <TextBlock Text="{Binding IdentificationStatusText}" />
            </StatusBar>
        </Border>
    </Grid>
</mah:MetroWindow>
