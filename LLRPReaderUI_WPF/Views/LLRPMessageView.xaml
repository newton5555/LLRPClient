<UserControl
    x:Class="LLRPReaderUI_WPF.Views.LLRPMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LLRPReaderUI_WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance vm:LLRPMessageViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:DirectionToBrushConverter x:Key="DirectionToBrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Border Padding="12" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Width="120"
                        Height="32"
                        Command="{Binding RefreshDataCommand}"
                        Style="{StaticResource FlatButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Refresh"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="120"
                        Height="32"
                        Margin="10,0,0,0"
                        Command="{Binding ClearAllDataCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Trash"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearAll}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="120"
                        Height="32"
                        Margin="10,0,0,0"
                        Command="{Binding ExportToTextCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="FileExport"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.ExportText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="{DynamicResource LLRPMessage.Total}" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding RawFrames.Count, Mode=OneWay}" />
                        <Run Text="{DynamicResource LLRPMessage.Records}" />
                    </TextBlock>
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="{DynamicResource LLRPMessage.Filtered}" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding FilteredFrames.Count, Mode=OneWay}" />
                        <Run Text="{DynamicResource LLRPMessage.Records}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    Style="{StaticResource StatusHintTextStyle}"
                    Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <!--  筛选栏  -->
        <Border
            Grid.Row="1"
            Padding="12"
            Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>




                <StackPanel Orientation="Horizontal">
                    <!--  开始日期  -->
                    <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{DynamicResource LLRPMessage.StartDate}" />
                        <DatePicker
                            Width="110"
                            Height="28"
                            VerticalContentAlignment="Center"
                            SelectedDate="{Binding FilterStartDate}" />
                    </StackPanel>

                    <!--  结束日期  -->
                    <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{DynamicResource LLRPMessage.EndDate}" />
                        <DatePicker
                            Width="110"
                            Height="28"
                            VerticalContentAlignment="Center"
                            SelectedDate="{Binding FilterEndDate}" />
                    </StackPanel>

                    <!--  方向  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{DynamicResource LLRPMessage.Direction}" />
                        <ComboBox
                            Width="110"
                            Height="28"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding DirectionOptions}"
                            SelectedItem="{Binding FilterDirection}" />
                    </StackPanel>

                    <!--  设备  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="3"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{DynamicResource LLRPMessage.Device}" />
                        <ComboBox
                            Width="110"
                            Height="28"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding DeviceIdOptions}"
                            SelectedItem="{Binding FilterDeviceId}" />
                    </StackPanel>


                    <!--  消息类型  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="4"
                        Margin="0,0,8,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{DynamicResource LLRPMessage.MessageType}" />
                        <ComboBox
                            Width="110"
                            Height="28"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding MsgTypeOptions}"
                            SelectedItem="{Binding FilterMsgType}" />
                    </StackPanel>
                </StackPanel>


                <!--  操作按钮  -->
                <StackPanel
                    Grid.Row="1"

                    Orientation="Horizontal">

                    <Button Height="28" Command="{Binding ApplyFilterCommand}" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="12"
                                Height="12"
                                Margin="0,0,4,0"
                                Icon="Filter"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.Filter}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Background="Transparent"
                        Height="28"
                        Margin="8,0,0,0"
                        Command="{Binding ClearFilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="12"
                                Height="12"
                                Margin="0,0,4,0"
                                Foreground="{StaticResource IconWarningBrush}"
                                Icon="Times"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearFilter}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  主内容区  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：原始帧列表  -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,8"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Text="{DynamicResource LLRPMessage.RawFrameList}" />
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Background="{DynamicResource MahApps.Brushes.Control.Background}"
                        BorderThickness="0"
                        ItemsSource="{Binding FilteredFrames}"
                        ScrollViewer.CanContentScroll="True"
                        SelectedItem="{Binding SelectedRawFrame}"
                        VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    Background="#0D000000"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                                            Text="{Binding LocalTimestamp, StringFormat='MM/dd HH:mm:ss'}" />
                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"
                                                Text="{Binding Direction}" />
                                            <TextBlock
                                                Margin="2,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource MahApps.Brushes.Text}"
                                                Text=" | " />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TreeMessageTypeBrush}"
                                                Text="{Binding MsgTypeName}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding Length, StringFormat='{}{0} bytes'}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding DeviceId, StringFormat=' | {0}'}"
                                                Visibility="{Binding DeviceId, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  右侧：消息树和原始数据  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  消息树  -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Foreground="{StaticResource IconInfoBrush}"
                                    Icon="Sitemap"
                                    IconFont="Auto" />
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                    Text="{DynamicResource LLRPMessage.MessageTree}" />
                            </StackPanel>
                        </Border>

                        <TreeView
                            Grid.Row="1"
                            Background="{DynamicResource MahApps.Brushes.Control.Background}"
                            BorderThickness="0"
                            ItemsSource="{Binding MessageTree}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Margin="2,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="2,0,4,0"
                                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                                            Text=": "
                                            Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            Foreground="{DynamicResource TreeValueBrush}"
                                            Text="{Binding Value}"
                                            Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="2,0,4,0"
                                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                                            Text=" - "
                                            Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            FontStyle="Italic"
                                            Foreground="{DynamicResource TreeDescriptionBrush}"
                                            Text="{Binding Description}"
                                            Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!--  原始十六进制数据  -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,8"
                            Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Foreground="{StaticResource IconInfoBrush}"
                                    Icon="Code"
                                    IconFont="Auto" />
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MahApps.Brushes.Text}"
                                    Text="{DynamicResource LLRPMessage.RawHexData}" />
                            </StackPanel>
                        </Border>

                        <TextBox
                            Grid.Row="1"
                            Padding="8"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas, Courier New"
                            FontSize="12"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            Text="{Binding RawHexString, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
