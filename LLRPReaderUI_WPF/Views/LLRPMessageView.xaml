<UserControl
    x:Class="LLRPReaderUI_WPF.Views.LLRPMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LLRPReaderUI_WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance vm:LLRPMessageViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:DirectionToBrushConverter x:Key="DirectionToBrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="CompactOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonOutline}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="InspectorHeaderBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource NavigationHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="18,18,0,0" />
        </Style>
        <Style x:Key="InspectorHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource GroupHeaderForegroundBrush}" />
        </Style>
        <Style x:Key="MetricChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Border Padding="16" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Grid.ColumnSpan="2">
                    <Button
                        Width="120"
                        Command="{Binding RefreshDataCommand}"
                        Style="{StaticResource FlatButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Refresh"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="120"
                        Margin="10,0,0,0"
                        Command="{Binding ClearAllDataCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Trash"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearAll}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="120"
                        Margin="10,0,0,0"
                        Command="{Binding ExportToTextCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="FileExport"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.ExportText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Orientation="Horizontal">
                    <Border Style="{StaticResource MetricChipStyle}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{DynamicResource LLRPMessage.Total}" />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding RawFrames.Count, Mode=OneWay}" />
                            <Run Text="{DynamicResource LLRPMessage.Records}" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource MetricChipStyle}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{DynamicResource LLRPMessage.Filtered}" />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding FilteredFrames.Count, Mode=OneWay}" />
                            <Run Text="{DynamicResource LLRPMessage.Records}" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource StatusHintTextStyle}"
                    Text="{Binding StatusText}" />
            </Grid>
        </Border>

        <!--  筛选栏  -->
        <Border
            Grid.Row="2"
            Padding="16"
            Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource HeadingText}" Text="{DynamicResource LLRPMessage.Filter}" />
                <WrapPanel Grid.Row="2">
                    <StackPanel Width="150" Margin="0,0,12,12">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{DynamicResource LLRPMessage.StartDate}" />
                        <DatePicker SelectedDate="{Binding FilterStartDate}"  VerticalContentAlignment="Center"   Height="{Binding ElementName=DirectionComboBox,Path=ActualHeight}"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,12">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{DynamicResource LLRPMessage.EndDate}" />
                        <DatePicker SelectedDate="{Binding FilterEndDate}" VerticalContentAlignment="Center"   Height="{Binding ElementName=DirectionComboBox,Path=ActualHeight}"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,12">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{DynamicResource LLRPMessage.Direction}" />
                        <ComboBox ItemsSource="{Binding DirectionOptions}"
                                  SelectedItem="{Binding FilterDirection}" Name="DirectionComboBox"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,12">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{DynamicResource LLRPMessage.Device}" />
                        <ComboBox ItemsSource="{Binding DeviceIdOptions}"
                                  SelectedItem="{Binding FilterDeviceId}" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,0,12">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{DynamicResource LLRPMessage.MessageType}" />
                        <ComboBox ItemsSource="{Binding MsgTypeOptions}"
                                  SelectedItem="{Binding FilterMsgType}" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding ApplyFilterCommand}"
                            Style="{StaticResource CompactOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="12"
                                Margin="0,0,4,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Filter"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.Filter}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource CompactOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="12"
                                Margin="0,0,4,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Times"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearFilter}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  主内容区  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：原始帧列表  -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource InspectorHeaderBorderStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorHeaderTextStyle}"
                            Text="{DynamicResource LLRPMessage.RawFrameList}" />
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding FilteredFrames}"
                        ScrollViewer.CanContentScroll="True"
                        SelectedItem="{Binding SelectedRawFrame}"
                        VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="1,4,1,4"
                                    Padding="4"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrushCustom}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="{Binding LocalTimestamp, StringFormat='MM/dd HH:mm:ss'}" />
                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"
                                                Text="{Binding Direction}" />
                                            <TextBlock
                                                Margin="2,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text=" | " />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TreeMessageTypeBrush}"
                                                Text="{Binding MsgTypeName}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding Length, StringFormat='{}{0} bytes'}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding DeviceId, StringFormat=' | {0}'}"
                                                Visibility="{Binding DeviceId, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  右侧：消息树和原始数据  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  消息树  -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource InspectorHeaderBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock
                                    FontSize="14"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource GroupHeaderForegroundBrush}"
                                    Icon="Sitemap"
                                    IconFont="Auto" />
                                <TextBlock
                                    Style="{StaticResource InspectorHeaderTextStyle}"
                                    Text="{DynamicResource LLRPMessage.MessageTree}" />
                            </StackPanel>
                        </Border>

                        <TreeView
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding MessageTree}"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Margin="2,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="2,0,4,0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text=": "
                                            Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            Foreground="{DynamicResource TreeValueBrush}"
                                            Text="{Binding Value}"
                                            Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            Margin="2,0,4,0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text=" - "
                                            Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock
                                            FontStyle="Italic"
                                            Foreground="{DynamicResource TreeDescriptionBrush}"
                                            Text="{Binding Description}"
                                            Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!--  原始十六进制数据  -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource InspectorHeaderBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock
                                    FontSize="14"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource GroupHeaderForegroundBrush}"
                                    Icon="Code"
                                    IconFont="Auto" />
                                <TextBlock
                                    Style="{StaticResource InspectorHeaderTextStyle}"
                                    Text="{DynamicResource LLRPMessage.RawHexData}" />
                            </StackPanel>
                        </Border>

                        <TextBox
                            Grid.Row="1"
                            Padding="8"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas, Courier New"
                            FontSize="12"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            Text="{Binding RawHexString, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
