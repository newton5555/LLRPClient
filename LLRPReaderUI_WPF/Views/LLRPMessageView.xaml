<UserControl x:Class="LLRPReaderUI_WPF.Views.LLRPMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:converters="clr-namespace:LLRPReaderUI_WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:LLRPMessageViewModel}">
    <UserControl.Resources>
        <converters:DirectionToBrushConverter x:Key="DirectionToBrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding RefreshDataCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Refresh" Margin="0,0,6,0"/>
                    <TextBlock Text="刷新"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="TimesCircle" Margin="0,0,6,0"/>
                    <TextBlock Text="清除选择"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportToTextCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="FileExport" Margin="0,0,6,0"/>
                    <TextBlock Text="导出文本"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：原始帧列表 -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="原始帧列表" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding RawFrames}" 
                             SelectedItem="{Binding SelectedRawFrame}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,4" Background="#0D000000" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                                   FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Direction}" FontWeight="Bold" 
                                                       Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"/>
                                            <TextBlock Text=" | " Margin="4,0"/>
                                            <TextBlock Text="{Binding Length, StringFormat='{}长度: {0} bytes'}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：消息树和原始数据 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 消息树 -->
                <Border Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="LLRP消息树" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        
                        <TreeView Grid.Row="1" 
                                  ItemsSource="{Binding MessageTree}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  ScrollViewer.CanContentScroll="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text=": " Margin="2,0,6,0" Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Value}" Foreground="DarkBlue" 
                                                   Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text=" - " Margin="2,0,6,0" 
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Description}" FontStyle="Italic" Foreground="Gray" 
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- 原始十六进制数据 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="原始十六进制数据" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        
                        <TextBox Grid.Row="1" 
                                 Text="{Binding RawHexString, Mode=OneWay}" 
                                 IsReadOnly="True"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Top"
                                 
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas, Courier New"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 加载指示器 -->
        <mah:ProgressRing Grid.Row="2" 
                          IsActive="{Binding IsLoading}" 
                          Width="40" Height="40"
                          HorizontalAlignment="Center"
                          Margin="0,12,0,0"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
