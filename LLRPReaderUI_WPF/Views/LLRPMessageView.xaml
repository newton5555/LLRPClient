<UserControl x:Class="LLRPReaderUI_WPF.Views.LLRPMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:converters="clr-namespace:LLRPReaderUI_WPF.Converters"
             xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:LLRPMessageViewModel}">
    <UserControl.Resources>
        <converters:DirectionToBrushConverter x:Key="DirectionToBrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Height="32" Command="{Binding RefreshDataCommand}" Style="{StaticResource FlatButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0"
                                          Foreground="{StaticResource IconInfoBrush}" Icon="Refresh" IconFont="Auto"/>
                            <TextBlock Text="刷新数据"/>
                        </StackPanel>
                    </Button>
                    <Button Height="32" Margin="10,0,0,0" Command="{Binding ExportToTextCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0"
                                          Foreground="{StaticResource IconSuccessBrush}" Icon="FileExport" IconFont="Auto"/>
                            <TextBlock Text="导出文本"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="总计:"/>
                        <Run FontWeight="Bold" Foreground="DodgerBlue" Text="{Binding RawFrames.Count, Mode=OneWay}"/>
                        <Run Text="条"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="筛选:"/>
                        <Run FontWeight="Bold" Foreground="DodgerBlue" Text="{Binding FilteredFrames.Count, Mode=OneWay}"/>
                        <Run Text="条"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Style="{StaticResource StatusHintTextStyle}"
                           Text="{Binding StatusText}"/>
            </Grid>
        </Border>

        <!-- 筛选栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 日期筛选 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    <DatePicker SelectedDate="{Binding FilterStartDate}"
                                Width="130" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    <DatePicker SelectedDate="{Binding FilterEndDate}"
                                Width="130" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- 方向筛选 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="方向" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    <ComboBox ItemsSource="{Binding DirectionOptions}"
                              SelectedItem="{Binding FilterDirection}"
                              Width="80" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- 消息类型筛选 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="消息类型" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    <ComboBox ItemsSource="{Binding MsgTypeOptions}"
                              SelectedItem="{Binding FilterMsgType}"
                              Width="200" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- 搜索框 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="140" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Height="28" Command="{Binding ApplyFilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Width="12" Height="12" Margin="0,0,4,0" Icon="Filter" IconFont="Auto"/>
                            <TextBlock Text="筛选"/>
                        </StackPanel>
                    </Button>
                    <Button Height="28" Margin="8,0,0,0" Command="{Binding ClearFilterCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Width="12" Height="12" Margin="0,0,4,0"
                                          Foreground="{StaticResource IconWarningBrush}" Icon="Times" IconFont="Auto"/>
                            <TextBlock Text="清除"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：原始帧列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                        <TextBlock Text="原始帧列表" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredFrames}"
                             SelectedItem="{Binding SelectedRawFrame}"
                             Background="{DynamicResource MahApps.Brushes.Control.Background}"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="#0D000000" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='MM/dd HH:mm:ss'}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Direction}" FontWeight="Bold" FontSize="11"
                                                       Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}"/>
                                            <TextBlock Text=" | " Margin="4,0" FontSize="11"
                                                       Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                            <TextBlock Text="{Binding MsgTypeName}" FontSize="11" Foreground="DarkGreen"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Length, StringFormat='{}{0} bytes'}"
                                                   FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：消息树和原始数据 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 消息树 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Width="14" Height="14" Margin="0,0,8,0"
                                              Foreground="{StaticResource IconInfoBrush}" Icon="Sitemap" IconFont="Auto"/>
                                <TextBlock Text="LLRP 消息树" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                            </StackPanel>
                        </Border>

                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding MessageTree}"
                                  Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                  BorderThickness="0"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  ScrollViewer.CanContentScroll="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                        <TextBlock Text=": " Margin="2,0,4,0"
                                                   Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                        <TextBlock Text="{Binding Value}" Foreground="DarkBlue"
                                                   Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text=" - " Margin="2,0,4,0"
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"
                                                   Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                                        <TextBlock Text="{Binding Description}" FontStyle="Italic" Foreground="Gray"
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- 原始十六进制数据 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Width="14" Height="14" Margin="0,0,8,0"
                                              Foreground="{StaticResource IconInfoBrush}" Icon="Code" IconFont="Auto"/>
                                <TextBlock Text="原始十六进制数据" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                            </StackPanel>
                        </Border>

                        <TextBox Grid.Row="1"
                                 Text="{Binding RawHexString, Mode=OneWay}"
                                 IsReadOnly="True"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource MahApps.Brushes.Text}"
                                 Padding="8"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
