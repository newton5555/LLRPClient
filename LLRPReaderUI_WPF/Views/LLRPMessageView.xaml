<UserControl
    x:Class="LLRPReaderUI_WPF.Views.LLRPMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LLRPReaderUI_WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance vm:LLRPMessageViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:DirectionToBrushConverter x:Key="DirectionToBrushConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar Section -->
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Width="{DynamicResource UI.LLRP.ButtonWidth}" Height="36" Command="{Binding RefreshDataCommand}" Style="{StaticResource FlatButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Margin="0,0,8,0" FontSize="14" Foreground="White" Icon="ArrowsRotate" IconFont="Auto" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.Refresh}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Width="{DynamicResource UI.LLRP.ButtonWidth}" Height="36" Margin="12,0,0,0" Command="{Binding ClearAllDataCommand}" Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Margin="0,0,8,0" FontSize="14" Foreground="{StaticResource IconDangerBrush}" Icon="Trash" IconFont="Auto" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.ClearAll}" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Width="{DynamicResource UI.LLRP.ButtonWidth}" Height="36" Margin="12,0,0,0" Command="{Binding ExportToTextCommand}" Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Margin="0,0,8,0" FontSize="14" Foreground="{StaticResource IconSuccessBrush}" Icon="FileExport" IconFont="Auto" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.ExportText}" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="13">
                        <Run Text="{DynamicResource LLRPMessage.Total}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Run FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding RawFrames.Count, Mode=OneWay}" />
                        <Run Text="{DynamicResource LLRPMessage.Records}" Foreground="{DynamicResource TextMutedBrush}"/>
                    </TextBlock>
                    <Border Width="1" Height="16" Background="{DynamicResource SubtleBorderBrush}" Margin="16,0"/>
                    <TextBlock FontSize="13">
                        <Run Text="{DynamicResource LLRPMessage.Filtered}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Run FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding FilteredFrames.Count, Mode=OneWay}" />
                        <Run Text="{DynamicResource LLRPMessage.Records}" Foreground="{DynamicResource TextMutedBrush}"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="4" Background="{DynamicResource MahApps.Brushes.Accent}" Opacity="0.05" CornerRadius="4" Padding="12,6">
                    <TextBlock Style="{StaticResource StatusHintTextStyle}" Text="{Binding StatusText}" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Filter Section -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="Filter" IconFont="Auto" Foreground="{StaticResource IconTealBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="123" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,12" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource LLRPMessage.StartDate}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <DatePicker Width="130" Height="32" VerticalContentAlignment="Center" SelectedDate="{Binding FilterStartDate}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource LLRPMessage.EndDate}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <DatePicker Width="130" Height="32" VerticalContentAlignment="Center" SelectedDate="{Binding FilterEndDate}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource LLRPMessage.Direction}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <ComboBox Width="120" Height="32" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding FilterDirection}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource LLRPMessage.Device}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <ComboBox Width="130" Height="32" ItemsSource="{Binding DeviceIdOptions}" SelectedItem="{Binding FilterDeviceId}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{DynamicResource LLRPMessage.MessageType}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <ComboBox Width="160" Height="32" ItemsSource="{Binding MsgTypeOptions}" SelectedItem="{Binding FilterMsgType}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,12">
                        <Button Height="32" Command="{Binding ApplyFilterCommand}" Style="{StaticResource FlatButtonPrimary}" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Filter" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LLRPMessage.Filter}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="32" Margin="8,0,0,0" Command="{Binding ClearFilterCommand}" Style="{StaticResource FlatButtonOutline}" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Xmark" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource IconWarningBrush}"/>
                                <TextBlock Text="{DynamicResource LLRPMessage.ClearFilter}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Raw Frame List -->
            <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="LayerGroup" IconFont="Auto"   VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LLRPMessage.RawFrameList}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding FilteredFrames}" ScrollViewer.CanContentScroll="True" SelectedItem="{Binding SelectedRawFrame}" VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Background="#08000000" CornerRadius="6" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LocalTimestamp, StringFormat='MM/dd HH:mm:ss'}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{Binding Direction, Converter={StaticResource DirectionToBrushConverter}}" Text="{Binding Direction}" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding MsgTypeName}" TextWrapping="Wrap"/>
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <fa:IconBlock Icon="FileLines" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Length, StringFormat='{}{0} bytes'}" VerticalAlignment="Center"/>
                                            <fa:IconBlock Icon="Microchip" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,4,0" Visibility="{Binding DeviceId, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding DeviceId}" VerticalAlignment="Center" Visibility="{Binding DeviceId, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Message Detail -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <!-- Message Tree -->
                <Border Grid.Row="0" Style="{StaticResource AppCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="Sitemap" IconFont="Auto" Foreground="{StaticResource IconInfoBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LLRPMessage.MessageTree}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TreeView Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding MessageTree}" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Margin="4,2" Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Name}" />
                                        <TextBlock Margin="2,0,4,0" Text=": " Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium" Text="{Binding Value}" Visibility="{Binding Value, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Margin="8,0,0,0" FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" FontSize="12"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Raw Hex data -->
                <Border Grid.Row="2" Style="{StaticResource AppCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="Code" IconFont="Auto" Foreground="{StaticResource IconVioletBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource LLRPMessage.RawHexData}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TextBox Grid.Row="1" Padding="12" Background="Transparent" BorderThickness="0" FontFamily="Consolas, Courier New" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsReadOnly="True" Text="{Binding RawHexString, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
