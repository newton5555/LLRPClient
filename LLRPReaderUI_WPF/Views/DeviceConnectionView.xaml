<UserControl
    x:Class="LLRPReaderUI_WPF.Views.DeviceConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:DeviceConnectionViewModel}"
    d:Height="500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingText}" Text="{DynamicResource DeviceConnection.Title}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource BodyText}"
                               Text="{DynamicResource DeviceConnection.EnterAddress}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        VerticalContentAlignment="Center"
                        IsEditable="True"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding RecentReaderEndpoints}"
                        Text="{Binding ReaderEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="2"
                        Command="{Binding ConnectCommand}"
                        Style="{StaticResource FlatButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="PlugCircleCheck"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource DeviceConnection.Connect}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="4"
                        Command="{Binding DisconnectCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="PowerOff"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource DeviceConnection.Disconnect}" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="5"
                            Margin="12,0,0,0"
                            Padding="12,8"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrushCustom}"
                            BorderThickness="0"
                            CornerRadius="12">
                        <TextBlock Style="{StaticResource StatusHintTextStyle}"
                                   Text="{Binding ConnectionState}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingText}" Text="{DynamicResource DeviceConnection.FeatureSetProperty}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource BodyText}"
                               Text="{DynamicResource DeviceConnection.Connected}" />
                </StackPanel>
                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding FeatureSetItems}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="2*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource DeviceConnection.FeatureSetProperty}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="3*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource DeviceConnection.Value}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

       
    </Grid>
</UserControl>
