<UserControl
    x:Class="LLRPReaderUI_WPF.Views.DeviceConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:DeviceConnectionViewModel}"
    d:Height="500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Height="32"
                    VerticalContentAlignment="Center"
                    IsEditable="True"
                    IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding RecentReaderEndpoints}"
                    Text="{Binding ReaderEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="2"
                    Height="32"
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource FlatButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            Foreground="{StaticResource IconSuccessBrush}"
                            Icon="PlugCircleCheck"
                            IconFont="Auto" />
                        <TextBlock Text="{DynamicResource DeviceConnection.Connect}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="4"
                    Height="32"
                    Command="{Binding DisconnectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            Foreground="{StaticResource IconDangerBrush}"
                            Icon="PowerOff"
                            IconFont="Auto" />
                        <TextBlock Text="{DynamicResource DeviceConnection.Disconnect}" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Column="5"
                    Margin="12,0,0,0"
                    Style="{StaticResource StatusHintTextStyle}"
                    Text="{Binding ConnectionState}" />
            </Grid>
        </Border>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding FeatureSetItems}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Name}"
                    Header="{DynamicResource DeviceConnection.FeatureSetProperty}" />
                <DataGridTextColumn
                    Width="3*"
                    Binding="{Binding Value}"
                    Header="{DynamicResource DeviceConnection.Value}" />
            </DataGrid.Columns>
        </DataGrid>

       
    </Grid>
</UserControl>
