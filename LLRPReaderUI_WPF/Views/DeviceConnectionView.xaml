<UserControl
    x:Class="LLRPReaderUI_WPF.Views.DeviceConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:DeviceConnectionViewModel}"
    d:Height="500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Height="40"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    IsEditable="True"
                    IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding RecentReaderEndpoints}"
                    Text="{Binding ReaderEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="2"
                    Width="{DynamicResource UI.Connection.ButtonWidth}"
                    Height="40"
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource FlatButtonPrimary}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="White"
                            Icon="PlugCircleCheck"
                            IconFont="Auto" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource DeviceConnection.Connect}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="4"
                    Width="{DynamicResource UI.Connection.ButtonWidth}"
                    Height="40"
                    Command="{Binding DisconnectCommand}"
                    Style="{StaticResource FlatButtonOutline}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{StaticResource IconDangerBrush}"
                            Icon="PowerOff"
                            IconFont="Auto" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource DeviceConnection.Disconnect}" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Column="5"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Style="{StaticResource StatusHintTextStyle}"
                    Text="{Binding ConnectionState}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PageCardStyle}">
            <DataGrid
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding FeatureSetItems}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="2*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource DeviceConnection.FeatureSetProperty}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="3*">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource DeviceConnection.Value}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

       
    </Grid>
</UserControl>
