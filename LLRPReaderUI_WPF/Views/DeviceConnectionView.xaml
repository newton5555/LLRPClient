<UserControl x:Class="LLRPReaderUI_WPF.Views.DeviceConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Height="500">
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Height="32"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding RecentReaderEndpoints}"
                          Text="{Binding ReaderEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="2"
                        Height="32"
                        Command="{Binding ConnectCommand}"
                        Style="{DynamicResource MahApps.Styles.Button.Accent}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Icon="PlugCircleCheck" IconFont="Auto" />
                        <TextBlock Text="连接" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Height="32"
                        Command="{Binding DisconnectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Icon="PowerOff" IconFont="Auto" />
                        <TextBlock Text="断开" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="5"
                           Style="{StaticResource StatusHintTextStyle}"
                           Margin="12,0,0,0"
                           Text="{Binding ConnectionState}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  ItemsSource="{Binding FeatureSetItems}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FeatureSet 属性" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
