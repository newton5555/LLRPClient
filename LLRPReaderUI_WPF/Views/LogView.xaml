<UserControl
    x:Class="LLRPReaderUI_WPF.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:converters="clr-namespace:LLRPReaderUI_WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LogViewModel}"
    d:Height="500"
    d:Width="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BooleanToStarGridLengthConverter x:Key="BoolToStarGridLengthConverter" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: 统计和全局操作  -->
        <Border
            Grid.Row="0"
            Padding="12"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold">
                    <Run Text="日志总数: " />
                    <Run
                        FontWeight="Bold"
                        Foreground="DodgerBlue"
                        Text="{Binding TotalLogCount, Mode=OneWay}" />
                </TextBlock>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8"
                    Orientation="Horizontal">
                    <Button
                        Padding="12,6"
                        Command="{Binding ClearLogsCommand}"
                        Content="清空全部" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
                    <CheckBox Margin="0,0,16,0" IsChecked="{Binding ShowOperationLogs}">
                        <TextBlock>
                            <Run Text="📋 操作日志" />
                            <Run
                                FontSize="12"
                                Foreground="DodgerBlue"
                                Text="{Binding OperationEntries.Count, Mode=OneWay, StringFormat=(0)}" />
                        </TextBlock>
                    </CheckBox>
                    <CheckBox Margin="0,0,16,0" IsChecked="{Binding ShowLlrpMessageLogs}">
                        <TextBlock>
                            <Run Text="📡 LLRP 消息日志" />
                            <Run
                                FontSize="12"
                                Foreground="DodgerBlue"
                                Text="{Binding LlrpMessageEntries.Count, Mode=OneWay, StringFormat=(0)}" />
                        </TextBlock>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowRawFrameLogs}">
                        <TextBlock>
                            <Run Text="🔧 原始报文收发" />
                            <Run
                                FontSize="12"
                                Foreground="DodgerBlue"
                                Text="{Binding RawPacketEntries.Count, Mode=OneWay, StringFormat=(0)}" />
                        </TextBlock>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>

        <!--  日志内容区  -->
        <Grid Grid.Row="2">

            <TabControl Background="#FFEEEEEE">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}" />
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border
                                        x:Name="HeaderBorder"
                                        Margin="2,0"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4,4,0,0">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="DodgerBlue" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}" />
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Icon="ClipboardList"
                                IconFont="Auto" />
                            <TextBlock>
                                <Run Text="操作日志 " />
                                <Run FontSize="12" Text="{Binding OperationEntries.Count, Mode=OneWay, StringFormat=(0)}" />
                            </TextBlock>
                        </StackPanel>
                    </TabItem.Header>
                    <!--  操作日志  -->
                    <Border
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        CornerRadius="4"
                        Visibility="{Binding ShowOperationLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                           

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="2"
                                Command="{Binding ClearOperationLogsCommand}"
                                Content="  清空  " />

                            <ListBox
                                x:Name="OperationListBox"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource MahApps.Brushes.Text}"
                                ItemsSource="{Binding OperationEntries, Mode=OneWay}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.ScrollUnit="Pixel" />
                        </Grid>
                    </Border>

                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Icon="SatelliteDish"
                                IconFont="Auto" />
                            <TextBlock>
                                <Run Text="LLRP 消息日志 " />
                                <Run FontSize="12" Text="{Binding LlrpMessageEntries.Count, Mode=OneWay, StringFormat=(0)}" />
                            </TextBlock>
                        </StackPanel>
                    </TabItem.Header>
                    <!--  LLRP 消息日志  -->
                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        CornerRadius="4"
                        Visibility="{Binding ShowLlrpMessageLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>



                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="2"
                                Command="{Binding ClearLlrpMessageLogsCommand}"
                                Content="  清空  " />

                            <ListBox
                                x:Name="LlrpMessageListBox"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource MahApps.Brushes.Text}"
                                ItemsSource="{Binding LlrpMessageEntries, Mode=OneWay}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.ScrollUnit="Pixel" />
                        </Grid>
                    </Border>

                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Icon="Code"
                                IconFont="Auto" />
                            <TextBlock>
                                <Run Text="原始报文收发 " />
                                <Run FontSize="12" Text="{Binding RawPacketEntries.Count, Mode=OneWay, StringFormat=(0)}" />
                            </TextBlock>
                        </StackPanel>
                    </TabItem.Header>
                    <!--  原始报文  -->
                    <Border
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        CornerRadius="4"
                        Visibility="{Binding ShowRawFrameLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                               
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                              
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>



                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="2"
                                Command="{Binding ClearRawFrameLogsCommand}"
                                Content="  清空  " />

                            <ListBox
                                x:Name="RawPacketListBox"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource MahApps.Brushes.Text}"
                                ItemsSource="{Binding RawPacketEntries, Mode=OneWay}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.ScrollUnit="Pixel" />
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>






        </Grid>
    </Grid>
</UserControl>
