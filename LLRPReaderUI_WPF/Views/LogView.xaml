<UserControl
    x:Class="LLRPReaderUI_WPF.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LogViewModel}"
    d:Height="500"
    d:Width="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="LogCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonOutline}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="LogTabTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LogTabCountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style x:Key="LogTabBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: 统计和全局操作  -->
        <Border Grid.Row="0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource HeadingText}" Text="{DynamicResource Log.Center}" />
                    <Border Margin="12,0,0,0"
                            Padding="12,6"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrushCustom}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{DynamicResource Log.Total}" />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding TotalLogCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ClearLogsCommand}"
                        Style="{StaticResource LogCompactButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="12"
                                          Margin="0,0,4,0"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Icon="TrashCan"
                                          IconFont="Auto" />
                            <TextBlock Text="{DynamicResource Log.ClearAll}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
                    <CheckBox Margin="0,0,16,0" IsChecked="{Binding ShowOperationLogs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource Log.Operation}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding OperationEntries.Count, Mode=OneWay, StringFormat=({0})}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Margin="0,0,16,0" IsChecked="{Binding ShowLlrpMessageLogs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource Log.LlrpMessage}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding LlrpMessageEntries.Count, Mode=OneWay, StringFormat=({0})}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowRawFrameLogs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource Log.RawFrame}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding RawPacketEntries.Count, Mode=OneWay, StringFormat=({0})}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>

        <!--  日志内容区  -->
        <Grid Grid.Row="2">

            <TabControl Background="Transparent"
                        BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="Padding" Value="16,11" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border
                                        MinWidth="170"
                                        x:Name="HeaderBorder"
                                        Margin="0,0,8,0"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderBrushCustom}"
                                        BorderThickness="1"
                                        CornerRadius="14,14,0,0">
                                        <ContentPresenter
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource NavigationHeaderBrush}" />
                                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource GroupHeaderForegroundBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="HeaderBorder" Property="Margin" Value="0,0,8,-1" />
                                            <Setter TargetName="HeaderBorder" Property="Panel.ZIndex" Value="2" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="HeaderBorder" Property="Panel.ZIndex" Value="0" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem>
                    <TabItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <fa:IconBlock Grid.Column="0"
                                          FontSize="14"
                                          Margin="0,0,8,0"
                                          Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                          VerticalAlignment="Center"
                                          Icon="ClipboardList"
                                          IconFont="Auto" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource LogTabTitleStyle}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                       Text="{DynamicResource Log.Operation}" />
                           
                        </Grid>
                    </TabItem.Header>
                    <!--  操作日志  -->
                    <Border
                        Padding="12"
                       CornerRadius="0,0,32,32"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding ShowOperationLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                           

                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding ClearOperationLogsCommand}"
                                    Style="{StaticResource LogCompactButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock FontSize="12"
                                                  Margin="0,0,4,0"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Icon="Trash"
                                                  IconFont="Auto" />
                                    <TextBlock Text="{DynamicResource Action.Clear}" />
                                </StackPanel>
                            </Button>

                            <ListBox
                                x:Name="OperationListBox"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushCustom}"
                                BorderThickness="1"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                ItemsSource="{Binding OperationEntries, Mode=OneWay}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.ScrollUnit="Pixel" />
                        </Grid>
                    </Border>

                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <fa:IconBlock Grid.Column="0"
                                          FontSize="14"
                                          Margin="0,0,8,0"
                                          Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                          VerticalAlignment="Center"
                                          Icon="SatelliteDish"
                                          IconFont="Auto" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource LogTabTitleStyle}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                       Text="{DynamicResource Log.LlrpMessage}" />
                            
                        </Grid>
                    </TabItem.Header>
                    <!--  LLRP 消息日志  -->
                    <Border
                        CornerRadius="0,0,32,32"
                        Grid.Row="1"
                        Padding="12"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding ShowLlrpMessageLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>



                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding ClearLlrpMessageLogsCommand}"
                                    Style="{StaticResource LogCompactButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock FontSize="12"
                                                  Margin="0,0,4,0"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Icon="Trash"
                                                  IconFont="Auto" />
                                    <TextBlock Text="{DynamicResource Action.Clear}" />
                                </StackPanel>
                            </Button>

                            <ListBox
                                x:Name="LlrpMessageListBox"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushCustom}"
                                BorderThickness="1"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                ItemsSource="{Binding LlrpMessageEntries, Mode=OneWay}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.ScrollUnit="Pixel" />
                        </Grid>
                    </Border>

                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <fa:IconBlock Grid.Column="0"
                                          FontSize="14"
                                          Margin="0,0,8,0"
                                          Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                          VerticalAlignment="Center"
                                          Icon="Code"
                                          IconFont="Auto" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource LogTabTitleStyle}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                       Text="{DynamicResource Log.RawFrame}" />
                            
                        </Grid>
                    </TabItem.Header>
                    <!--  原始报文  -->
                    <Border
                        Padding="12"
                        Style="{StaticResource CardBorderStyle}"
                        CornerRadius="0,0,32,32"
                        Visibility="{Binding ShowRawFrameLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                               
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                              
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>



                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Command="{Binding ClearRawFrameLogsCommand}"
                                    Style="{StaticResource LogCompactButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock FontSize="12"
                                                  Margin="0,0,4,0"
                                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Icon="Trash"
                                                  IconFont="Auto" />
                                    <TextBlock Text="{DynamicResource Action.Clear}" />
                                </StackPanel>
                            </Button>

                            <ListBox
                                x:Name="RawPacketListBox"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushCustom}"
                                BorderThickness="1"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                ItemsSource="{Binding RawPacketEntries, Mode=OneWay}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.ScrollUnit="Pixel" />
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>






        </Grid>
    </Grid>
</UserControl>
