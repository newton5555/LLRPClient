<UserControl x:Class="LLRPReaderUI_WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="16" IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- System Management Group -->
                <GroupBox Margin="0,0,0,10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="Cogs" IconFont="Auto" Foreground="{StaticResource IconPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.SystemManagement}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.EnableKeepalive}" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableKeepalive}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.KeepaliveInterval}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Height="30" Text="{Binding KeepaliveIntervalMs}" />
                        </Grid>
                        
                        <Separator Margin="0,5"/>
                        <TextBlock Margin="0,8,0,4" Text="{DynamicResource Settings.ReaderEvents}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding ReaderEventNotifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- Radio Physical Layer Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="WaveSquare" IconFont="Auto" Foreground="{StaticResource IconVioletBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.RadioPhy}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsFormLabel" />
                            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.RfMode}" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Height="30"
                                  ItemsSource="{Binding RfModeOptions}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedItem="{Binding SelectedRfModeOption}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.HopTableId}" />
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="30" ItemsSource="{Binding HopTableOptions}" SelectedItem="{Binding HopTableId}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedHopTableFrequencies}" 
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.ChannelIndex}" />
                        <Grid Grid.Row="4" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="30" Text="{Binding ChannelIndex}" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedChannelFrequency}" 
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Inventory Protocol Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="Indent" IconFont="Auto" Foreground="{StaticResource IconAccentBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.InventoryProtocol}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsFormLabel" />
                            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.Session}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Height="30" SelectedValuePath="Tag" SelectedValue="{Binding Session}">
                            <ComboBoxItem Content="0" Tag="0" />
                            <ComboBoxItem Content="1" Tag="1" />
                            <ComboBoxItem Content="2" Tag="2" />
                            <ComboBoxItem Content="3" Tag="3" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.TagPopulationEstimate}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Height="30" Text="{Binding TagPopulationEstimate}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Settings.TagPopulationEstimateHint}" />
                    </Grid>
                </GroupBox>

                <!-- Advanced Inventory Features Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="Microchip" IconFont="Auto" Foreground="{StaticResource IconWarningBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.AdvancedFeatures}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsFormLabel" />
                            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.InventoryStateAware}" />
                        <CheckBox Grid.Row="0" Grid.Column="1"
                                  IsChecked="{Binding InventoryStateAware}"
                                  IsEnabled="{Binding IsStateAwareSupported}"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.InventoryTarget}" 
                                   IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Height="30" 
                                  ItemsSource="{Binding InventoryTargetOptions}"
                                  SelectedItem="{Binding InventoryTarget}"
                                  IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.InventorySearchMode}" 
                                   IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Height="30" 
                                  ItemsSource="{Binding InventorySearchModeOptions}"
                                  SelectedItem="{Binding InventorySearchMode}"
                                  IsEnabled="{Binding IsInventoryStateAwareOptionsEnabled}"/>

                        <TextBlock Grid.Row="6" Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{DynamicResource Settings.StateAwareUnsupportedHint}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStateAwareSupported}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </GroupBox>

                <!-- GPIO Configuration Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="Microchip" IconFont="Auto" Foreground="{StaticResource IconTealBrush}"/>
                            <TextBlock Text="{DynamicResource Menu.GPIO}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- GPI Section -->
                        <StackPanel Grid.Column="0" MinWidth="220">
                            <TextBlock Text="{DynamicResource GPIO.GpiConfig}" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.Enable}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Gpis}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PortNumber, StringFormat=GPI {0}}" VerticalAlignment="Center" FontSize="12"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentStateText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Divider -->
                        <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                        <!-- GPO Section -->
                        <StackPanel Grid.Column="2" MinWidth="240">
                            <TextBlock Text="{DynamicResource GPIO.GpoOutput}" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.OutputHigh}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Gpos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PortNumber, StringFormat=GPO {0}}" VerticalAlignment="Center" FontSize="12"/>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding DesiredState}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentStateText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <Button Margin="0,10,0,0" 
                                    Command="{Binding ApplyGpoStatesCommand}"
                                    Style="{StaticResource FlatButtonOutline}"
                                    Height="32" MinHeight="32" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock FontSize="12" Margin="0,0,6,0" Icon="PaperPlane" IconFont="Auto" />
                                    <TextBlock Text="{DynamicResource GPIO.ApplyGpo}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Antenna Configuration Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="TowerBroadcast" IconFont="Auto" Foreground="{StaticResource IconTealBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.AntennaConfig}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" MinWidth="84" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Port}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Enable}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Settings.TxPower}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{DynamicResource Settings.RxSensitivity}" FontWeight="SemiBold" 
                                       Visibility="{Binding IsRxSensitivityVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Antennas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" MinWidth="84" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                            <Run Text="{DynamicResource Inventory.Antenna}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding PortNumber}" />
                                        </TextBlock>
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                        <ComboBox Grid.Column="2"
                                                  Height="28"
                                                  ItemsSource="{Binding DataContext.TxPowerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding TxPowerInDbm}" />
                                        <ComboBox Grid.Column="3"
                                                  Height="28"
                                                  ItemsSource="{Binding DataContext.RxSensitivityOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding RxSensitivityInDbm}"
                                                  Visibility="{Binding DataContext.IsRxSensitivityVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button MinWidth="132"
                    Margin="0,0,8,0"
                    Command="{Binding QueryDeviceSettingsCommand}"
                    Style="{StaticResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock FontSize="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="Download" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource Settings.Query}" />
                </StackPanel>
            </Button>

            <Button MinWidth="132"
                    Margin="0,0,8,0"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource FlatButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock FontSize="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="FloppyDisk" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource Settings.Save}" />
                </StackPanel>
            </Button>


            <Button MinWidth="132"
                    Margin="0,0,8,0"
                    Command="{Binding DataContext.QueryStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock FontSize="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="CircleInfo" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource Settings.QueryStatus}" />
                </StackPanel>
            </Button>


            <Button MinWidth="132"
                    Command="{Binding ResetFactoryDefaultsCommand}"
                    Style="{StaticResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock FontSize="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="RotateLeft" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource Settings.ResetFactory}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource StatusHintTextStyle}" Text="{Binding SaveResult}" />
    </Grid>
</UserControl>
