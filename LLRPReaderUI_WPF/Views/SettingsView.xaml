<UserControl x:Class="LLRPReaderUI_WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PageCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="HeartPulse" IconFont="Auto" Foreground="{StaticResource IconDangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings.KeepaliveConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.EnableKeepalive}" />
                                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableKeepalive}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.KeepaliveInterval}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Height="32" Text="{Binding KeepaliveIntervalMs}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="Sliders" IconFont="Auto" Foreground="{StaticResource IconVioletBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings.RfInventoryConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.RfMode}" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          Height="32"
                                          ItemsSource="{Binding RfModeOptions}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedRfModeOption}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.Session}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Height="32" SelectedValuePath="Tag" SelectedValue="{Binding Session}">
                                    <ComboBoxItem Content="0" Tag="0" />
                                    <ComboBoxItem Content="1" Tag="1" />
                                    <ComboBoxItem Content="2" Tag="2" />
                                    <ComboBoxItem Content="3" Tag="3" />
                                </ComboBox>

                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.TagPopulationEstimate}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Height="32" Text="{Binding TagPopulationEstimate}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.HopTableId}" />
                                <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Height="32" ItemsSource="{Binding HopTableOptions}" SelectedItem="{Binding HopTableId}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHopTableFrequencies}" 
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.ChannelIndex}" />
                                <Grid Grid.Row="10" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="32" Text="{Binding ChannelIndex}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedChannelFrequency}" 
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" 
                                            IsEnabled="{Binding IsStateAwareSupported}">
                                    <Separator Margin="0,12" Background="{DynamicResource BorderBrushCustom}" Opacity="0.5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.InventoryStateAware}" />
                                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding InventoryStateAware}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.InventoryTarget}" 
                                                   IsEnabled="{Binding InventoryStateAware}"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" Height="32" 
                                                  ItemsSource="{Binding InventoryTargetOptions}"
                                                  SelectedItem="{Binding InventoryTarget}"
                                                  IsEnabled="{Binding InventoryStateAware}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Settings.InventorySearchMode}" 
                                                   IsEnabled="{Binding InventoryStateAware}"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" Height="32" 
                                                  ItemsSource="{Binding InventorySearchModeOptions}"
                                                  SelectedItem="{Binding InventorySearchMode}"
                                                  IsEnabled="{Binding InventoryStateAware}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="TowerBroadcast" IconFont="Auto" Foreground="{StaticResource IconTealBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings.AntennaConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Port}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Enable}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Settings.TxPower}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{DynamicResource Settings.RxSensitivity}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Antennas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                    <Run Text="{DynamicResource Inventory.Antenna}" FontWeight="Medium" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding PortNumber}" />
                                                </TextBlock>
                                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                                <ComboBox Grid.Column="2"
                                                          Height="28"
                                                          ItemsSource="{Binding DataContext.TxPowerOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding TxPowerInDbm}" />
                                                <ComboBox Grid.Column="3"
                                                          Height="28"
                                                          ItemsSource="{Binding DataContext.RxSensitivityOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding RxSensitivityInDbm}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="ListCheck" IconFont="Auto" Foreground="{StaticResource IconAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings.ReaderEvents}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ItemsControl Margin="8,0" ItemsSource="{Binding ReaderEventNotifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" Text="{Binding}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Width="{DynamicResource UI.Settings.ButtonWidth}" Height="40" Margin="0,0,12,0" Command="{Binding QueryDeviceSettingsCommand}" Style="{DynamicResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource IconInfoBrush}" Icon="Download" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource Settings.Query}" />
                </StackPanel>
            </Button>

            <Button Width="{DynamicResource UI.Settings.ButtonWidth}" Height="40" Margin="0,0,12,0" Command="{Binding SaveSettingsCommand}" Style="{DynamicResource FlatButtonPrimary}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" Icon="FloppyDisk" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Settings.Save}" />
                </StackPanel>
            </Button>

            <Button Width="{DynamicResource UI.Settings.ButtonWidth}" Height="40" Margin="0,0,12,0" Command="{Binding DataContext.QueryStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource IconInfoBrush}" Icon="CircleInfo" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource Settings.QueryStatus}" />
                </StackPanel>
            </Button>

            <Button Width="{DynamicResource UI.Settings.ButtonWidth}" Height="40" Command="{Binding ResetFactoryDefaultsCommand}" Style="{DynamicResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource IconWarningBrush}" Icon="RotateLeft" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource Settings.ResetFactory}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{DynamicResource StatusHintTextStyle}" Text="{Binding SaveResult}" />
    </Grid>
</UserControl>
