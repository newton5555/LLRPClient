<UserControl x:Class="LLRPReaderUI_WPF.Views.GpioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:GpioViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="PlugCircleCheck" IconFont="Auto" Foreground="{StaticResource IconSuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource GPIO.GpiConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.Enable}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Gpis}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PortNumber, StringFormat=GPI {0}}" FontWeight="Medium" />
                                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CurrentStateText}" Foreground="{Binding CurrentStateText, Converter={StaticResource GpioStateColorConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Margin="0,0,8,0" FontSize="16" Icon="ToggleOn" IconFont="Auto" Foreground="{StaticResource IconAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource GPIO.GpoOutput}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.OutputHigh}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Gpos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PortNumber, StringFormat=GPO {0}}" FontWeight="Medium" />
                                                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DesiredState}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CurrentStateText}" Foreground="{Binding CurrentStateText, Converter={StaticResource GpioStateColorConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Width="{DynamicResource UI.GPIO.ButtonWidth}" Height="40" Margin="0,0,12,0" Command="{Binding QueryGpioSettingsCommand}" Style="{StaticResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource IconInfoBrush}" Icon="Download" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource GPIO.Query}" />
                </StackPanel>
            </Button>
            <Button Width="{DynamicResource UI.GPIO.ButtonWidth}" Height="40" Margin="0,0,12,0" Command="{Binding SaveGpiSettingsCommand}" Style="{StaticResource FlatButtonPrimary}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" Icon="FloppyDisk" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource GPIO.SaveGpi}" />
                </StackPanel>
            </Button>
            <Button Width="{DynamicResource UI.GPIO.ButtonWidth}" Height="40" Command="{Binding ApplyGpoStatesCommand}" Style="{StaticResource FlatButtonPrimary}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" Icon="PaperPlane" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource GPIO.ApplyGpo}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource StatusHintTextStyle}" Text="{Binding OperationResult}" />
    </Grid>
</UserControl>
