<UserControl x:Class="LLRPReaderUI_WPF.Views.GpioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:GpioViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Icon="PlugCircleCheck" IconFont="Auto" Foreground="{StaticResource IconSuccessBrush}"/>
                            <TextBlock Text="{DynamicResource GPIO.GpiConfig}" Foreground="White"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.Enable}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Gpis}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PortNumber, StringFormat=GPI {0}}" />
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CurrentStateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" >
                            <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Icon="ToggleOn" IconFont="Auto" Foreground="{StaticResource IconAccentBrush}"/>
                            <TextBlock Text="{DynamicResource GPIO.GpoOutput}" Foreground="White"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource GPIO.Port}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource GPIO.OutputHigh}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource GPIO.CurrentLevel}" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Gpos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PortNumber, StringFormat=GPO {0}}" />
                                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DesiredState}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CurrentStateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Height="32"
                    Width="120"
                    Margin="0,0,8,0"
                    Command="{Binding QueryGpioSettingsCommand}"
                    CommandParameter="True">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Foreground="{StaticResource IconInfoBrush}" Icon="Download" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource GPIO.Query}" />
                </StackPanel>
            </Button>
            <Button Height="32"
                    Width="120"
                    Margin="0,0,8,0"
                    Command="{Binding SaveGpiSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Foreground="{StaticResource IconSuccessBrush}" Icon="FloppyDisk" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource GPIO.SaveGpi}" />
                </StackPanel>
            </Button>
            <Button Height="32"
                    Width="120"
                    Command="{Binding ApplyGpoStatesCommand}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Width="14" Height="14" Margin="0,0,6,0" Foreground="{StaticResource IconVioletBrush}" Icon="PaperPlane" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource GPIO.ApplyGpo}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource StatusHintTextStyle}" Text="{Binding OperationResult}" />
    </Grid>
</UserControl>
