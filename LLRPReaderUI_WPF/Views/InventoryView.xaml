<UserControl
    x:Class="LLRPReaderUI_WPF.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:helpers="clr-namespace:LLRPReaderUI_WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:InventoryViewModel}"
    d:Height="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <x:Array x:Key="DesignReceivedTags" Type="{x:Type viewmodels:InventoryTagItemViewModel}">
            <viewmodels:InventoryTagItemViewModel
                Antenna="1"
                AttachedData="E28011712000013FADFC09A0"
                ChannelMhz="920.625"
                Crc="0x1A2B"
                Epc="E20034120123456789012345"
                FirstSeenTimestampUtc="2026-03-02 02:12:30.100Z"
                LastSeenTimestampUtc="2026-03-02 02:12:30.123Z"
                Pc="0x3000"
                ReceiveTime="2026-03-02T10:12:30.123"
                Rssi="-45.2"
                SeenCount="3" />
            <viewmodels:InventoryTagItemViewModel
                Antenna="2"
                AttachedData="E280117120001410AE2209A0"
                ChannelMhz="921.125"
                Crc="0x1A3C"
                Epc="E2801170000002084F2A1BCD"
                FirstSeenTimestampUtc="2026-03-02 02:12:31.000Z"
                LastSeenTimestampUtc="2026-03-02 02:12:31.008Z"
                Pc="0x3400"
                ReceiveTime="2026-03-02T10:12:31.008"
                Rssi="-51.7"
                SeenCount="1" />
            <viewmodels:InventoryTagItemViewModel
                Antenna="4"
                AttachedData="E280110C20007A91BCC50A11"
                ChannelMhz="922.375"
                Crc="0x2B4D"
                Epc="300833B2DDD9014000000001"
                FirstSeenTimestampUtc="2026-03-02 02:12:31.500Z"
                LastSeenTimestampUtc="2026-03-02 02:12:31.556Z"
                Pc="0x3800"
                ReceiveTime="2026-03-02T10:12:31.556"
                Rssi="-60.0"
                SeenCount="8" />
        </x:Array>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingText}" Text="{DynamicResource Inventory.Start}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyText}" Text="{Binding InventoryState}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button
                        Width="128"
                        Command="{Binding StartInventoryCommand}"
                        Style="{StaticResource FlatButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Play"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource Inventory.Start}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="128"
                        Margin="10,0,0,0"
                        Command="{Binding StopInventoryCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Stop"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource Inventory.Stop}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="136"
                        Margin="10,0,0,0"
                        Command="{Binding ManualPullBufferedReportsCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="Rotate"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource Inventory.PullBuffer}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="112"
                        Margin="10,0,0,0"
                        Command="{Binding ClearReceivedDataCommand}"
                        Style="{StaticResource FlatButtonOutline}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock
                                FontSize="14"
                                Margin="0,0,6,0"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Icon="TrashCan"
                                IconFont="Auto" />
                            <TextBlock Text="{DynamicResource Inventory.Clear}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Margin="0,0,10,0"
                    Padding="16,14"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Inventory.TotalReports}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding TotalReports}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,10,0"
                    Padding="16,14"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Inventory.TotalTags}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding TotalTags}" />
                </StackPanel>
            </Border>
            <Border Padding="16,14"
                    Margin="0,0,10,0"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Inventory.UniqueTags}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding UniqueTagCount}" />
                </StackPanel>
            </Border>
            <Border Padding="16,14"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Inventory.Duration}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding InventoryDuration}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <DataGrid
                x:Name="InventoryDataGrid"
                d:ItemsSource="{StaticResource ResourceKey=DesignReceivedTags}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ReceivedTags}"
                PreviewKeyDown="InventoryDataGrid_OnPreviewKeyDown"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
               
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="CopyEpcMenuItem_OnClick" Header="{DynamicResource Inventory.CopyEpc}" />
                        <MenuItem Click="CopyAttachedDataMenuItem_OnClick" Header="{DynamicResource Inventory.CopyAttachedData}" />
                        <Separator />
                        <MenuItem Click="CopySelectedRowsMenuItem_OnClick" Header="{DynamicResource Inventory.CopySelectedRows}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding ReceiveTime, StringFormat=MM/dd HH:mm:ss.fff}"
                        Header="{DynamicResource Inventory.ReceiveTime}" >
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Epc}"
                        Header="{DynamicResource Inventory.EPC}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Antenna}"
                        Header="{DynamicResource Inventory.Antenna}"
                        Visibility="{Binding Data.ShowAntennaPortNumberColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding ChannelMhz}"
                        Header="{DynamicResource Inventory.Frequency}"
                        Visibility="{Binding Data.ShowChannelColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Rssi}"
                        Header="{DynamicResource Inventory.RSSI}"
                        Visibility="{Binding Data.ShowPeakRssiColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding SeenCount}"
                        Header="{DynamicResource Inventory.Count}"
                        Visibility="{Binding Data.ShowSeenCountColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Pc}"
                        Header="PC"
                        Visibility="{Binding Data.ShowPcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Crc}"
                        Header="CRC"
                        Visibility="{Binding Data.ShowCrcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding FirstSeenTimestampUtc}"
                        Header="FirstTimestamp"
                        Visibility="{Binding Data.ShowFirstSeenTimestampUtcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding LastSeenTimestampUtc}"
                        Header="LastTimestamp"
                        Visibility="{Binding Data.ShowLastSeenTimestampUtcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding AttachedData}"
                        Header="{DynamicResource Inventory.AttachedData}"
                        Visibility="{Binding Data.AttachedDataEnabled, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
