<UserControl
    x:Class="LLRPReaderUI_WPF.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:helpers="clr-namespace:LLRPReaderUI_WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:InventoryViewModel}"
    d:Height="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <x:Array x:Key="DesignReceivedTags" Type="{x:Type viewmodels:InventoryTagItemViewModel}">
            <viewmodels:InventoryTagItemViewModel
                Antenna="1"
                AttachedData="E28011712000013FADFC09A0"
                ChannelMhz="920.625"
                Crc="0x1A2B"
                Epc="E20034120123456789012345"
                FirstSeenTimestampUtc="2026-03-02 02:12:30.100Z"
                LastSeenTimestampUtc="2026-03-02 02:12:30.123Z"
                Pc="0x3000"
                ReceiveTime="2026-03-02T10:12:30.123"
                Rssi="-45.2"
                SeenCount="3" />
            <viewmodels:InventoryTagItemViewModel
                Antenna="2"
                AttachedData="E280117120001410AE2209A0"
                ChannelMhz="921.125"
                Crc="0x1A3C"
                Epc="E2801170000002084F2A1BCD"
                FirstSeenTimestampUtc="2026-03-02 02:12:31.000Z"
                LastSeenTimestampUtc="2026-03-02 02:12:31.008Z"
                Pc="0x3400"
                ReceiveTime="2026-03-02T10:12:31.008"
                Rssi="-51.7"
                SeenCount="1" />
            <viewmodels:InventoryTagItemViewModel
                Antenna="4"
                AttachedData="E280110C20007A91BCC50A11"
                ChannelMhz="922.375"
                Crc="0x2B4D"
                Epc="300833B2DDD9014000000001"
                FirstSeenTimestampUtc="2026-03-02 02:12:31.500Z"
                LastSeenTimestampUtc="2026-03-02 02:12:31.556Z"
                Pc="0x3800"
                ReceiveTime="2026-03-02T10:12:31.556"
                Rssi="-60.0"
                SeenCount="8" />
        </x:Array>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="{DynamicResource UI.Inventory.ButtonWidth}"
                    Height="40"
                    Command="{Binding StartInventoryCommand}"
                    Style="{DynamicResource FlatButtonPrimary}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="White"
                            Icon="Play"
                            IconFont="Auto" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Inventory.Start}" />
                    </StackPanel>
                </Button>
                <Button
                    Width="{DynamicResource UI.Inventory.ButtonWidth}"
                    Height="40"
                    Margin="12,0,0,0"
                    Command="{Binding StopInventoryCommand}"
                    Style="{DynamicResource FlatButtonOutline}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{StaticResource IconDangerBrush}"
                            Icon="Stop"
                            IconFont="Auto" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Inventory.Stop}" />
                    </StackPanel>
                </Button>
                <Button
                    Width="{DynamicResource UI.Inventory.ButtonWidth}"
                    Height="40"
                    Margin="12,0,0,0"
                    Command="{Binding ManualPullBufferedReportsCommand}"
                    Style="{DynamicResource FlatButtonOutline}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{StaticResource IconInfoBrush}"
                            Icon="Rotate"
                            IconFont="Auto" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource Inventory.PullBuffer}" />
                    </StackPanel>
                </Button>
                <Button
                    Width="{DynamicResource UI.Inventory.ButtonWidth}"
                    Height="40"
                    Margin="12,0,0,0"
                    Command="{Binding ClearReceivedDataCommand}"
                    Style="{DynamicResource FlatButtonOutline}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{StaticResource IconWarningBrush}"
                            Icon="TrashCan"
                            IconFont="Auto" />
                        <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource Inventory.Clear}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,6" Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="16">
                <TextBlock
                    Style="{DynamicResource StatusHintTextStyle}"
                    FontWeight="SemiBold"
                    Text="{Binding InventoryState}" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,12">
            <Border Style="{DynamicResource StatCardStyle}" Width="160">
                <StackPanel>
                    <TextBlock FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource Inventory.TotalReports}" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" Text="{Binding TotalReports}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource StatCardStyle}" Width="160" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource Inventory.TotalTags}" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentVioletBrush}" Text="{Binding TotalTags}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource StatCardStyle}" Width="160" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource Inventory.UniqueTags}" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentTealBrush}" Text="{Binding InventoryItems.Count}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="4" Style="{DynamicResource PageCardStyle}">
            <DataGrid
                x:Name="InventoryDataGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding InventoryItems}"
                PreviewKeyDown="InventoryDataGrid_OnPreviewKeyDown"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="CopyEpcMenuItem_OnClick" Header="{DynamicResource Inventory.CopyEpc}" />
                        <MenuItem Click="CopyAttachedDataMenuItem_OnClick" Header="{DynamicResource Inventory.CopyAttachedData}" />
                        <Separator />
                        <MenuItem Click="CopySelectedRowsMenuItem_OnClick" Header="{DynamicResource Inventory.CopySelectedRows}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding ReceiveTime, StringFormat=MM/dd HH:mm:ss.fff}"
                        Header="{DynamicResource Inventory.ReceiveTime}" >
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Epc}"
                        Header="{DynamicResource Inventory.EPC}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Antenna}"
                        Header="{DynamicResource Inventory.Antenna}"
                        Visibility="{Binding Data.ShowAntennaPortNumberColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding ChannelMhz}"
                        Header="{DynamicResource Inventory.Frequency}"
                        Visibility="{Binding Data.ShowChannelColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTemplateColumn
                        Width="100"
                        Header="{DynamicResource Inventory.RSSI}"
                        Visibility="{Binding Data.ShowPeakRssiColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Text="{Binding Rssi, StringFormat=\{0\} dBm}" />
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="4"
                                        Margin="0,2,0,0"
                                        Background="#E2E8F0"
                                        BorderThickness="0"
                                        Maximum="0"
                                        Minimum="-90"
                                        Value="{Binding Rssi}">
                                        <ProgressBar.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#EF4444" />
                                                <GradientStop Offset="0.6" Color="#F59E0B" />
                                                <GradientStop Offset="1" Color="#10B981" />
                                            </LinearGradientBrush>
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding SeenCount}"
                        Header="{DynamicResource Inventory.Count}"
                        Visibility="{Binding Data.ShowSeenCountColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Pc}"
                        Header="PC"
                        Visibility="{Binding Data.ShowPcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Crc}"
                        Header="CRC"
                        Visibility="{Binding Data.ShowCrcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding FirstSeenTimestampUtc}"
                        Header="FirstTimestamp"
                        Visibility="{Binding Data.ShowFirstSeenTimestampUtcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding LastSeenTimestampUtc}"
                        Header="LastTimestamp"
                        Visibility="{Binding Data.ShowLastSeenTimestampUtcColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding AttachedData}"
                        Header="{DynamicResource Inventory.AttachedData}"
                        Visibility="{Binding Data.AttachedDataEnabled, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibilityConverter}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
