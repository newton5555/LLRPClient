<UserControl x:Class="LLRPReaderUI_WPF.Views.ReadWriteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ReadWriteViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="900">
            <GroupBox Header="{DynamicResource ReadWrite.ReadConfig}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource ReadWrite.Legend}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource ReadWrite.TargetTagType}" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              Height="32"
                              ItemsSource="{Binding TargetTagBanks}"
                              SelectedItem="{Binding SelectedTargetTagBank}"
                              ToolTip="{DynamicResource ReadWrite.TargetTagTooltip}" />

                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                            <Run Text="{DynamicResource ReadWrite.TargetTagData}" />
                        </TextBlock>

                    </StackPanel>
                    <Border Grid.Row="4"
                            Grid.Column="1"
                            
                            BorderBrush="{DynamicResource WriteRequiredForeground}"
                            BorderThickness="1">
                        <TextBox Margin="0"
                                 VerticalContentAlignment="Center"
                                 Padding="4,0,4,0"
                                 Background="{DynamicResource BothRequiredBackground}"
                                 BorderBrush="{DynamicResource ReadRequiredForeground}"
                                 Text="{Binding TargetTagData, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource ReadWrite.TargetTagTooltip}" />
                    </Border>

                    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource ReadWrite.MemoryBank}" />
                    <ComboBox Grid.Row="6" Grid.Column="1"
                              Height="32"
                              ItemsSource="{Binding MemoryBanks}"
                              SelectedItem="{Binding SelectedMemoryBank}"
                              ToolTip="{DynamicResource ReadWrite.TargetTagTooltip}" />

                    <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource ReadWrite.WordStartAddress}" />

                    </StackPanel>
                    <Border Grid.Row="8"
                            Grid.Column="1"
                            
                            BorderBrush="{DynamicResource WriteRequiredForeground}"
                            BorderThickness="1">
                        <TextBox Margin="0"
                                 VerticalContentAlignment="Center"
                                 Padding="4,0,4,0"
                                 Background="{DynamicResource BothRequiredBackground}"
                                 BorderBrush="{DynamicResource ReadRequiredForeground}"
                                 Text="{Binding WordPointer, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource ReadWrite.WordPointerTooltip}" />
                    </Border>

                    <TextBlock Grid.Row="10" Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ReadRequiredForeground}"
                               FontWeight="SemiBold"
                               Text="{DynamicResource ReadWrite.WordCount}" />
                    <TextBox Grid.Row="10" Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Background="{DynamicResource ReadRequiredBackground}"
                             BorderBrush="{DynamicResource ReadRequiredForeground}"
                             Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ReadWrite.WordCountTooltip}" />

                    <TextBlock Grid.Row="12" Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WriteRequiredForeground}"
                               FontWeight="SemiBold"
                               Text="{DynamicResource ReadWrite.WriteData}" />
                    <TextBox Grid.Row="12" Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Background="{DynamicResource WriteRequiredBackground}"
                             BorderBrush="{DynamicResource WriteRequiredForeground}"
                             Text="{Binding WriteData, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ReadWrite.WriteDataTooltip}" />

                    <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource ReadWrite.AccessPassword}" />
                    <TextBox Grid.Row="14" Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Text="{Binding AccessPassword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ReadWrite.AccessPasswordTooltip}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource ReadWrite.Operations}" Margin="0,10,0,0">
                <StackPanel Margin="14">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="120"
                                Content="{DynamicResource ReadWrite.ReadMemory}"
                                Command="{Binding ReadMemoryCommand}"
                                Style="{StaticResource FlatButtonPrimary}" />
                        <Button Width="120"
                                Margin="10,0,0,0"
                                Content="{DynamicResource ReadWrite.WriteMemory}"
                                Command="{Binding WriteMemoryCommand}"
                                Style="{StaticResource FlatButtonOutline}" />
                        <CheckBox Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{DynamicResource ReadWrite.BlockWrite}"
                                  IsChecked="{Binding IsBlockWriteChecked}"
                                  IsEnabled="{Binding IsBlockWriteSupported}"
                                  ToolTip="{DynamicResource ReadWrite.BlockWriteTooltip}" />
                        <Button Width="120"
                                Margin="10,0,0,0"
                                Content="{DynamicResource ReadWrite.ClearData}"
                                Command="{Binding ClearDataCommand}"
                                Style="{StaticResource FlatButtonOutline}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding OperationResult}"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource ReadWrite.ReadResult}" Margin="0,10,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource ReadWrite.HexData}" />
                    <TextBox Grid.Row="2" 
                             Height="100"
                             VerticalContentAlignment="Top"
                             Text="{Binding ReadData, Mode=OneWay}" 
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             FontFamily="Consolas" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
