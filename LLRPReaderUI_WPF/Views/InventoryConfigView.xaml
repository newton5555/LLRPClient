<UserControl x:Class="LLRPReaderUI_WPF.Views.InventoryConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:InventoryConfigViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AppCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <!-- Auto Start Config -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Width="16" Height="16" Margin="0,0,8,0" Icon="Play" IconFont="Auto" Foreground="{StaticResource IconSuccessBrush}"/>
                                <TextBlock Text="{DynamicResource InventoryConfig.AutoStartConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Mode}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Height="32" ItemsSource="{Binding AutoStartModes}" SelectedItem="{Binding AutoStartMode}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiPortNum}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Height="32" Text="{Binding AutoStartGpiPortNumber}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiLevel}" />
                                <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStartGpiLevel}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.FirstDelayMs}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Height="32" Text="{Binding AutoStartFirstDelayInMs}" />
                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.PeriodMs}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Height="32" Text="{Binding AutoStartPeriodInMs}" />
                                <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.UtcTimestamp}" />
                                <TextBox Grid.Row="10" Grid.Column="1" Height="32" Text="{Binding AutoStartUtcTimestamp}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Auto Stop Config -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Width="16" Height="16" Margin="0,0,8,0" Icon="Stop" IconFont="Auto" Foreground="{StaticResource IconDangerBrush}"/>
                                <TextBlock Text="{DynamicResource InventoryConfig.AutoStopConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Mode}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Height="32" ItemsSource="{Binding AutoStopModes}" SelectedItem="{Binding AutoStopMode}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.DurationMs}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Height="32" Text="{Binding AutoStopDurationInMs}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiPortNum}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Height="32" Text="{Binding AutoStopGpiPortNumber}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiLevel}" />
                                <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStopGpiLevel}" />
                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Timeout}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Height="32" Text="{Binding AutoStopTimeout}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Filter Config -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Width="16" Height="16" Margin="0,0,8,0" Icon="Filter" IconFont="Auto" Foreground="{StaticResource IconWarningBrush}"/>
                                <TextBlock Text="{DynamicResource InventoryConfig.FilterConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Mode}" />
                                    <ComboBox Grid.Column="1" Height="32" ItemsSource="{Binding TagFilterModes}" SelectedItem="{Binding FilterMode}" />
                                </Grid>

                                <!-- Filter 1 -->
                                <Border BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="0,1,0,0" Margin="0,8" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource InventoryConfig.TagFilter1}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Height="30" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding Filter1MemoryBank}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.FilterOp}" />
                                            <ComboBox Grid.Row="0" Grid.Column="3" Height="30" ItemsSource="{Binding TagFilterOps}" SelectedItem="{Binding Filter1FilterOp}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitPointer}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Height="30" Text="{Binding Filter1BitPointer}" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitCount}" />
                                            <TextBox Grid.Row="2" Grid.Column="3" Height="30" Text="{Binding Filter1BitCount}" />
                                            <TextBlock Grid.Row="4" Margin="0,8,0,4" Text="{DynamicResource InventoryConfig.TagMaskHex}" Grid.ColumnSpan="4"/>
                                            <TextBox Grid.Row="5" Height="32" Text="{Binding Filter1TagMask}" Grid.ColumnSpan="4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Filter 2 -->
                                <Border BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="0,1,0,0" Margin="0,8" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource InventoryConfig.TagFilter2}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Height="30" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding Filter2MemoryBank}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.FilterOp}" />
                                            <ComboBox Grid.Row="0" Grid.Column="3" Height="30" ItemsSource="{Binding TagFilterOps}" SelectedItem="{Binding Filter2FilterOp}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitPointer}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Height="30" Text="{Binding Filter2BitPointer}" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitCount}" />
                                            <TextBox Grid.Row="2" Grid.Column="3" Height="30" Text="{Binding Filter2BitCount}" />
                                            <TextBlock Grid.Row="4" Margin="0,8,0,4" Text="{DynamicResource InventoryConfig.TagMaskHex}" Grid.ColumnSpan="4"/>
                                            <TextBox Grid.Row="5" Height="32" Text="{Binding Filter2TagMask}" Grid.ColumnSpan="4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Select Filters -->
                                <Border BorderBrush="{DynamicResource BorderBrushCustom}" BorderThickness="0,1,0,0" Margin="0,8" Padding="0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                            <TextBlock Text="{DynamicResource InventoryConfig.TagSelectFilters}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Width="100" Height="28" Margin="12,0,0,0" Content="{DynamicResource InventoryConfig.AddFilter}" Command="{Binding AddTagSelectFilterCommand}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding TagSelectFilters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,12" Padding="12" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushCustom}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" /><ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="130" /><ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                                                <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                                            <ComboBox Grid.Row="0" Grid.Column="1" Height="28" ItemsSource="{Binding DataContext.MemoryBanks, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding MemoryBank}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitPointer}" />
                                                            <TextBox Grid.Row="0" Grid.Column="3" Height="28" Text="{Binding BitPointer}" />
                                                            <Button Grid.Row="0" Grid.Column="4" Width="28" Height="28" Margin="8,0,0,0" Command="{Binding DataContext.RemoveTagSelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <fa:IconBlock Icon="Xmark" FontSize="14" Foreground="{StaticResource IconDangerBrush}"/>
                                                            </Button>
                                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitCount}" />
                                                            <TextBox Grid.Row="2" Grid.Column="1" Height="28" Text="{Binding BitCount}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MatchAction}" />
                                                            <ComboBox Grid.Row="2" Grid.Column="3" Height="28" ItemsSource="{Binding DataContext.StateUnawareActions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding MatchAction}" />
                                                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.TagMask}" />
                                                            <TextBox Grid.Row="4" Grid.Column="1" Height="28" Text="{Binding TagMask}" />
                                                            <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.NonMatchAction}" />
                                                            <ComboBox Grid.Row="4" Grid.Column="3" Height="28" ItemsSource="{Binding DataContext.StateUnawareActions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding NonMatchAction}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Report Config -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Width="16" Height="16" Margin="0,0,8,0" Icon="SquarePollVertical" IconFont="Auto" Foreground="{StaticResource IconAccentBrush}"/>
                                <TextBlock Text="{DynamicResource InventoryConfig.ReportConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.ReportMode}" />
                                    <ComboBox Grid.Column="1" Height="32" ItemsSource="{Binding ReportModes}" SelectedItem="{Binding ReportMode}" />
                                </Grid>
                                <UniformGrid Columns="2" Rows="4">
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludeAntenna}" IsChecked="{Binding IncludeAntennaPortNumber}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludeChannel}" IsChecked="{Binding IncludeChannel}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludeFirstSeen}" IsChecked="{Binding IncludeFirstSeenTime}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludeLastSeen}" IsChecked="{Binding IncludeLastSeenTime}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludeSeenCount}" IsChecked="{Binding IncludeSeenCount}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludePeakRssi}" IsChecked="{Binding IncludePeakRssi}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludePcBits}" IsChecked="{Binding IncludePcBits}" />
                                    <CheckBox Margin="0,4" Content="{DynamicResource InventoryConfig.IncludeCrc}" IsChecked="{Binding IncludeCrc}" />
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Attached Data Config -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa:IconBlock Width="16" Height="16" Margin="0,0,8,0" Foreground="{StaticResource IconTealBrush}" Icon="Database" IconFont="Auto" />
                                <TextBlock Text="{DynamicResource InventoryConfig.AttachedDataConfig}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.EnableAttachedData}" />
                                <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AttachedDataEnabled}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Height="32" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding AttachedDataMemoryBank}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.WordStartAddr}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Height="32" Text="{Binding AttachedDataWordPointer}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.WordCount}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Height="32" Text="{Binding AttachedDataWordCount}" />
                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.AccessPasswordHex}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Height="32" Text="{Binding AttachedDataAccessPassword}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Width="{DynamicResource UI.Config.ButtonWidth}" Height="40" Margin="0,0,12,0" Command="{Binding QueryInventoryConfigCommand}" Style="{StaticResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16" Foreground="{StaticResource IconInfoBrush}" Icon="Download" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" Text="{DynamicResource InventoryConfig.ReadConfig}" />
                </StackPanel>
            </Button>
            <Button Width="{DynamicResource UI.Config.ButtonWidth}" Height="40" Command="{Binding SaveInventoryConfigCommand}" Style="{StaticResource FlatButtonPrimary}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16" Foreground="White" Icon="FloppyDisk" IconFont="Auto" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource InventoryConfig.SaveConfig}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource StatusHintTextStyle}" Text="{Binding OperationResult}" />
    </Grid>
</UserControl>
