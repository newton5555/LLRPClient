<UserControl x:Class="LLRPReaderUI_WPF.Views.InventoryConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:InventoryConfigViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16" IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Operation Triggers Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="HandPointer" IconFont="Auto" Foreground="{StaticResource IconPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource InventoryConfig.OperationTriggers}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <!-- Start Trigger Section -->
                        <TextBlock Text="{DynamicResource InventoryConfig.AutoStartConfig}" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource IconSuccessBrush}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InventoryFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Mode}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Height="30" ItemsSource="{Binding AutoStartModes}" SelectedItem="{Binding AutoStartMode}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiPortNum}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Height="30" Text="{Binding AutoStartGpiPortNumber}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiLevel}" />
                            <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStartGpiLevel}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.FirstDelayMs}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Height="30" Text="{Binding AutoStartFirstDelayInMs}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.PeriodMs}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Height="30" Text="{Binding AutoStartPeriodInMs}" />

                            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.UtcTimestamp}" />
                            <TextBox Grid.Row="10" Grid.Column="1" Height="30" Text="{Binding AutoStartUtcTimestamp}" />
                        </Grid>

                        <Separator Margin="0,5"/>
                        
                        <!-- Stop Trigger Section -->
                        <TextBlock Text="{DynamicResource InventoryConfig.AutoStopConfig}" FontWeight="Bold" Margin="0,8,0,8" Foreground="{StaticResource IconDangerBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InventoryFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Mode}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Height="30" ItemsSource="{Binding AutoStopModes}" SelectedItem="{Binding AutoStopMode}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.DurationMs}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Height="30" Text="{Binding AutoStopDurationInMs}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiPortNum}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Height="30" Text="{Binding AutoStopGpiPortNumber}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.GpiLevel}" />
                            <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoStopGpiLevel}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Timeout}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Height="30" Text="{Binding AutoStopTimeout}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Data Filtering Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="Filter" IconFont="Auto" Foreground="{StaticResource IconWarningBrush}"/>
                            <TextBlock Text="{DynamicResource InventoryConfig.FilterConfig}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InventoryFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.Mode}" />
                            <ComboBox Grid.Column="1" Height="30" ItemsSource="{Binding TagFilterModes}" SelectedItem="{Binding FilterMode}" />
                        </Grid>

                        <GroupBox Header="{DynamicResource InventoryConfig.TagFilter1}" Margin="0,0,0,8"
                                  Visibility="{Binding ShowTagFilter1, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLabel" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Height="28" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding Filter1MemoryBank}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitPointer}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Height="28" Text="{Binding Filter1BitPointer}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitCount}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Height="28" Text="{Binding Filter1BitCount}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.FilterOp}" />
                                <ComboBox Grid.Row="6" Grid.Column="1" Height="28" ItemsSource="{Binding TagFilterOps}" SelectedItem="{Binding Filter1FilterOp}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.TagMaskHex}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Height="30" Text="{Binding Filter1TagMask}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource InventoryConfig.TagFilter2}" Margin="0,0,0,8"
                                  Visibility="{Binding ShowTagFilter2, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLabel" />
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Height="28" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding Filter2MemoryBank}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitPointer}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Height="28" Text="{Binding Filter2BitPointer}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitCount}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Height="28" Text="{Binding Filter2BitCount}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.FilterOp}" />
                                <ComboBox Grid.Row="6" Grid.Column="1" Height="28" ItemsSource="{Binding TagFilterOps}" SelectedItem="{Binding Filter2FilterOp}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.TagMaskHex}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Height="30" Text="{Binding Filter2TagMask}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource InventoryConfig.TagSelectFilters}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowTagSelectFilters, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="8">
                                <Button MinWidth="120" Height="30" Content="{DynamicResource InventoryConfig.AddFilter}" Command="{Binding AddTagSelectFilterCommand}" Style="{StaticResource FlatButtonOutline}" />
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TagSelectFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushCustom}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FilterLabel" />
                                                        <ColumnDefinition Width="*" MinWidth="180" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                                                    <ComboBox Grid.Row="0" Grid.Column="1" Height="26"
                                                              ItemsSource="{Binding DataContext.MemoryBanks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding MemoryBank}" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitCount}" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Height="26" Text="{Binding BitCount}" />

                                                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.BitPointer}" />
                                                    <TextBox Grid.Row="4" Grid.Column="1" Height="26" Text="{Binding BitPointer}" />

                                                    <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MatchAction}" />
                                                    <ComboBox Grid.Row="6" Grid.Column="1" Height="26"
                                                              ItemsSource="{Binding DataContext.StateUnawareActions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding MatchAction}" />

                                                    <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.NonMatchAction}" />
                                                    <ComboBox Grid.Row="8" Grid.Column="1" Height="26"
                                                              ItemsSource="{Binding DataContext.StateUnawareActions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding NonMatchAction}" />

                                                    <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.TagMask}" />
                                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding TagMask}" />

                                                    <CheckBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                                                              Content="{DynamicResource InventoryConfig.UseStateAwareFilterAction}"
                                                              IsChecked="{Binding UseStateAwareAction}"
                                                              Visibility="{Binding DataContext.IsInventoryStateAwareEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.StateAwareTarget}"
                                                               Visibility="{Binding DataContext.IsInventoryStateAwareEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <ComboBox Grid.Row="14" Grid.Column="1" Height="26"
                                                              ItemsSource="{Binding DataContext.StateAwareTargets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding StateAwareTarget}"
                                                              IsEnabled="{Binding UseStateAwareAction}"
                                                              Visibility="{Binding DataContext.IsInventoryStateAwareEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <TextBlock Grid.Row="16" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.StateAwareAction}"
                                                               Visibility="{Binding DataContext.IsInventoryStateAwareEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <ComboBox Grid.Row="16" Grid.Column="1" Height="26"
                                                              ItemsSource="{Binding DataContext.StateAwareActions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding StateAwareAction}"
                                                              IsEnabled="{Binding UseStateAwareAction}"
                                                              Visibility="{Binding DataContext.IsInventoryStateAwareEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <Button Grid.Row="18" Grid.Column="1"
                                                            MinWidth="88"
                                                            HorizontalAlignment="Left"
                                                            Content="{DynamicResource InventoryConfig.Delete}"
                                                            Command="{Binding DataContext.RemoveTagSelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Style="{StaticResource FlatButtonOutline}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>

                <!-- Reporting Strategy Group -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock FontSize="14" Margin="0,0,6,0" Icon="SquarePollVertical" IconFont="Auto" Foreground="{StaticResource IconAccentBrush}"/>
                            <TextBlock Text="{DynamicResource InventoryConfig.ReportingStrategy}" Foreground="{DynamicResource GroupHeaderForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="10">
                        <TextBlock Text="{DynamicResource InventoryConfig.ReportConfig}" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource IconVioletBrush}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InventoryFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.ReportMode}" />
                            <ComboBox Grid.Column="1" Height="30"
                                      ItemsSource="{Binding ReportModes}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding ReportMode}" />
                        </Grid>

                        <UniformGrid Columns="2" Rows="4">
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeAntenna}" IsChecked="{Binding IncludeAntennaPortNumber}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeChannel}" IsChecked="{Binding IncludeChannel}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeFirstSeen}" IsChecked="{Binding IncludeFirstSeenTime}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeLastSeen}" IsChecked="{Binding IncludeLastSeenTime}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeSeenCount}" IsChecked="{Binding IncludeSeenCount}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludePeakRssi}" IsChecked="{Binding IncludePeakRssi}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludePcBits}" IsChecked="{Binding IncludePcBits}" />
                            <CheckBox Content="{DynamicResource InventoryConfig.IncludeCrc}" IsChecked="{Binding IncludeCrc}" />
                        </UniformGrid>
                        
                        <Separator Margin="0,12"/>
                        
                        <!-- Attached Data Section -->
                        <TextBlock Text="{DynamicResource InventoryConfig.AttachedDataConfig}" FontWeight="Bold" Margin="0,5,0,8" Foreground="{StaticResource IconTealBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InventoryFormLabel" />
                                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.EnableAttachedData}" />
                            <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AttachedDataEnabled}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.MemoryBank}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Height="30" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding AttachedDataMemoryBank}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.WordStartAddr}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Height="30" Text="{Binding AttachedDataWordPointer}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.WordCount}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Height="30" Text="{Binding AttachedDataWordCount}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource InventoryConfig.AccessPasswordHex}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Height="30" Text="{Binding AttachedDataAccessPassword}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button MinWidth="132" Margin="0,0,8,0" Command="{Binding QueryInventoryConfigCommand}" Style="{StaticResource FlatButtonOutline}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock FontSize="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="Download" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource InventoryConfig.ReadConfig}" />
                </StackPanel>
            </Button>
            <Button MinWidth="132" Command="{Binding SaveInventoryConfigCommand}" Style="{StaticResource FlatButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock FontSize="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Icon="FloppyDisk" IconFont="Auto" />
                    <TextBlock Text="{DynamicResource InventoryConfig.SaveConfig}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource StatusHintTextStyle}" Text="{Binding OperationResult}" />
    </Grid>
</UserControl>
