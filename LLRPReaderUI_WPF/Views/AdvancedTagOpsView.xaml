<UserControl x:Class="LLRPReaderUI_WPF.Views.AdvancedTagOpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:LLRPReaderUI_WPF.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:AdvancedTagOpsViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="900">
            <GroupBox Header="{DynamicResource AdvancedTagOps.StandardSummary}" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2 C1G2 OpSpec Parameters" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2.1 C1G2Read" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2.2 C1G2Write" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2.3 C1G2Kill" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2.4 C1G2Lock (含 C1G2LockPayload)" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2.5 C1G2BlockErase" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="15.2.1.3.2.6 C1G2BlockWrite" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource AdvancedTagOps.CommonParams}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="{DynamicResource WarningTextBrush}" Text="{DynamicResource AdvancedTagOps.Warning}" />

                    <TextBlock Grid.Row="2" Text="{DynamicResource AdvancedTagOps.TargetTagType}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Height="32" ItemsSource="{Binding TargetTagBanks}" SelectedItem="{Binding SelectedTargetTagBank}" />

                    <TextBlock Grid.Row="4" Text="{DynamicResource AdvancedTagOps.TargetTagValue}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Height="32" Text="{Binding TargetTagData, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Text="{DynamicResource AdvancedTagOps.AccessPassword}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Height="32" Text="{Binding AccessPassword, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Text="{DynamicResource AdvancedTagOps.KillPassword}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="8" Grid.Column="1" Height="32" Text="{Binding KillPassword, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="{DynamicResource AdvancedTagOps.PermalockNote}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource AdvancedTagOps.BlockErase}" Margin="0,10,0,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                              Text="{Binding IsBlockEraseSupported, StringFormat=Device Capability: C1G2BlockErase {0}}" />

                    <TextBlock Grid.Row="2" Text="{DynamicResource AdvancedTagOps.MemoryBank}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Height="32" ItemsSource="{Binding MemoryBanks}" SelectedItem="{Binding SelectedMemoryBank}" />

                    <TextBlock Grid.Row="4" Text="{DynamicResource AdvancedTagOps.WordStartAddr}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Height="32" Text="{Binding WordPointer, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Text="{DynamicResource AdvancedTagOps.WordCount}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Height="32" Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Row="6"
                            Grid.Column="2"
                            Height="36"
                            Margin="10,0,0,0"
                            Content="{DynamicResource AdvancedTagOps.ExecuteBlockErase}"
                            IsEnabled="{Binding IsBlockEraseSupported}"
                            Command="{Binding BlockEraseCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource AdvancedTagOps.LockOp}" Margin="0,10,0,0">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource AdvancedTagOps.LockTarget}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Height="32" ItemsSource="{Binding LockBanks}" SelectedItem="{Binding SelectedLockBank}" />

                    <TextBlock Grid.Row="2" Text="{DynamicResource AdvancedTagOps.LockAction}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Height="32" ItemsSource="{Binding LockActions}" SelectedItem="{Binding SelectedLockAction}" />

                    <Button Grid.Row="2" Grid.Column="2" Height="36" Margin="10,0,0,0" Content="{DynamicResource AdvancedTagOps.ExecuteLock}" Command="{Binding LockCommand}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource AdvancedTagOps.KillOp}" Margin="0,10,0,0">
                <StackPanel Margin="10" Orientation="Horizontal">
                    <Button Height="36" Width="150" Content="{DynamicResource AdvancedTagOps.ExecuteKill}" Command="{Binding KillCommand}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource WarningTextBrush}" Text="{DynamicResource AdvancedTagOps.KillWarning}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource AdvancedTagOps.Result}" Margin="0,10,0,0">
                <TextBlock Margin="10" Text="{Binding OperationResult}" TextWrapping="Wrap" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
