<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">

    <Color x:Key="PrimaryColor">#4DA6D6</Color>
    <Color x:Key="PrimaryColorLight">#77C4EF</Color>
    <Color x:Key="PrimaryColorDeep">#17384B</Color>
    <Color x:Key="SecondaryColor">#D08A4B</Color>
    <Color x:Key="SecondaryColorLight">#E7AC70</Color>
    <Color x:Key="BackgroundColor">#09131A</Color>
    <Color x:Key="BackgroundColorAlt">#0F1D26</Color>
    <Color x:Key="SurfaceColor">#11212B</Color>
    <Color x:Key="SurfaceMutedColor">#162A35</Color>
    <Color x:Key="SurfaceStrongColor">#1D3949</Color>
    <Color x:Key="BorderColor">#274352</Color>
    <Color x:Key="BorderStrongColor">#3B6176</Color>
    <Color x:Key="TextPrimaryColor">#EAF6FB</Color>
    <Color x:Key="TextSecondaryColor">#A5C0CF</Color>
    <Color x:Key="TextMutedColor">#7F9BAA</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryColorLight}" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="{StaticResource PrimaryColorDeep}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryColorLight}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="WindowBackgroundAltBrush" Color="{StaticResource BackgroundColorAlt}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="{StaticResource SurfaceStrongColor}" />
    <SolidColorBrush x:Key="BorderBrushCustom" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <LinearGradientBrush x:Key="WindowBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#10242F" />
        <GradientStop Offset="0.45" Color="{StaticResource BackgroundColor}" />
        <GradientStop Offset="1" Color="{StaticResource BackgroundColorAlt}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#102B39" />
        <GradientStop Offset="0.55" Color="#0C212D" />
        <GradientStop Offset="1" Color="#08161E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationHeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#286584" />
        <GradientStop Offset="1" Color="#183F53" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationOuterBorderBrush" Color="#284555" />
    <SolidColorBrush x:Key="NavigationForegroundBrush" Color="#EAF6FB" />
    <SolidColorBrush x:Key="NavigationHeaderIconBrush" Color="#E7F5FF" />
    <SolidColorBrush x:Key="NavigationHeaderAccentBrush" Color="#B9E7FF" />
    <SolidColorBrush x:Key="NavigationButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="NavigationItemHoverBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="NavigationItemSelectedBorderBrush" Color="#32FFFFFF" />
    <SolidColorBrush x:Key="WindowGlassOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#172832" />
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5BB6E5" />
        <GradientStop Offset="1" Color="#257AAA" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#142833" />
    <SolidColorBrush x:Key="NeutralButtonHoverBrush" Color="#193240" />
    <SolidColorBrush x:Key="NeutralButtonPressedBrush" Color="#1F4051" />
    <SolidColorBrush x:Key="NeutralButtonBorderBrush" Color="#315365" />
    <SolidColorBrush x:Key="NeutralButtonHoverBorderBrush" Color="#5A8EAB" />
    <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#D6ECF7" />
    <SolidColorBrush x:Key="OutlineButtonHoverBrush" Color="#183748" />
    <SolidColorBrush x:Key="OutlineButtonPressedBrush" Color="#20495D" />
    <LinearGradientBrush x:Key="SecondaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E7AC70" />
        <GradientStop Offset="1" Color="#BF7332" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#22FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="SubtleOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#9A040A0E" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="GroupHeaderForegroundBrush" Color="#F5FBFF" />

    <SolidColorBrush x:Key="StatusDefaultTextBrush" Color="#A5C0CF" />
    <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#FFB4A7" />
    <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="#8FE3B1" />
    <SolidColorBrush x:Key="StatusActiveTextBrush" Color="#8FD9FF" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#F0C18F" />

    <SolidColorBrush x:Key="StatusChipErrorBrush" Color="#412120" />
    <SolidColorBrush x:Key="StatusChipSuccessBrush" Color="#16342A" />
    <SolidColorBrush x:Key="StatusChipDefaultBrush" Color="#1A313E" />
    <SolidColorBrush x:Key="StatusChipActiveBrush" Color="#17384B" />

    <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#EC877E" />
    <SolidColorBrush x:Key="StatusDotSuccessBrush" Color="#4ED191" />
    <SolidColorBrush x:Key="StatusDotDefaultBrush" Color="#6E91A3" />
    <SolidColorBrush x:Key="StatusDotActiveBrush" Color="#5EC5FA" />

    <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeBackground" Color="{StaticResource BackgroundColor}" />

    <effects:DropShadowEffect x:Key="CardShadowEffect"
                              BlurRadius="32"
                              ShadowDepth="0"
                              Opacity="0.32"
                              Color="#031219" />
    <effects:DropShadowEffect x:Key="NavShadowEffect"
                              BlurRadius="36"
                              ShadowDepth="0"
                              Opacity="0.4"
                              Color="#000000" />

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#173848" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#1E4B60" />

    <SolidColorBrush x:Key="ReadRequiredForeground" Color="#90D6FF" />
    <SolidColorBrush x:Key="WriteRequiredForeground" Color="#F4B57C" />
    <SolidColorBrush x:Key="ReadRequiredBackground" Color="#123347" />
    <SolidColorBrush x:Key="WriteRequiredBackground" Color="#4A2B18" />
    <DrawingBrush x:Key="BothRequiredBackground"
                  Viewbox="0,0,6,6"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,6,6"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#10202A" Geometry="M0,0 H6 V6 H0 Z" />
                <GeometryDrawing Brush="#123A4E" Geometry="M0,0 H3 V3 H0 Z" />
                <GeometryDrawing Brush="#56331C" Geometry="M3,3 H6 V6 H3 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="TreeValueBrush" Color="#7DD1FF" />
    <SolidColorBrush x:Key="TreeDescriptionBrush" Color="#8DA9B8" />
    <SolidColorBrush x:Key="TreeMessageTypeBrush" Color="#65D39B" />

    <SolidColorBrush x:Key="IconInfoBrush" Color="#69C8F2" />
    <SolidColorBrush x:Key="IconSuccessBrush" Color="#61D89A" />
    <SolidColorBrush x:Key="IconDangerBrush" Color="#F28B80" />
    <SolidColorBrush x:Key="IconWarningBrush" Color="#F0B164" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="#7FBAE0" />
    <SolidColorBrush x:Key="IconTealBrush" Color="#4DC4C2" />
    <SolidColorBrush x:Key="IconVioletBrush" Color="#8FA8C4" />
    <SolidColorBrush x:Key="IconSlateBrush" Color="#8BA5B5" />

    <Style x:Key="FlatTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="StatusHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="16,12"
                                    Background="{DynamicResource NavigationHeaderBrush}"
                                    BorderBrush="{DynamicResource BorderBrushCustom}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="18,18,0,0">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{DynamicResource GroupHeaderForegroundBrush}"
                                                  TextElement.FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Row="1"
                                    Padding="14"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="0,0,18,18">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource NeutralButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeutralButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource NeutralButtonForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border Background="{DynamicResource PanelSheenBrush}"
                                    CornerRadius="11"
                                    Opacity="0.14" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeutralButtonHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NeutralButtonHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NeutralButtonPressedBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatButtonBase" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,10" />
    </Style>

    <Style x:Key="FlatButtonPrimary" BasedOn="{StaticResource FlatButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryDeepBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border Background="{DynamicResource PanelSheenBrush}"
                                    CornerRadius="11"
                                    Opacity="0.18" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDeepBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatButtonOutline" BasedOn="{StaticResource FlatButtonBase}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OutlineButtonHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OutlineButtonPressedBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushCustom}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeight" Value="40" />
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
    </Style>

    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
