<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Core colors (Premium Palette)  -->
    <Color x:Key="PrimaryColor">#0EA5E9</Color> <!-- Sky Blue -->
    <Color x:Key="PrimaryColorLight">#38BDF8</Color>
    <Color x:Key="SecondaryColor">#F59E0B</Color> <!-- Amber -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color> <!-- Slate 50 -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color> <!-- Slate 200 -->
    
    <!-- Premium Accent Colors -->
    <Color x:Key="AccentCyan">#06B6D4</Color>
    <Color x:Key="AccentEmerald">#10B981</Color>
    <Color x:Key="AccentViolet">#8B5CF6</Color>
    <Color x:Key="AccentRose">#F43F5E</Color>

    <!--  Text colors  -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#334155</Color>

    <!--  Brushes (including keys used by MahApps to allow overrides)  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryColorLight}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrushCustom" Color="{StaticResource BorderColor}" />

    <!--  Text brushes  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmerald}" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{StaticResource AccentViolet}" />
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRose}" />

    <!--  Overlay / interaction brushes  -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14007ACC" />
    <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#26007ACC" />
    <SolidColorBrush x:Key="SubtleOverlayBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#80000000" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#12000000" />

    <!--  Status bar text brushes  -->
    <SolidColorBrush x:Key="StatusDefaultTextBrush" Color="#475569" />
    <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="#166534" />
    <SolidColorBrush x:Key="StatusActiveTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#7A1F1F" />

    <!--  Status bar chip backgrounds  -->
    <SolidColorBrush x:Key="StatusChipErrorBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="StatusChipSuccessBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StatusChipDefaultBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="StatusChipActiveBrush" Color="#DBEAFE" />

    <!--  Status dot brushes  -->
    <SolidColorBrush x:Key="StatusDotErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusDotSuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="StatusDotDefaultBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="StatusDotActiveBrush" Color="#3B82F6" />

    <!--  Override MahApps brushes so existing styles pick up our flat theme  -->
    <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeBackground" Color="{StaticResource BackgroundColor}" />

    <!--  Text styles  -->
    <Style x:Key="FlatTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    
    <!-- Card / surface -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
    
    <!-- DataGrid brushes -->
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#FFF4F9FF" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#1F2563EB" /> <!-- 12% primary -->

    <!-- Read/Write required field brushes -->
    <SolidColorBrush x:Key="ReadRequiredForeground" Color="#0B5CAD" />
    <SolidColorBrush x:Key="WriteRequiredForeground" Color="#B54708" />
    <SolidColorBrush x:Key="ReadRequiredBackground" Color="#EAF3FF" />
    <SolidColorBrush x:Key="WriteRequiredBackground" Color="#FFF3E8" />
    <DrawingBrush x:Key="BothRequiredBackground"
                  Viewbox="0,0,6,6"
                  ViewboxUnits="Absolute"
                  Viewport="0,0,6,6"
                  ViewportUnits="Absolute"
                  TileMode="Tile"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F7FAFC" Geometry="M0,0 H6 V6 H0 Z" />
                <GeometryDrawing Brush="#DCEBFF" Geometry="M0,0 H3 V3 H0 Z" />
                <GeometryDrawing Brush="#FFE5D3" Geometry="M3,3 H6 V6 H3 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- TreeView text brushes -->
    <SolidColorBrush x:Key="TreeValueBrush" Color="#00008B" /> <!-- DarkBlue -->
    <SolidColorBrush x:Key="TreeDescriptionBrush" Color="#808080" /> <!-- Gray -->
    <SolidColorBrush x:Key="TreeMessageTypeBrush" Color="#006400" /> <!-- DarkGreen -->
    
        <!-- Icon brushes (project-wide) -->
        <SolidColorBrush x:Key="IconInfoBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="IconSuccessBrush" Color="#10B981" />
        <SolidColorBrush x:Key="IconDangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="IconWarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="IconAccentBrush" Color="#6366F1" />
        <SolidColorBrush x:Key="IconTealBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="IconVioletBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="IconSlateBrush" Color="#64748B" />

        <!-- Status hint and card styles used across views -->
        <Style x:Key="StatusHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.08" ShadowDepth="4" Color="#0F172A" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Width" Value="200" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FFFFFF" />
                        <GradientStop Offset="1" Color="#F8FAFC" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    <!-- Heading / body text styles -->
    <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--  Base flat button style  -->
    <Style
        x:Key="FlatButtonBase"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Primary (filled) button  -->
    <Style
        x:Key="FlatButtonPrimary"
        BasedOn="{StaticResource FlatButtonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!--  Outline button  -->
    <Style
        x:Key="FlatButtonOutline"
        BasedOn="{StaticResource FlatButtonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <!--  Danger (filled) button  -->
    <Style
        x:Key="FlatButtonDanger"
        BasedOn="{StaticResource FlatButtonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource IconDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IconDangerBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Implicit Button style for all buttons (full definition to avoid BasedOn issues during theme switch) -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- DataGrid Styles -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBackgroundBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushCustom}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeight" Value="36" />
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
    </Style>

    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
